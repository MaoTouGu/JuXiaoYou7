<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="urn:KinonekoSoftware/ui"
                    xmlns:this="clr-namespace:KinonekoSoftware.UX">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/KinonekoSoftware.UI.OnWPF;component/Themes/Dark.xaml" />
    </ResourceDictionary.MergedDictionaries>

    
    <Style TargetType="{x:Type this:ColorRibbon}">
        <Setter Property="Margin" Value="8" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Width" Value="320" />
        <Setter Property="Height" Value="110" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type this:ColorRibbon}">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ui:TilePanel Background="{Binding MaskedBrush, RelativeSource={RelativeSource Mode=TemplatedParent},Mode=OneWay}">
                            <TextBlock FontSize="18"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource Mode=TemplatedParent},Mode=OneWay}"
                                       Margin="16 16 8 0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Text="{Binding Title, RelativeSource={RelativeSource Mode=TemplatedParent},Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis" />

                            <TextBlock FontSize="36"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource Mode=TemplatedParent},Mode=OneWay}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Margin="16 8 32 16"
                                       Text="{Binding Value, RelativeSource={RelativeSource Mode=TemplatedParent},Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis" />
                        </ui:TilePanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type this:EmptyTextView}">
        <Setter Property="Margin" Value="8" />
        <Setter Property="Width" Value="320" />
        <Setter Property="Height" Value="110" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type this:EmptyTextView}">
                    <DockPanel VerticalAlignment="Center">
                        <Image DockPanel.Dock="Top"
                               Source="{TemplateBinding Image}"
                               Height="64"
                               Width="64"/>
                        <TextBlock Margin="0 16 0 0"
                                   Text="{TemplateBinding Text}"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type this:BinaryControl}">
        <Setter Property="Header" Value="36" />
        <Setter Property="IsThreeState" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0 0 0 0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type this:BinaryControl}">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter x:Name="PART_Negative"
                                              Grid.Column="0"
                                              Content="{TemplateBinding Negative}"
                                              ContentTemplate="{TemplateBinding NegativeTemplate}"
                                              ContentStringFormat="{TemplateBinding NegativeStringFormat}"
                                              ContentTemplateSelector="{TemplateBinding NegativeTemplateSelector}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              TextElement.Foreground="{DynamicResource Brush.Foreground.Level3}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="0 0 16 0"
                                              MinWidth="80"
                                              SnapsToDevicePixels="True" />

                            <Rectangle Grid.Column="1"
                                       Grid.ColumnSpan="3"
                                       Fill="{DynamicResource Brush.AdaptiveLevel3}"
                                       Height="2"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Stretch" />

                            <Border x:Name="PART_Thumb"
                                    Grid.Column="2"
                                    CornerRadius="999"
                                    Background="LightGray"
                                    Height="18"
                                    Width="18"
                                    VerticalAlignment="Center" />

                            <ContentPresenter x:Name="PART_Positive"
                                              Grid.Column="4"
                                              Content="{TemplateBinding Positive}"
                                              ContentTemplate="{TemplateBinding PositiveTemplate}"
                                              ContentStringFormat="{TemplateBinding PositiveStringFormat}"
                                              ContentTemplateSelector="{TemplateBinding PositiveTemplateSelector}"
                                              TextElement.Foreground="{DynamicResource Brush.Foreground.Level1}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="True"
                                              Margin="16 0 0 0" 
                                              MinWidth="80"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value=".45" TargetName="bd" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter Property="Grid.Column" Value="1" TargetName="PART_Thumb" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Foreground.Level1}" TargetName="PART_Positive" />
                            <Setter Property="Background" Value="{DynamicResource Brush.Background.Level2}" TargetName="PART_Thumb" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource Brush.Background.Level2}" TargetName="PART_Thumb" />
                        </MultiTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Grid.Column" Value="3" TargetName="PART_Thumb" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.HighlightB4}"
                                    TargetName="PART_Positive" />
                            <Setter Property="Background" Value="{DynamicResource Brush.HighlightB4}" TargetName="PART_Thumb" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type this:RarityRibbon}">
        <Setter Property="Margin" Value="8" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="RarityStarColor" Value="#FFAB12" />
        <Setter Property="Level" Value="1" />
        <Setter Property="Width" Value="320" />
        <Setter Property="MinHeight" Value="110" />
        <Setter Property="MaxHeight" Value="128" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type this:RarityRibbon}">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Background="{Binding MaskedBrush, RelativeSource={RelativeSource Mode=TemplatedParent},Mode=OneWay}">
                            <DockPanel Margin="16 16 8 0"
                                       VerticalAlignment="Top">
                                <TextBlock DockPanel.Dock="Left"
                                           FontSize="18"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource Mode=TemplatedParent},Mode=OneWay}"
                                           Text="{Binding Title, RelativeSource={RelativeSource Mode=TemplatedParent},Mode=OneWay}" />

                                <this:GeometryDegreeControl IsEnabled="False"
                                                            Margin="8 0 0 0"
                                                            Icon="F1 M24,24z M0,0z M12,2L12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26 12,2z"
                                                            IconSize="23"
                                                            Stroke="{Binding RarityStarColor, RelativeSource={RelativeSource Mode=TemplatedParent},Mode=OneWay}"
                                                            Value="{Binding Level, RelativeSource={RelativeSource Mode=TemplatedParent},Mode=OneWay}"
                                                            Maximum="{Binding Level, RelativeSource={RelativeSource Mode=TemplatedParent},Mode=OneWay}"
                                                            VerticalAlignment="Center">

                                </this:GeometryDegreeControl>
                            </DockPanel>

                            <TextBlock FontSize="36"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource Mode=TemplatedParent},Mode=OneWay}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Margin="0 8 32 16"
                                       Text="{Binding Value, RelativeSource={RelativeSource Mode=TemplatedParent},Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="ClearStyle.RarityRibbon.Level" TargetType="{x:Type this:RarityRibbon}">
        <Setter Property="Margin" Value="8" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="RarityStarColor" Value="#FFAB12" />
        <Setter Property="Level" Value="1" />
        <Setter Property="Width" Value="320" />
        <Setter Property="MinHeight" Value="110" />
        <Setter Property="MaxHeight" Value="128" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type this:RarityRibbon}">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Background="{Binding MaskedBrush, RelativeSource={RelativeSource Mode=TemplatedParent},Mode=OneWay}">

                            <TextBlock FontSize="18"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource Mode=TemplatedParent},Mode=OneWay}"
                                       Margin="16 16 8 0"
                                       Text="{Binding Title, RelativeSource={RelativeSource Mode=TemplatedParent},Mode=OneWay}" />

                            <TextBlock FontSize="36"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource Mode=TemplatedParent},Mode=OneWay}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Margin="0 8 32 16"
                                       Text="{Binding Value, RelativeSource={RelativeSource Mode=TemplatedParent},Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style TargetType="{x:Type this:ToggleIcon}">
        <Setter Property="Margin" Value="8" />
        <Setter Property="ui:ControlAssist.CornerRadius" Value="3" />
        <Setter Property="ui:ControlAssist.StrokeThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type this:ToggleIcon}">
                    <Border x:Name="PART_Border"
                            Background="Transparent"
                            CornerRadius="{TemplateBinding ui:ControlAssist.CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ui:Iconify x:Name="PART_Icon"
                                    Icon="{TemplateBinding ui:ControlAssist.Icon}"
                                    IsFilled="False"
                                    StrokeThickness="{TemplateBinding ui:ControlAssist.StrokeThickness}"
                                    IconSize="{TemplateBinding ui:ControlAssist.IconSize}" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Level2}" TargetName="PART_Icon" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="IsFilled" Value="True" TargetName="PART_Icon" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Level1}" TargetName="PART_Icon" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>