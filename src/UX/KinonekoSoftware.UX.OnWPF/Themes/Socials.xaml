<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="urn:KinonekoSoftware/ui"
                    xmlns:this="clr-namespace:KinonekoSoftware.UX">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/KinonekoSoftware.UI.OnWPF;component/Themes/Dark.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="Brush.QQ.Background" Color="#F5F5F5" />
    <SolidColorBrush x:Key="Brush.QQ.Bubble.Background" Color="#E5E5E5" />
    <SolidColorBrush x:Key="Brush.QQ.Bubble.Self" Color="#12B7F5" />
    <SolidColorBrush x:Key="Brush.QQ.Bar" Color="#0199FF" />
    
    <Style TargetType="{x:Type this:ChatBubble}">
        <Setter Property="Background" Value="{StaticResource Brush.QQ.Bar}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="MinWidth" Value="256" />
        <Setter Property="MaxWidth" Value="400" />
        <Setter Property="Margin" Value="0 8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type this:ChatBubble}">
                    <Border Background="Transparent"
                            Margin="0 0 0 16">
                        <DockPanel>

                            <!-- 头像部分 -->
                            <Rectangle x:Name="PART_Avatar"
                                       DockPanel.Dock="Left"
                                       Fill="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=ActorGravatar,Mode=OneWay}"
                                       RadiusX="8"
                                       RadiusY="8"
                                       Height="48"
                                       Width="48"
                                       VerticalAlignment="Top" />


                            <!-- 内容部分 -->
                            <DockPanel x:Name="PART_Panel">

                                <!-- 名字部分 -->
                                <DockPanel x:Name="PART_TitleBar"
                                           DockPanel.Dock="Top"
                                           HorizontalAlignment="Left">

                                    <Border x:Name="PART_Title"
                                            DockPanel.Dock="Left"
                                            Background="{TemplateBinding ActorTitleBrush}"
                                            CornerRadius="3"
                                            HorizontalAlignment="Left"
                                            Margin="0 0 6 0"
                                            Padding="4 2"
                                            Visibility="Visible">
                                        <TextBlock Foreground="White"
                                                   FontSize="12"
                                                   Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=ActorTitle,Mode=OneWay}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Border>

                                    <TextBlock Foreground="{DynamicResource Brush.Foreground.Level1}"
                                               FontSize="14"
                                               FontWeight="Heavy"
                                               HorizontalAlignment="Left"
                                               MaxWidth="128"
                                               Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=ActorName,Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>

                                <!-- 内容部分 -->
                                <Border x:Name="PART_ContentPanel"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="8"
                                        HorizontalAlignment="Left"
                                        Margin="0 8 0 0"
                                        Padding="8">
                                    <ContentPresenter x:Name="PART_Content"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                      ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      SnapsToDevicePixels="True" />
                                </Border>
                            </DockPanel>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ActorTitle" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" TargetName="PART_Title" />
                        </Trigger>
                        <Trigger Property="IsSelf" Value="True">
                            <Setter Property="DockPanel.Dock" Value="Right" TargetName="PART_Avatar" />
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_Title" />
                            <Setter Property="Background" Value="{StaticResource Brush.QQ.Bubble.Self}" TargetName="PART_ContentPanel" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Foreground.Level1}"/>
                            <Setter Property="Margin" Value="0 0 12 0" TargetName="PART_Panel" />
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="HorizontalAlignment" Value="Right" TargetName="PART_TitleBar" />
                            <Setter Property="HorizontalAlignment" Value="Right" TargetName="PART_ContentPanel" />
                            <Setter Property="HorizontalAlignment" Value="Right" TargetName="PART_Panel" />
                        </Trigger>
                        <Trigger Property="IsSelf" Value="False">
                            <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_Avatar" />
                            <Setter Property="Background" Value="{StaticResource Brush.QQ.Bubble.Background}" TargetName="PART_ContentPanel" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Foreground.Adaptive}"/>
                            <Setter Property="Margin" Value="12 0 0 0" TargetName="PART_Panel" />
                            <Setter Property="Margin" Value=" 0 0 6 0" TargetName="PART_Title" />
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Setter Property="HorizontalAlignment" Value="Left" TargetName="PART_Panel" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>