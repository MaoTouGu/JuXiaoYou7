<UserControl x:Class="MaoTouGu.JuXiaoYou.Domain.Geography.Pages.GeometryPrototypingPartialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="urn:KinonekoSoftware/ui"
             xmlns:this="clr-namespace:MaoTouGu.JuXiaoYou.Domain.Geography.Pages"
             xmlns:thisVM="clr-namespace:MaoTouGu.JuXiaoYou.Domain.Geography.Pages"
             mc:Ignorable="d"
             d:DesignWidth="800" d:DesignHeight="450"
             d:DataContext="{d:DesignInstance Type={x:Type thisVM:GeometryPrototypingViewModel}, IsDesignTimeCreatable=True}">
    <Grid ShowGridLines="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="24" />
            <RowDefinition Height="48" />
            <RowDefinition Height="6*" />
            <RowDefinition Height="6*" />
            <RowDefinition Height="72" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="9*" />
            <ColumnDefinition Width="9*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Grid.Row="1"
                    Orientation="Horizontal">
            <ui:GhostButton Grid.Column="1"
                            Grid.Row="4"
                            ui:ControlAssist.Icon="{StaticResource FeatherIcon.File}"
                            Content="新建"
                            Command="{Binding PickImage}"
                            IconMode="Both"/>


            <ui:GhostButton Grid.Column="1"
                            Grid.Row="4"
                            ui:ControlAssist.Icon="{StaticResource FeatherIcon.Folder}"
                            Content="选择"
                            Command="{Binding PickImage}"
                            IconMode="Both"/>

            <ui:GhostButton Grid.Column="1"
                            Grid.Row="4"
                            ui:ControlAssist.Icon="{StaticResource FeatherIcon.Folder}"
                            Content="导入"
                            Command="{Binding PickImage}"
                            IconMode="Both"/>

            <ui:GhostButton Grid.Column="1"
                            Grid.Row="4"
                            ui:ControlAssist.Icon="{StaticResource FeatherIcon.Folder}"
                            Content="选择"
                            Command="{Binding PickImage}"
                            IconMode="Both"/>
        </StackPanel>

        <HeaderedContentControl Grid.Column="1"
                                Grid.Row="2"
                                Grid.RowSpan="2"
                                Header="原始图像"
                                Style="{StaticResource SettingItem}">
            <Image Grid.Column="1"
                   Grid.Row="1"
                   Grid.RowSpan="2"
                   Source="{Binding Raw, Mode=OneWay}" />

        </HeaderedContentControl>


        <HeaderedContentControl Grid.Column="2"
                                Grid.Row="2"
                                Grid.RowSpan="2"
                                Header="识别后的形状"
                                Style="{StaticResource SettingItem}">

            <Path Grid.Column="2"
                  Grid.Row="1"
                  Grid.RowSpan="2"
                  Data="{Binding Geometry, Mode=OneWay}"
                  Stretch="Uniform"
                  Stroke="CornflowerBlue"
                  StrokeThickness="2" />

        </HeaderedContentControl>

        <ui:MainButton Grid.Column="1"
                       Grid.ColumnSpan="2"
                       Grid.Row="4"
                       Content="保存"
                       Margin="0 16"
                       HorizontalAlignment="Center"
                       Width="240"/>

    </Grid>
</UserControl>