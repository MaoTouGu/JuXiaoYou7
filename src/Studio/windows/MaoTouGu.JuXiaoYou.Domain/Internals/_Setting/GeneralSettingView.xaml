<UserControl x:Class="MaoTouGu.JuXiaoYou.Internals.GeneralSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="urn:KinonekoSoftware/ui"
             xmlns:this="clr-namespace:MaoTouGu.JuXiaoYou.Internals"
             xmlns:thisVM="clr-namespace:MaoTouGu.JuXiaoYou.Internals"
             xmlns:appModels="clr-namespace:MaoTouGu.JuXiaoYou.AppModels;assembly=MaoTouGu.JuXiaoYou.Core"
             xmlns:shells="clr-namespace:MaoTouGu.Shells.AppConfigs;assembly=MaoTouGu.Shells"
             mc:Ignorable="d"
             d:DesignWidth="800" d:DesignHeight="450"
             d:DataContext="{d:DesignInstance Type={x:Type thisVM:SettingViewModel}, IsDesignTimeCreatable=True}"
             Padding="0 20 0 0">

    <ScrollViewer Padding="0 16">
        <StackPanel>

            <HeaderedContentControl Header="启动时默认页面"
                                    Style="{StaticResource SettingItem}">
                <DockPanel>

                    <!---->
                    <!---->
                    <!---->
                    <TextBlock DockPanel.Dock="Top"
                               FontSize="12.5"
                               Foreground="{DynamicResource Brush.Foreground.Level2}"
                               Margin="0 0 0 8"
                               LineHeight="21"
                               Text="您可以选择打开软件时默认加载的页面。"
                               TextWrapping="Wrap" />
                    <!---->
                    <!---->
                    <!---->
                    <ui:OptionListBox Margin="0 0 0 16"
                                      SelectedItem="{Binding StartupRouting, Mode=TwoWay}"
                                      Style="{StaticResource OptionListBox.Direct}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="160"
                                           Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="24 8">
                                    <TextBlock Text="{Binding Converter={x:Static Converters.EnumToString}}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <appModels:StartupRouting>Home</appModels:StartupRouting>
                        <appModels:StartupRouting>Prototype</appModels:StartupRouting>
                        <appModels:StartupRouting>Inspiration</appModels:StartupRouting>
                        <appModels:StartupRouting>Project</appModels:StartupRouting>
                        <appModels:StartupRouting>Outline</appModels:StartupRouting>
                        <appModels:StartupRouting>Texting</appModels:StartupRouting>
                        <appModels:StartupRouting>SliceNarrative</appModels:StartupRouting>
                        <appModels:StartupRouting>ConversationNarrative</appModels:StartupRouting>
                    </ui:OptionListBox>
                </DockPanel>
            </HeaderedContentControl>

            <HeaderedContentControl Header="主题"
                                    Style="{StaticResource SettingItem}">
                <DockPanel>

                    <!---->
                    <!---->
                    <!---->
                    <TextBlock DockPanel.Dock="Top"
                               FontSize="12.5"
                               Foreground="{DynamicResource Brush.Foreground.Level2}"
                               Margin="0 0 0 8"
                               LineHeight="21"
                               Text="您可以选择当前的主题色，该选项需要重启应用生效。"
                               TextWrapping="Wrap" />
                    <!---->
                    <!---->
                    <!---->
                    <ui:OptionListBox Margin="0 0 0 16"
                                      SelectedItem="{Binding Theme, Mode=TwoWay}"
                                      Style="{StaticResource OptionListBox.Direct}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="32 8">
                                    <TextBlock Text="{Binding Converter={x:Static Converters.EnumToString}}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <shells:AppTheme>Light</shells:AppTheme>
                        <shells:AppTheme>Dark</shells:AppTheme>
                        <shells:AppTheme>Custom</shells:AppTheme>
                    </ui:OptionListBox>
                </DockPanel>
            </HeaderedContentControl>


            <HeaderedContentControl Header="语言"
                                    Style="{StaticResource SettingItem}">
                <DockPanel>

                    <!---->
                    <!---->
                    <!---->
                    <TextBlock DockPanel.Dock="Top"
                               FontSize="12.5"
                               Foreground="{DynamicResource Brush.Foreground.Level2}"
                               Margin="0 0 0 8"
                               LineHeight="21"
                               Text="您可以选择当前的语言选项，该选项需要重启应用生效（暂不生效）。"
                               TextWrapping="Wrap" />

                    <!---->
                    <!---->
                    <!---->
                    <ui:OptionListBox Margin="0 0 0 16"
                                      ItemsSource="{Binding LocateIdentifiers}"
                                      SelectedValue="{Binding LCID, Mode=TwoWay}"
                                      SelectedValuePath="LCID"
                                      Style="{StaticResource OptionListBox.Direct}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="32 8">
                                    <TextBlock Text="{Binding DisplayText}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ui:OptionListBox>
                </DockPanel>
            </HeaderedContentControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>