<ForestPage x:Class="MaoTouGu.JuXiaoYou.Internals.SliceNarrativeView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:ui="urn:KinonekoSoftware/ui"
            xmlns:this="clr-namespace:MaoTouGu.JuXiaoYou.Internals"
            xmlns:thisVM="clr-namespace:MaoTouGu.JuXiaoYou.Internals"
            xmlns:p="clr-namespace:MaoTouGu.JuXiaoYou.Prototypings"
            mc:Ignorable="d"
            d:DesignWidth="800" d:DesignHeight="450"
            d:DataContext="{d:DesignInstance Type={x:Type thisVM:SliceNarrativeViewModel}, IsDesignTimeCreatable=True}">
    <UserControl.Resources>
        <ResourceDictionary>

        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0"
              Margin="8 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <HeaderedContentControl Grid.Row="0"
                                    Header="数据列表"
                                    Style="{StaticResource SettingItem}">
                <ui:ListBox>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:Iconify Grid.Column="0"
                                            Icon="{StaticResource FeatherIcon.Folder}"/>

                                <TextBlock Grid.Column="1"
                                           FontFamily="{StaticResource SongTi}"
                                           Margin="16 0"
                                           Text="{Binding Name, Mode=OneWay}"
                                           VerticalAlignment="Center" />

                                <TextBlock Grid.Column="2"
                                           FontFamily="{StaticResource SongTi}"
                                           Foreground="{StaticResource Brush.HighlightC1}"
                                           Text="{Binding Value, Mode=OneWay}" />

                                <ui:Iconify Grid.Column="3"
                                            Icon="{StaticResource FeatherIcon.Right}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <p:KVItem Name="其他设备" Value="11" />
                    <p:KVItem Name="公用空间" Value="23" />
                    <p:KVItem Name="私密空间" Value="56" />
                </ui:ListBox>
            </HeaderedContentControl>
            
            <HeaderedContentControl Grid.Row="1"
                                    Header="收藏夹"
                                    Style="{StaticResource SettingItem}">
                <ui:ListBox>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:Iconify Grid.Column="0"
                                            Icon="{StaticResource FeatherIcon.Folder}"/>

                                <TextBlock Grid.Column="1"
                                           FontFamily="{StaticResource SongTi}"
                                           Margin="16 0"
                                           Text="{Binding Name, Mode=OneWay}"
                                           VerticalAlignment="Center" />

                                <TextBlock Grid.Column="2"
                                           FontFamily="{StaticResource SongTi}"
                                           Foreground="{StaticResource Brush.HighlightC1}"
                                           Text="{Binding Value, Mode=OneWay}" />

                                <ui:Iconify Grid.Column="3"
                                            Icon="{StaticResource FeatherIcon.Right}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <p:KVItem Name="测试" Value="1" />
                    <p:KVItem Name="测试" Value="32" />
                    <p:KVItem Name="测试" Value="1112" />
                    <p:KVItem Name="测试" Value="31" />
                </ui:ListBox>
            </HeaderedContentControl>
        </Grid>

        <Grid Grid.Column="1"
              Margin="0 8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <ui:SingleLine Grid.Row="0"
                           CornerRadius="0"
                           Text="文章标题"/>

            <ToolBar Grid.Row="1"
                     Margin="0"
                     Height="32"
                     BorderThickness="0">
                <ui:GhostButton ui:ControlAssist.Icon="{StaticResource FeatherIcon.ArrowLeft}"
                                IconMode="Icon"/>
                <ui:GhostButton ui:ControlAssist.Icon="{StaticResource FeatherIcon.ArrowRight}"
                                IconMode="Icon"/>
                <ui:GhostButton ui:ControlAssist.Icon="{StaticResource FeatherIcon.Command}"
                                IconMode="Icon"/>
                <ui:GhostButton ui:ControlAssist.Icon="{StaticResource FeatherIcon.Image}"
                                IconMode="Icon"/>
                <ui:GhostButton ui:ControlAssist.Icon="{StaticResource FeatherIcon.ExternalLink}"
                                IconMode="Icon"/>
                <ui:GhostButton ui:ControlAssist.Icon="{StaticResource FeatherIcon.Help}"
                                IconMode="Icon"/>
            </ToolBar>

            <RichTextBox Grid.Row="2">
                
            </RichTextBox>
        </Grid>

        <ui:ListBox Grid.Column="2"
                    Margin="8 0">
            <ui:ListBox.Resources>
                <Style TargetType="{x:Type ui:ListBox}" BasedOn="{StaticResource ListBox.ClearStyle}">

                </Style>

                <Style TargetType="{x:Type ui:ListBoxItem}" BasedOn="{StaticResource ListBoxItem.Outline}">
                    <Setter Property="ui:ControlAssist.CornerRadius" Value="8" />
                </Style>
            </ui:ListBox.Resources>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource Brush.Background.Level2}"
                            CornerRadius="8"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Grid.Column="0"
                                       FontFamily="{StaticResource HeiTi}"
                                       FontSize="16"
                                       Foreground="{DynamicResource Brush.Foreground.Level2}"
                                       Margin="0 0 32 0"
                                       Text="{Binding Name, Mode=OneWay}"
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Column="1"
                                       FontFamily="{StaticResource SongTi}"
                                       FontSize="16"
                                       Text="{Binding Value, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>

            <p:KVItem Name="测试" Value="爱仕达多撒" />
            <p:KVItem Name="测试" Value="爱仕达多撒" />
            <p:KVItem Name="测试" Value="爱仕达多撒" />
            <p:KVItem Name="测试" Value="爱仕达多撒" />
        </ui:ListBox>
    </Grid>
</ForestPage>