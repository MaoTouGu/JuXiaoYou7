<ForestPage x:Class="MaoTouGu.JuXiaoYou.Prototypings.PrototypingView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:ui="urn:KinonekoSoftware/ui"
            xmlns:this="clr-namespace:MaoTouGu.JuXiaoYou.Prototypings"
            xmlns:thisVM="clr-namespace:MaoTouGu.JuXiaoYou.Prototypings"
            mc:Ignorable="d"
            d:DesignWidth="800" d:DesignHeight="450"
            d:DataContext="{d:DesignInstance Type={x:Type thisVM:PrototypingViewModel}, IsDesignTimeCreatable=True}">
    <Grid ShowGridLines="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   Grid.ColumnSpan="3"
                   Grid.Row="0"
                   FontSize="24"
                   Padding="16"
                   Text="原型设计 > 表格模式 > 设定1" />


        <ui:ListBox Grid.Column="0"
                    Grid.Row="1"
                    Margin="8">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type thisVM:KVItem}">

                    <TextBlock Grid.Column="1"
                               FontFamily="{StaticResource SongTi}"
                               FontSize="16"
                               Text="{Binding Name, Mode=OneWay}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>

            <thisVM:KVItem Name="所有原型之#1" />
            <thisVM:KVItem Name="所有原型之#2" />
            <thisVM:KVItem Name="所有原型之#3" />
            <thisVM:KVItem Name="所有原型之#4" />
            <thisVM:KVItem Name="所有原型之#5" />
            <thisVM:KVItem Name="所有原型之#6" />
            <thisVM:KVItem Name="所有原型之#7" />
        </ui:ListBox>

        <ContentControl Grid.Column="1"
                        Grid.Row="1">
            <!---->
            <!---->
            <!---->
            <ScrollViewer Grid.Column="1"
                          Margin="8 0">
                <Border Background="{DynamicResource Brush.Background.Level3}"
                        Padding="16">
                    <StackPanel>

                        <!---->
                        <!---->
                        <!---->
                        <Border BorderBrush="{DynamicResource Brush.Background.Level1}"
                                BorderThickness="0 0 0 2"
                                Padding="0 0 0 8"
                                Margin="0 0 0 16">
                            <StackPanel>
                                <Image Source="E:\企划\猫头菇工作室\猫头菇logo_night2.png"
                                       Width="48"
                                       Height="48" />

                                <TextBlock FontSize="24"
                                           Margin="0 8"
                                           Text="角色名字 / JUE SE MING ZI"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!---->
                        <!---->
                        <!---->
                        <Border Background="{DynamicResource Brush.Background.Level2}"
                                CornerRadius="10"
                                Padding="16"
                                Margin="0 0 0 16"
                                MouseLeftButtonDown="UIElement_OnMouseLeftButtonDown">
                            <DockPanel Background="{DynamicResource Brush.Background.Level2}">
                                <Border DockPanel.Dock="Right"
                                        BorderBrush="{DynamicResource Brush.Foreground.Level1}"
                                        BorderThickness="2"
                                        Height="192"
                                        Width="192"
                                        VerticalAlignment="Top">
                                    <Border DockPanel.Dock="Left"
                                            BorderBrush="{DynamicResource Brush.Background.Level3}"
                                            BorderThickness="2" />
                                </Border>

                                <ItemsControl Grid.IsSharedSizeScope="True"
                                              Margin="0 0 32 0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type thisVM:KVItem}">
                                            <Grid Margin="0 0 0 8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition SharedSizeGroup="Title" />
                                                    <ColumnDefinition Width="6*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           FontFamily="{StaticResource HeiTi}"
                                                           FontSize="16"
                                                           Foreground="{DynamicResource Brush.Foreground.Level2}"
                                                           Margin="0 0 32 0"
                                                           Text="{Binding Name, Mode=OneWay}"
                                                           VerticalAlignment="Center" />

                                                <TextBlock Grid.Column="1"
                                                           FontFamily="{StaticResource SongTi}"
                                                           FontSize="16"
                                                           Text="{Binding Value, Mode=OneWay}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>

                                    <thisVM:KVItem Name="名字" Value="角色名字 / JUE SE MING ZI" />
                                    <thisVM:KVItem Name="年龄" Value="16" />
                                    <thisVM:KVItem Name="性别" Value="男" />
                                    <thisVM:KVItem Name="种族" Value="人族 / REN ZU" />
                                    <thisVM:KVItem Name="身份" Value="战士" />
                                    <thisVM:KVItem Name="身高" Value="178" />
                                    <thisVM:KVItem Name="体重" Value="79" />
                                    <thisVM:KVItem Name="生日" Value="11.22" />

                                </ItemsControl>
                            </DockPanel>
                        </Border>

                        <!---->
                        <!---->
                        <!---->
                        <Border Background="{DynamicResource Brush.Background.Level2}"
                                CornerRadius="10"
                                Padding="16"
                                Margin="0 0 0 16"
                                MouseLeftButtonDown="UIElement_OnMouseLeftButtonDown">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top"
                                           FontFamily="{StaticResource SongTi}"
                                           FontSize="20"
                                           Margin="0 0 0 8"
                                           Text="简介" />
                                <TextBlock FontFamily="{StaticResource SongTi}"
                                           Foreground="{DynamicResource Brush.Foreground.Level2}"
                                           Text="{StaticResource Lorem_English}"
                                           TextWrapping="Wrap" />
                            </DockPanel>
                        </Border>

                        <!---->
                        <!---->
                        <!---->
                        <Border Background="{DynamicResource Brush.Background.Level2}"
                                CornerRadius="10"
                                Padding="16"
                                Margin="0 0 0 16"
                                MouseLeftButtonDown="UIElement_OnMouseLeftButtonDown">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top"
                                           FontFamily="{StaticResource SongTi}"
                                           FontSize="20"
                                           Margin="0 0 0 8"
                                           Text="故事背景" />
                                <TextBlock FontFamily="{StaticResource SongTi}"
                                           Foreground="{DynamicResource Brush.Foreground.Level2}"
                                           Text="{StaticResource Lorem_English_Large}"
                                           TextWrapping="Wrap" />
                            </DockPanel>
                        </Border>

                        <!---->
                        <!---->
                        <!---->
                        <Border BorderBrush="{DynamicResource Brush.Background.Level1}"
                                BorderThickness="0 2 0 0"
                                Padding="8">
                            <TextBlock Text="编号：NAX-012 / NO.JSD"
                                       TextAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </ContentControl>

        <StackPanel Grid.Column="2"
                    Grid.Row="1">
            <ui:GhostButton Content="新建设定" />
            <ui:GhostButton Content="完善此设定" />
            <ui:GhostButton Content="查看所有设定" />
            <ui:GhostButton Content="首页" />
        </StackPanel>
    </Grid>
</ForestPage>