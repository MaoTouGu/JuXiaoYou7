            xmlns:ui="urn:KinonekoSoftware/ui"
            xmlns:this="clr-namespace:MaoTouGu.JuXiaoYou.LOSD.Visualizing"
            xmlns:thisVM="clr-namespace:MaoTouGu.JuXiaoYou.LOSD.Visualizing"
            xmlns:domain="clr-namespace:MaoTouGu.JuXiaoYou.Domain.VisualBlocks.Core;assembly=MaoTouGu.JuXiaoYou.Domain.VisualBlocks"
