<ForestPage x:Class="MaoTouGu.JuXiaoYou.LOSD.Naming.NamingLevelSettingDetailsView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:ui="urn:KinonekoSoftware/ui"
            xmlns:this="clr-namespace:MaoTouGu.JuXiaoYou.LOSD.Naming"
            xmlns:thisVM="clr-namespace:MaoTouGu.JuXiaoYou.LOSD.Naming"
            xmlns:prototype="clr-namespace:MaoTouGu.JuXiaoYou.Prototypings"
            mc:Ignorable="d"
            d:DesignWidth="800" d:DesignHeight="450"
            d:DataContext="{d:DesignInstance Type={x:Type thisVM:NamingLevelSettingDetailsViewModel}, IsDesignTimeCreatable=True}">
    <UserControl.Resources>
        <Style x:Key="Style.Era" TargetType="{x:Type ui:ListBoxItem}" BasedOn="{StaticResource Style.ListBoxItem}">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Level4}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Background.Level1}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ui:ListBoxItem}">
                        <Grid Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12" />
                                <RowDefinition Height="1*" />
                                <RowDefinition Height="12" />
                            </Grid.RowDefinitions>

                            <Rectangle x:Name="PART_Line"
                                       Grid.Row="0"
                                       Grid.RowSpan="3"
                                       Fill="{TemplateBinding BorderBrush}"
                                       Width="1"
                                       HorizontalAlignment="Center" />

                            <Border x:Name="PART_Border"
                                    Grid.Row="1"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center"
                                    MinWidth="120">
                                <ContentPresenter x:Name="PART_Content"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Stretch" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.HighlightB2}" TargetName="PART_Border" />
                                <Setter Property="Fill" Value="{DynamicResource Brush.HighlightB2}" TargetName="PART_Line" />
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.HighlightB4}" TargetName="PART_Border" />
                                <Setter Property="Fill" Value="{DynamicResource Brush.HighlightB4}" TargetName="PART_Line" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Foreground.Disabled}" TargetName="PART_Content" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.HighlightB1}" TargetName="PART_Border" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="320" />
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="1*" MinWidth="320" />
        </Grid.ColumnDefinitions>


        <!---->
        <!---->
        <!---->
        <ui:EmptyStateView IsEmpty="{Binding IsCreationMode, Mode=OneWay}"
                           Margin="12 8">
            <ui:EmptyStateView.EmptyState>
                <HeaderedContentControl Header="所有设定"
                                        Style="{StaticResource SettingItem}">
                    <ui:ListBox ItemsSource="{Binding Collection, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name, Mode=OneWay}"
                                           TextAlignment="Left" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ui:ListBox>
                </HeaderedContentControl>
            </ui:EmptyStateView.EmptyState>
            <ui:SinkTabControl Grid.Column="0">
                <ui:SinkTabItem Header="总览">
                    <ui:ListBox SelectedItem="{Binding Moniker, Mode=TwoWay}"
                                ItemsSource="{Binding Collection, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name, Mode=OneWay}"
                                           TextAlignment="Left" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ui:ListBox>
                </ui:SinkTabItem>
                <ui:SinkTabItem Header="未分类">

                </ui:SinkTabItem>
            </ui:SinkTabControl>
        </ui:EmptyStateView>


        <!---->
        <!---->
        <!---->
        <ui:EmptyStateView Grid.Column="1"
                           Margin="32 0"
                           NotEmpty="{Binding IsCreationMode, Mode=OneWay}">


            <!---->
            <!---->
            <!---->
            <ui:EmptyStateView.EmptyState>

                <!---->
                <!---->
                <Grid ShowGridLines="False">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="3*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <ui:ToggleButton Grid.Row="0"
                                         DockPanel.Dock="Bottom"
                                         ui:ControlAssist.CornerRadius="0"
                                         ui:ControlAssist.Icon="{StaticResource FeatherIcon.PlusCircle}"
                                         Content="自由模式"
                                         Height="36"
                                         IsChecked="{Binding IsCreationMode, Mode=TwoWay}"
                                         IconMode="Text" />

                        <ui:GhostButton Grid.Row="0"
                                        DockPanel.Dock="Bottom"
                                        ui:ControlAssist.CornerRadius="0"
                                        ui:ControlAssist.Icon="{StaticResource FeatherIcon.PlusCircle}"
                                        Content="新建"
                                        Height="36"
                                        IconMode="Text" />
                        <ui:GhostButton Grid.Row="0"
                                        DockPanel.Dock="Bottom"
                                        ui:ControlAssist.CornerRadius="0"
                                        ui:ControlAssist.Icon="{StaticResource FeatherIcon.Right}"
                                        Content="下一流程"
                                        Height="36"
                                        IconMode="Text" />
                    </StackPanel>

                    <DockPanel Grid.Row="1"
                               Margin="0 0 0 32"
                               VerticalAlignment="Bottom">
                        <ui:MainButton Grid.Row="0"
                                       DockPanel.Dock="Right"
                                       ui:ControlAssist.CornerRadius="0"
                                       ui:ControlAssist.Icon="{StaticResource FeatherIcon.Right}"
                                       Content="保存"
                                       FontSize="18"
                                       Padding="24 0"
                                       IconMode="Text"
                                       Style="{StaticResource MainButton.HighlightB}" />
                        <!---->
                        <!---->
                        <!---->
                        <Border Grid.Row="2"
                                BorderBrush="{DynamicResource Brush.HighlightB4}"
                                BorderThickness="0 0 0 3"
                                Padding="0">
                            <ui:SingleLine CornerRadius="0"
                                           Foreground="{DynamicResource Brush.Foreground.Level1}"
                                           FontSize="32"
                                           Text="{Binding Moniker.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=100}"
                                           Watermark="名字" />
                        </Border>
                    </DockPanel>
                    <!---->
                    <!---->
                    <!---->
                    <HeaderedContentControl Grid.Row="2"
                                            Margin="0 0"
                                            Style="{StaticResource SettingItem}">
                        <HeaderedContentControl.Header>
                            <DockPanel>
                                <ui:GhostButton DockPanel.Dock="Right"
                                                ui:ControlAssist.CornerRadius="0"
                                                ui:ControlAssist.Icon="{StaticResource FeatherIcon.PlusCircle}"
                                                IconMode="Icon"
                                                Height="36"
                                                HorizontalContentAlignment="Left" />

                                <TextBlock Text="标签"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </HeaderedContentControl.Header>
                        <ItemsControl>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#20808000"
                                            BorderBrush="Olive"
                                            BorderThickness="1"
                                            CornerRadius="0"
                                            Margin="0 0 8 8"
                                            Padding="8 4"
                                            MinWidth="100">
                                        <DockPanel>
                                            <CloseButton DockPanel.Dock="Right" />
                                            <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                       TextAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <prototype:KVItem Name="设定#1" />
                            <prototype:KVItem Name="设定#2" />
                            <prototype:KVItem Name="设定#3" />
                            <prototype:KVItem Name="设定#41" />
                            <prototype:KVItem Name="设定#42" />
                            <prototype:KVItem Name="设定#43" />
                        </ItemsControl>
                    </HeaderedContentControl>
                </Grid>
            </ui:EmptyStateView.EmptyState>


            <!---->
            <!---->
            <!---->
            <DockPanel Grid.Row="1"
                       Margin="0 0 0 32"
                       VerticalAlignment="Center">

                <ui:ToggleButton DockPanel.Dock="Bottom"
                                 ui:ControlAssist.CornerRadius="0"
                                 ui:ControlAssist.Icon="{StaticResource FeatherIcon.PlusCircle}"
                                 Content="编辑模式"
                                 Height="36"
                                 Margin="0 48 0 0"
                                 IsChecked="{Binding IsCreationMode, Mode=TwoWay}"
                                 IconMode="Text"
                                 Width="320" />

                <ui:MainButton Grid.Row="0"
                               DockPanel.Dock="Right"
                               ui:ControlAssist.CornerRadius="0"
                               ui:ControlAssist.Icon="{StaticResource FeatherIcon.Right}"
                               Content="创建"
                               Command="{Binding Create}"
                               FontSize="20"
                               FontFamily="{StaticResource SongTi}"
                               Padding="24 0"
                               IconMode="Text"
                               Style="{StaticResource MainButton.HighlightB}" />
                <!---->
                <!---->
                <!---->
                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource Brush.HighlightB4}"
                        BorderThickness="0 0 0 3"
                        Padding="0">
                    <ui:SingleLine CornerRadius="0"
                                   Foreground="{DynamicResource Brush.Foreground.Level1}"
                                   FontSize="32"
                                   Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=100}"
                                   Watermark="名字" />
                </Border>
            </DockPanel>

        </ui:EmptyStateView>


        <!---->
        <!---->
        <!---->
        <HeaderedContentControl Grid.Column="2"
                                Margin="8 0 20 0"
                                Padding="0 0 0 8"
                                Style="{StaticResource SettingItem}"
                                Visibility="{Binding IsCreationMode, Mode=OneWay, Converter={x:Static Converters.FalseToVisibility}}">
            <HeaderedContentControl.Resources>
                <Style TargetType="{x:Type ui:ListBoxItem}" BasedOn="{StaticResource Style.Era}" />
            </HeaderedContentControl.Resources>
            <HeaderedContentControl.Header>
                <DockPanel>
                    <ui:GhostButton DockPanel.Dock="Right"
                                    ui:ControlAssist.CornerRadius="0"
                                    ui:ControlAssist.Icon="{StaticResource FeatherIcon.Settings}"
                                    IconMode="Icon"
                                    Height="36"
                                    HorizontalContentAlignment="Left" />

                    <TextBlock Text="工作流"
                               VerticalAlignment="Center" />
                </DockPanel>
            </HeaderedContentControl.Header>
            <DockPanel Margin="0 0 0 24">
                <!---->
                <!---->
                <!---->
                <TextBlock DockPanel.Dock="Top"
                           Foreground="{DynamicResource Brush.Foreground.Level2}"
                           Margin="0 0 0 8"
                           LineHeight="24"
                           Text="点击任意一个工作流可以跳转到对应的页面，工作流可以按照自己的需求自定义。"
                           TextWrapping="Wrap" />
                <!---->
                <!---->
                <!---->
                <ui:ListBox>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name, Mode=OneWay}"
                                       TextAlignment="Center" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                    <prototype:KVItem Name="名字细节" />
                    <prototype:KVItem Name="头像细节" />
                    <prototype:KVItem Name="立绘细节" />
                    <prototype:KVItem Name="其他细节1" />
                    <prototype:KVItem Name="其他细节2" />
                    <prototype:KVItem Name="其他细节3" />
                </ui:ListBox>
            </DockPanel>
        </HeaderedContentControl>
    </Grid>
</ForestPage>