<ForestPage x:Class="MaoTouGu.JuXiaoYou.LOSD.Painting.PaintingLevelSettingDetailsView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:ui="urn:KinonekoSoftware/ui"
            xmlns:this="clr-namespace:MaoTouGu.JuXiaoYou.LOSD.Painting"
            xmlns:thisVM="clr-namespace:MaoTouGu.JuXiaoYou.LOSD.Painting"
            xmlns:prototype="clr-namespace:MaoTouGu.JuXiaoYou.Prototypings"
            mc:Ignorable="d"
            d:DesignWidth="800" d:DesignHeight="450"
            d:DataContext="{d:DesignInstance Type={x:Type thisVM:PaintingLevelSettingDetailsViewModel}, IsDesignTimeCreatable=True}"
            Padding="8">
    <UserControl.Resources>
        <Style TargetType="{x:Type ui:ListBoxItem}" BasedOn="{StaticResource ListBoxItem.Outline}">
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="ui:ControlAssist.CornerRadius" Value="0" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="Style.Era" TargetType="{x:Type ui:ListBoxItem}" BasedOn="{StaticResource Style.ListBoxItem}">
            <Setter Property="Background" Value="{DynamicResource Brush.Background.Level4}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Background.Level1}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ui:ListBoxItem}">
                        <Grid Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="12" />
                                <RowDefinition Height="1*" />
                                <RowDefinition Height="12" />
                            </Grid.RowDefinitions>

                            <Rectangle x:Name="PART_Line"
                                       Grid.Row="0"
                                       Grid.RowSpan="3"
                                       Fill="{TemplateBinding BorderBrush}"
                                       Width="1"
                                       HorizontalAlignment="Center" />

                            <Border x:Name="PART_Border"
                                    Grid.Row="1"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center"
                                    MinWidth="120">
                                <ContentPresenter x:Name="PART_Content"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Stretch" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.HighlightB2}" TargetName="PART_Border" />
                                <Setter Property="Fill" Value="{DynamicResource Brush.HighlightB2}" TargetName="PART_Line" />
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.HighlightB4}" TargetName="PART_Border" />
                                <Setter Property="Fill" Value="{DynamicResource Brush.HighlightB4}" TargetName="PART_Line" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Foreground.Disabled}" TargetName="PART_Content" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.HighlightB1}" TargetName="PART_Border" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>


        <!---->
        <!---->
        <!---->
        <StackPanel DockPanel.Dock="Top">
            <Border ImageSystem.Thumbnail="Of360p"
                        ImageSystem.Fallback="Gravatar"
                        ImageSystem.Type="Gravatar"
                        ImageSystem.Source="2"
                        CornerRadius="96"
                        Width="84"
                        Height="84">
            </Border>


            <ui:TextButton FontFamily="{StaticResource SongTi}"
                               FontSize="18"
                               Content="DisplayName"
                               Margin="0 8"
                               HorizontalContentAlignment="Center" />
        </StackPanel>

        <!---->
        <!---->
        <!---->
        <DockPanel Grid.Column="1">
            <StackPanel DockPanel.Dock="Top"
                        Height="36"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <ui:GhostButton Content="新建设定" />
                <ui:GhostButton Content="完善此设定" />
                <ui:GhostButton Content="查看所有设定" />
                <ui:GhostButton Content="首页" />
            </StackPanel>

            <ui:ListBox DockPanel.Dock="Bottom">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="Gray"
                                Height="100"
                                Width="100"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <Thickness/>
                <Thickness/>
                <Thickness/>
                <Thickness/>
            </ui:ListBox>

            <Image ImageSystem.Thumbnail="Of720p"
                   ImageSystem.Fallback="Gravatar"
                   ImageSystem.Type="Gravatar"
                   ImageSystem.Source="2"
                   Margin="0 24"/>
        </DockPanel>

        <!---->
        <!---->
        <!---->
        <HeaderedContentControl Grid.Column="2"
                                Margin="8 0 20 0"
                                Padding="0 0 0 8"
                                Style="{StaticResource SettingItem}"
                                Visibility="{Binding IsCreationMode, Mode=OneWay, Converter={x:Static Converters.FalseToVisibility}}">
            <HeaderedContentControl.Resources>
                <Style TargetType="{x:Type ui:ListBoxItem}" BasedOn="{StaticResource Style.Era}" />
            </HeaderedContentControl.Resources>
            <HeaderedContentControl.Header>
                <DockPanel>
                    <ui:GhostButton DockPanel.Dock="Right"
                                    ui:ControlAssist.CornerRadius="0"
                                    ui:ControlAssist.Icon="{StaticResource FeatherIcon.Settings}"
                                    IconMode="Icon"
                                    Height="36"
                                    HorizontalContentAlignment="Left" />

                    <TextBlock Text="工作流"
                               VerticalAlignment="Center" />
                </DockPanel>
            </HeaderedContentControl.Header>
            <DockPanel Margin="0 0 0 24">
                <!---->
                <!---->
                <!---->
                <TextBlock DockPanel.Dock="Top"
                           Foreground="{DynamicResource Brush.Foreground.Level2}"
                           Margin="0 0 0 8"
                           LineHeight="24"
                           Text="点击任意一个工作流可以跳转到对应的页面，工作流可以按照自己的需求自定义。"
                           TextWrapping="Wrap" />
                <!---->
                <!---->
                <!---->
                <ui:ListBox>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name, Mode=OneWay}"
                                       TextAlignment="Center" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                    <prototype:KVItem Name="名字细节" />
                    <prototype:KVItem Name="头像细节" />
                    <prototype:KVItem Name="立绘细节" />
                    <prototype:KVItem Name="其他细节1" />
                    <prototype:KVItem Name="其他细节2" />
                    <prototype:KVItem Name="其他细节3" />
                </ui:ListBox>
            </DockPanel>
        </HeaderedContentControl>
    </Grid>
</ForestPage>