<UserControl x:Class="MaoTouGu.JuXiaoYou.Visualizers.Models.RadarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MaoTouGu.JuXiaoYou.Visualizers.Models"
             xmlns:ui="urn:KinonekoSoftware/ui"
             xmlns:ux="urn:KinonekoSoftware/ux"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance Type={x:Type local:RadarVPO}, IsDesignTimeCreatable=True}">
    <DockPanel>
        <!---->
        <TextBlock x:Name="Title"
                   DockPanel.Dock="Top"
                   FontSize="32"
                   FontWeight="Bold"
                   Text="{Binding Name, Mode=OneWay}"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center" />

        <DockPanel Background="Transparent"
                   ClipToBounds="True">
            <ui:RadarControl ClipToBounds="False"
                             Margin="48 32"
                             Height="200"
                             Width="200"
                             Palette="{Binding Palette, Mode=OneWay}"
                             Axes="{Binding Axes, Mode=OneWay}"
                             Values="{Binding Series, Mode=OneWay}"
                             VerticalAlignment="Top">

            </ui:RadarControl>

            <ItemsControl Margin="48 0 0 0"
                          ItemsSource="{Binding Items, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ui:IntentWrapPanel IntentWidth="240" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="Transparent"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="0 0 0 1"
                                Margin="8 4"
                                Padding="0 4">
                            <DockPanel Background="Transparent"
                                       HorizontalAlignment="Left">
                                <TextBlock DockPanel.Dock="Right"
                                           Background="Transparent"
                                           FontSize="24"
                                           Foreground="{Binding Color, Mode=OneWay, Converter={x:Static Converters.ToBrush}}"
                                           Text="{Binding Value, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           Margin="16 0 0 0"
                                           Width="48"
                                           VerticalAlignment="Center" />

                                <TextBlock Text="{Binding Name, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </DockPanel>
</UserControl>
