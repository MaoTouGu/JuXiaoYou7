<VisualizerControl x:Class="MaoTouGu.JuXiaoYou.Visualizers.Blocks.RadarPresenter"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:local="clr-namespace:MaoTouGu.JuXiaoYou.Visualizers.Blocks"
                        xmlns:core="clr-namespace:MaoTouGu.JuXiaoYou.Visualizers.Core"
                        xmlns:ui="urn:KinonekoSoftware/ui"
                        xmlns:ux="urn:KinonekoSoftware/ux"
                        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                        mc:Ignorable="d"
                        d:DesignHeight="300" d:DesignWidth="300"
                        d:DataContext="{d:DesignInstance Type={x:Type local:RadarVisualizer}, IsDesignTimeCreatable=True}"
                        MinWidth="100"
                        MinHeight="100">

    <ui:RadarControl x:Name="RadarControl"
                     ClipToBounds="False"
                     Margin="32"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch">

    </ui:RadarControl>
</VisualizerControl>
