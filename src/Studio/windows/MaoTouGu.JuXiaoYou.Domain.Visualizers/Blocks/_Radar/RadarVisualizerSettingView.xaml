<UserControl x:Class="MaoTouGu.JuXiaoYou.Visualizers.Blocks.RadarVisualizerSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="urn:KinonekoSoftware/ui"
             xmlns:ux="urn:KinonekoSoftware/ux"
             xmlns:local="clr-namespace:MaoTouGu.JuXiaoYou.Visualizers.Blocks"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance Type={x:Type local:RadarVisualizer}, IsDesignTimeCreatable=True}">
    <ui:EmptyStateView IsEmpty="{Binding IsEdit, Mode=OneWay}">

        <ui:EmptyStateView.EmptyState>
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <ui:MainButton ui:ControlAssist.CornerRadius="0"
                                   ui:ControlAssist.Icon="{StaticResource FeatherIcon.ArrowLeft}"
                                    Command="{Binding Back}"
                                    Height="40"
                                    Width="40" 
                                    IconMode="Icon"/>
                    <TextBlock FontSize="16"
                               FontFamily="{StaticResource SongTi}"
                               Margin="16 0 0 0"
                               Text="{Binding Name}"
                               VerticalAlignment="Center"/>
                </DockPanel>
                <StackPanel DataContext="{Binding Item, Mode=OneWay}">
                    <HeaderedContentControl Header="名字"
                                            Style="{StaticResource SettingItem}">
                        <ui:SingleLine Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=100}" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="喵喵咒语"
                                            Style="{StaticResource SettingItem}">
                        <ui:SingleLine Text="{Binding MetadataSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=100}" />
                    </HeaderedContentControl>
                </StackPanel>
            </DockPanel>
        </ui:EmptyStateView.EmptyState>

        <StackPanel>
            <HeaderedContentControl Header="颜色"
                                    Style="{StaticResource SettingItem}">
                <ux:PortableColorPicker SelectedColor="{Binding Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={x:Static Converters.ToColor}}"
                                        HorizontalAlignment="Left"
                                        Height="40"
                                        Width="40" />
            </HeaderedContentControl>
            <HeaderedContentControl Header="最大值"
                                    Style="{StaticResource SettingItem}">
                <ui:SingleLine Text="{Binding Maximum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=100}" />
            </HeaderedContentControl>
            
            <HeaderedContentControl Header="元素"
                                    Style="{StaticResource SettingItem}">
                <ui:ControlAssist.ToolBar>
                    <StackPanel Orientation="Horizontal">
                        <ui:GhostButton ui:ControlAssist.CornerRadius="0"
                                        ui:ControlAssist.Icon="{StaticResource FeatherIcon.PlusCircle}"
                                        Command="{Binding Add}"
                                        IconMode="Icon"
                                        Padding="0"
                                        Height="32"
                                        Width="32" />
                        <ui:GhostButton ui:ControlAssist.CornerRadius="0"
                                        ui:ControlAssist.Icon="{StaticResource FeatherIcon.Trash}"
                                        Command="{Binding Remove}"
                                        CommandParameter="{Binding Item, Mode=OneWay}"
                                        IconMode="Icon"
                                        Padding="0"
                                        Height="32"
                                        Width="32" />
                    </StackPanel>
                </ui:ControlAssist.ToolBar>

                <ui:ListBox ItemsSource="{Binding Collection}"
                            SelectedItem="{Binding Item, Mode=TwoWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:RadarItemFrom}">
                            <DockPanel>
                                <ui:GhostButton DockPanel.Dock="Right"
                                                ui:ControlAssist.CornerRadius="0"
                                                ui:ControlAssist.Icon="{StaticResource FeatherIcon.Folder}"
                                                Click="Button_Edit"
                                                CommandParameter="{Binding }"
                                                IconMode="Icon"
                                                Padding="0"
                                                Height="32"
                                                Width="32" />
                                
                                <TextBlock Text="{Binding Name, Mode=OneWay}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ui:ListBox>
            </HeaderedContentControl>


            <ui:MainButton ui:ControlAssist.CornerRadius="0"
                           ui:ControlAssist.Icon="{StaticResource FeatherIcon.ArrowLeft}"
                           Command="{Binding Save}"
                           Content="保存"
                           Height="32"
                           Margin="0 8"
                           Style="{StaticResource MainButton.HighlightB}"/>
        </StackPanel>
    </ui:EmptyStateView>
</UserControl>