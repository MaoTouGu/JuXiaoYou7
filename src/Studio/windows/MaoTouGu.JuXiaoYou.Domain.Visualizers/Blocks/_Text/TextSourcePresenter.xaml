<VisualizerControl x:Class="MaoTouGu.JuXiaoYou.Visualizers.Blocks.TextSourcePresenter"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:ui="urn:KinonekoSoftware/ui"
                   xmlns:local="clr-namespace:MaoTouGu.JuXiaoYou.Visualizers.Blocks"
                   mc:Ignorable="d"
                   d:DesignHeight="300" d:DesignWidth="300"
                   d:DataContext="{d:DesignInstance Type={x:Type local:TextSourceVisualizer}, IsDesignTimeCreatable=True}">
    <Border x:Name="Border">
        <TextBlock x:Name="TextBlock"
                   FontSize="{Binding FontSize, Mode=OneWay}"
                   TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis" />
    </Border>
</VisualizerControl>