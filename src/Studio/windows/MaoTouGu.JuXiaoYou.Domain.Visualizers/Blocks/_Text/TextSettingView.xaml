<UserControl x:Class="MaoTouGu.JuXiaoYou.Visualizers.Blocks.TextSettingView"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MaoTouGu.JuXiaoYou.Visualizers.Blocks"
             xmlns:core="clr-namespace:MaoTouGu.JuXiaoYou.Visualizers.Core"
             xmlns:ui="urn:KinonekoSoftware/ui"
             xmlns:ux="urn:KinonekoSoftware/ux"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance Type={x:Type local:TextSourceVisualizer}, IsDesignTimeCreatable=True}">
    <StackPanel>
        <HeaderedContentControl Header="喵喵咒语"
                                Margin="0 0 0 8"
                                Style="{StaticResource SettingItem}">
            <ui:SingleLine Text="{Binding MetadataSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=100}" />
        </HeaderedContentControl>

        <HeaderedContentControl Header="背景色"
                                Margin="0 0 0 8"
                                Style="{StaticResource SettingItem}">
            <ux:PortableColorPicker SelectedColor="{Binding Background, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={x:Static Converters.ToColor}}"
                                    HorizontalAlignment="Left"
                                    Height="40"
                                    Width="40" />
        </HeaderedContentControl>

        <HeaderedContentControl Header="边框色"
                                Margin="0 0 0 8"
                                Style="{StaticResource SettingItem}">
            <ux:PortableColorPicker SelectedColor="{Binding BorderBrush, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={x:Static Converters.ToColor}}"
                                    HorizontalAlignment="Left"
                                    Height="40"
                                    Width="40" />
        </HeaderedContentControl>

        <CornerRadiusEditorItem />
        <ThicknessEditorItem/>
        <BorderThicknessEditorItem/>
        <FontFamilyEditorItem />
        <FontWeightEditorItem />
        <FontStyleEditorItem />

        <HeaderedContentControl Header="前景色"
                                Margin="0 0 0 8"
                                Style="{StaticResource SettingItem}">
            <ux:PortableColorPicker SelectedColor="{Binding Foreground, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={x:Static Converters.ToColor}}"
                                    HorizontalAlignment="Left"
                                    Height="40"
                                    Width="40" />
        </HeaderedContentControl>

        <HeaderedContentControl Header="字体大小"
                                Margin="0 0 0 8"
                                Style="{StaticResource SettingItem}">
            <ui:SingleLine Text="{Binding FontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=100}" />
        </HeaderedContentControl>


        <HorizontalAlignmentEditorItem />
        <VerticalAlignmentEditorItem />
        <ui:MainButton ui:ControlAssist.CornerRadius="0"
                       ui:ControlAssist.Icon="{StaticResource FeatherIcon.ArrowLeft}"
                       Command="{Binding Save}"
                       Content="保存"
                       Height="32"
                       Margin="0 8"
                       Style="{StaticResource MainButton.HighlightB}"/>
    </StackPanel>
</UserControl>
