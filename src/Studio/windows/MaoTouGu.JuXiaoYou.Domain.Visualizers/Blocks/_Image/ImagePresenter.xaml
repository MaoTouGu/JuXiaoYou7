<core:VisualizerControl x:Class="MaoTouGu.JuXiaoYou.Visualizers.Blocks.ImagePresenter"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:local="clr-namespace:MaoTouGu.JuXiaoYou.Visualizers.Blocks"
                        xmlns:core="clr-namespace:MaoTouGu.JuXiaoYou.Visualizers.Core"
                        mc:Ignorable="d"
                        d:DesignHeight="300" d:DesignWidth="300"
                        d:DataContext="{d:DesignInstance Type={x:Type local:ImageVisualizer}, IsDesignTimeCreatable=True}"
                        MinHeight="100"
                        MinWidth="100">
    <Image x:Name="Image"
           ImageSystem.Fallback="Gravatar"
           ImageSystem.Type="Image"
           ImageSystem.Thumbnail="Of720p"
           Stretch="Uniform"/>
</core:VisualizerControl>