<core:VisualizerControl x:Class="MaoTouGu.JuXiaoYou.Visualizers.GravatarWide.WithRarityGravatarPresenter"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:local="clr-namespace:MaoTouGu.JuXiaoYou.Visualizers.GravatarWide"
                        xmlns:core="clr-namespace:MaoTouGu.JuXiaoYou.Visualizers.Core"
                        xmlns:ui="urn:KinonekoSoftware/ui"
                        mc:Ignorable="d"
                        d:DesignHeight="300" d:DesignWidth="300"
                        d:DataContext="{d:DesignInstance Type={x:Type local:WithRarityGravatarVisualizer}, IsDesignTimeCreatable=True}">
    <DockPanel Margin="8">
        <Border x:Name="Border"
                DockPanel.Dock="Top" 
                ImageSystem.Fallback="Gravatar"
                ImageSystem.Type="Gravatar"
                ImageSystem.Thumbnail="Of360p"
                Height="84"
                Width="84">
        </Border>

        <TextBlock x:Name="Name"
                   Margin="0 8"
                   TextAlignment="Center"/>
    </DockPanel>
</core:VisualizerControl>