<UserControl x:Class="MaoTouGu.JuXiaoYou.Visualizers.GravatarWide.WithRarityGravatarSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="urn:KinonekoSoftware/ui"
             xmlns:local="clr-namespace:MaoTouGu.JuXiaoYou.Visualizers.GravatarWide"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance Type={x:Type local:WithRarityGravatarVisualizer}, IsDesignTimeCreatable=True}">
    <StackPanel>
        <HeaderedContentControl Header="数据来源"
                                Style="{StaticResource SettingItem}">
            <ui:SingleLine Text="{Binding RarityFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=100}" />
        </HeaderedContentControl>
    </StackPanel>
</UserControl>