<ForestPage x:Class="MaoTouGu.JuXiaoYou.Domain.IM.Pages.LobbyView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:ui="urn:KinonekoSoftware/ui"
            xmlns:this="clr-namespace:MaoTouGu.JuXiaoYou.Domain.IM.Pages"
            xmlns:thisControls="clr-namespace:MaoTouGu.JuXiaoYou.Domain.IM.Controls"
            xmlns:thisM="clr-namespace:MaoTouGu.JuXiaoYou.Domain.IM.Models"
            xmlns:thisVM="clr-namespace:MaoTouGu.JuXiaoYou.Domain.IM.Pages"
            mc:Ignorable="d"
            d:DesignWidth="800" d:DesignHeight="450"
            d:DataContext="{d:DesignInstance Type={x:Type thisVM:LobbyViewModel}, IsDesignTimeCreatable=True}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/KinonekoSoftware.UX.OnWPF;component/Themes/Socials.xaml" />
            </ResourceDictionary.MergedDictionaries>


            <SolidColorBrush x:Key="Brush.QQ.Background" Color="#F5F5F5" />
            <SolidColorBrush x:Key="Brush.QQ.Bubble.Background" Color="#E5E5E5" />
            <SolidColorBrush x:Key="Brush.QQ.Bubble.Self" Color="#12B7F5" />
            <SolidColorBrush x:Key="Brush.QQ.Bar" Color="#0199FF" />

            <Style TargetType="{x:Type thisControls:ChatBubble}">
                <Setter Property="Background" Value="{StaticResource Brush.QQ.Bar}" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="MinWidth" Value="256" />
                <Setter Property="MaxWidth" Value="400" />
                <Setter Property="Margin" Value="0 8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type thisControls:ChatBubble}">
                            <Border Background="Transparent"
                                    Margin="0 0 0 16">
                                <DockPanel>

                                    <!-- 头像部分 -->
                                    <Rectangle x:Name="PART_Avatar"
                                               DockPanel.Dock="Left"
                                               Fill="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=Gravatar,Mode=OneWay}"
                                               RadiusX="8"
                                               RadiusY="8"
                                               Height="48"
                                               Width="48"
                                               VerticalAlignment="Top" />


                                    <!-- 内容部分 -->
                                    <DockPanel x:Name="PART_Panel">

                                        <!-- 名字部分 -->
                                        <DockPanel x:Name="PART_TitleBar"
                                                   DockPanel.Dock="Top"
                                                   HorizontalAlignment="Left">

                                            <Border x:Name="PART_Title"
                                                    DockPanel.Dock="Left"
                                                    Background="{TemplateBinding TitleBrush}"
                                                    CornerRadius="3"
                                                    HorizontalAlignment="Left"
                                                    Margin="0 0 6 0"
                                                    Padding="4 2"
                                                    Visibility="Visible">
                                                <TextBlock Foreground="White"
                                                           FontSize="12"
                                                           Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=Title,Mode=OneWay}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Border>

                                            <TextBlock Foreground="{DynamicResource Brush.Foreground.Level1}"
                                                       FontSize="14"
                                                       FontWeight="Heavy"
                                                       HorizontalAlignment="Left"
                                                       MaxWidth="128"
                                                       Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=DisplayName,Mode=OneWay}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>

                                        <!-- 内容部分 -->
                                        <Border x:Name="PART_ContentPanel"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="8"
                                                HorizontalAlignment="Left"
                                                Margin="0 8 0 0"
                                                Padding="8">
                                            <ContentPresenter x:Name="PART_Content"
                                                              Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                              SnapsToDevicePixels="True" />
                                        </Border>
                                    </DockPanel>
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Title" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" TargetName="PART_Title" />
                                </Trigger>
                                <Trigger Property="IsSelf" Value="True">
                                    <Setter Property="DockPanel.Dock" Value="Right" TargetName="PART_Avatar" />
                                    <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_Title" />
                                    <Setter Property="Background" Value="{StaticResource Brush.QQ.Bubble.Self}" TargetName="PART_ContentPanel" />
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Foreground.Level1}" />
                                    <Setter Property="Margin" Value="0 0 12 0" TargetName="PART_Panel" />
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="HorizontalAlignment" Value="Right" TargetName="PART_TitleBar" />
                                    <Setter Property="HorizontalAlignment" Value="Right" TargetName="PART_ContentPanel" />
                                    <Setter Property="HorizontalAlignment" Value="Right" TargetName="PART_Panel" />
                                </Trigger>
                                <Trigger Property="IsSelf" Value="False">
                                    <Setter Property="DockPanel.Dock" Value="Left" TargetName="PART_Avatar" />
                                    <Setter Property="Background" Value="{StaticResource Brush.QQ.Bubble.Background}" TargetName="PART_ContentPanel" />
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Foreground.Adaptive}" />
                                    <Setter Property="Margin" Value="12 0 0 0" TargetName="PART_Panel" />
                                    <Setter Property="Margin" Value=" 0 0 6 0" TargetName="PART_Title" />
                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                    <Setter Property="HorizontalAlignment" Value="Left" TargetName="PART_Panel" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <Style TargetType="{x:Type ui:StrikeTabControl}">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="8 0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ui:StrikeTabControl}">
                            <DockPanel KeyboardNavigation.TabNavigation="Local">
                                <Border x:Name="TabPanel"
                                        BorderBrush="{DynamicResource Brush.Foreground.Level1}"
                                        Padding="0 8"
                                        HorizontalAlignment="Center">
                                    <TabPanel x:Name="HeaderPanel"
                                              Panel.ZIndex="1"
                                              IsItemsHost="True"
                                              KeyboardNavigation.TabIndex="1"
                                              Background="Transparent" />
                                </Border>

                                <Border x:Name="Border"
                                        Grid.Row="1"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        KeyboardNavigation.TabNavigation="Local"
                                        KeyboardNavigation.DirectionalNavigation="Contained"
                                        KeyboardNavigation.TabIndex="2"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter x:Name="PART_SelectedContentHost"
                                                      TextElement.FontSize="{TemplateBinding FontSize}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                                      ContentSource="SelectedContent"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch" />
                                </Border>
                            </DockPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="TabStripPlacement" Value="Left">
                                    <Setter Property="DockPanel.Dock" Value="Left" TargetName="TabPanel" />
                                </Trigger>

                                <Trigger Property="TabStripPlacement" Value="Right">
                                    <Setter Property="DockPanel.Dock" Value="Right" TargetName="TabPanel" />
                                </Trigger>

                                <Trigger Property="TabStripPlacement" Value="Top">
                                    <Setter Property="DockPanel.Dock" Value="Top" TargetName="TabPanel" />
                                </Trigger>


                                <Trigger Property="TabStripPlacement" Value="Bottom">
                                    <Setter Property="DockPanel.Dock" Value="Bottom" TargetName="TabPanel" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type ui:StrikeTabItem}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Level1}" />
                <Setter Property="BorderThickness" Value="4 0 0 0" />
                <Setter Property="ui:ControlAssist.Icon" Value="{StaticResource FeatherIcon.PlusCircle}" />
                <Setter Property="ui:ControlAssist.IconSize" Value="24" />
                <Setter Property="ui:ControlAssist.FontSize" Value="13" />
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="MinWidth" Value="48" />
                <Setter Property="Padding" Value="4 4" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ui:StrikeTabItem}">
                            <Border x:Name="PART_Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="0"
                                    Padding="6 0"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True">
                                <ui:Iconify x:Name="PART_Icon"
                                            TextElement.FontSize="{TemplateBinding ui:ControlAssist.FontSize}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Icon="{TemplateBinding ui:ControlAssist.Icon}"
                                            IconSize="{TemplateBinding ui:ControlAssist.IconSize}"
                                            StrokeThickness="1"
                                            IsFilled="{TemplateBinding ui:ControlAssist.IsFilled}"
                                            Focusable="False"
                                            Margin="0 0 0 0"
                                            Height="{TemplateBinding ui:ControlAssist.IconSize}"
                                            Width="{TemplateBinding ui:ControlAssist.IconSize}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="IsSelected" Value="False" />
                                    </MultiTrigger.Conditions>
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.HighlightB1}" TargetName="PART_Icon" />
                                </MultiTrigger>

                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#10FFFFFF" TargetName="PART_Border" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.HighlightB3}" TargetName="PART_Border" />
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.HighlightB3}" TargetName="PART_Icon" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Foreground.Disabled}" TargetName="PART_Icon" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate DataType="{x:Type thisM:PlainTextMSG}">
                <thisControls:ChatBubble ImageSystem.Thumbnail="Of360p"
                                         ImageSystem.Fallback="Gravatar"
                                         ImageSystem.Type="Gravatar"
                                         ImageSystem.Source="{Binding User.Gravatar, Mode=OneWay}"
                                         Title="{Binding User.Type}"
                                         DisplayName="{Binding User.DisplayName}"
                                         TitleBrush="CornflowerBlue"
                                         IsSelf="{Binding IsSelf}">
                    <TextBlock Foreground="{DynamicResource Brush.Background.Level3}" 
                               Text="{Binding Text}"
                               TextWrapping="Wrap"></TextBlock>
                </thisControls:ChatBubble>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <ui:StrikeTabControl TabStripPlacement="Left"
                         Padding="8">
        <ui:StrikeTabItem ui:ControlAssist.Icon="{StaticResource FeatherIcon.Chat}"
                          Header="联系人">
            <this:ContractPartialView />
        </ui:StrikeTabItem>
        <ui:StrikeTabItem ui:ControlAssist.Icon="{StaticResource FeatherIcon.Archive}"
                          Header="项目">
        </ui:StrikeTabItem>
        <ui:StrikeTabItem ui:ControlAssist.Icon="{StaticResource FeatherIcon.Chat}"
                          Header="消息">
        </ui:StrikeTabItem>
        <ui:StrikeTabItem ui:ControlAssist.Icon="{StaticResource FeatherIcon.Inbox}"
                          Header="通知">

        </ui:StrikeTabItem>
        <ui:StrikeTabItem ui:ControlAssist.Icon="{StaticResource FeatherIcon.People}"
                          Header="设置">
            <this:UserProfilePartialView />
        </ui:StrikeTabItem>
    </ui:StrikeTabControl>
</ForestPage>