<UserControl x:Class="MaoTouGu.JuXiaoYou.Visualizers.Commons.FontStyleEditorItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MaoTouGu.JuXiaoYou.Visualizers.Commons"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:ui="urn:KinonekoSoftware/ui"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <sys:Int32 x:Key="Zero">0</sys:Int32>
        <sys:Int32 x:Key="One">1</sys:Int32>
        <sys:Int32 x:Key="Two">2</sys:Int32>
        <sys:Int32 x:Key="Three">3</sys:Int32>
        <sys:Int32 x:Key="Four">4</sys:Int32>
        <sys:Int32 x:Key="Five">5</sys:Int32>
    </UserControl.Resources>
    <ui:CheckBox x:Name="Input"
                 Content="斜体"
                 Checked="Checked"
                 Unchecked="OnUnchecked"
                 HorizontalAlignment="Left"/>
</UserControl>