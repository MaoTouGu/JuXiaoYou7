<UserControl x:Class="MaoTouGu.JuXiaoYou.Visualizers.Commons.FontFamilyEditorItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MaoTouGu.JuXiaoYou.Visualizers.Commons"
             xmlns:ui="urn:KinonekoSoftware/ui"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">

    <HeaderedContentControl Header="字体"
                            Margin="0 0 0 8"
                            Style="{StaticResource SettingItem}">
        <ui:ComboBox x:Name="FontFamilies"
                     SelectionChanged="FontFamilies_OnSelectionChanged">

        </ui:ComboBox>
    </HeaderedContentControl>
</UserControl>