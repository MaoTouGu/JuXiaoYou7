<UserControl x:Class="MaoTouGu.JuXiaoYou.Visualizers.Commons.MetadataSourceOnlySettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="urn:KinonekoSoftware/ui"
             xmlns:local="clr-namespace:MaoTouGu.JuXiaoYou.Visualizers.Core;assembly=MaoTouGu.JuXiaoYou.Core"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance Type={x:Type local:IMetadataSourceOnlySetting}, IsDesignTimeCreatable=True}">
    <StackPanel>
        <HeaderedContentControl Header="喵喵咒语"
                                Style="{StaticResource SettingItem}">
            <ui:SingleLine Text="{Binding MetadataSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=100}" />
        </HeaderedContentControl>


        <ui:MainButton ui:ControlAssist.CornerRadius="0"
                       ui:ControlAssist.Icon="{StaticResource FeatherIcon.ArrowLeft}"
                       Command="{Binding Save}"
                       Content="保存"
                       Height="32"
                       Margin="0 8"
                       Style="{StaticResource MainButton.HighlightB}" />
    </StackPanel>
</UserControl>