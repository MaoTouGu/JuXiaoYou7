<UserControl x:Class="MaoTouGu.JuXiaoYou.Visualizers.Commons.TypographyTextSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MaoTouGu.JuXiaoYou.Visualizers.Commons"
             xmlns:core="clr-namespace:MaoTouGu.JuXiaoYou.Visualizers.Core"
             xmlns:ui="urn:KinonekoSoftware/ui"
             xmlns:ux="urn:KinonekoSoftware/ux"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance Type={x:Type core:TypographyTextVPO}, IsDesignTimeCreatable=True}">
    <StackPanel>
        <HeaderedContentControl Header="文本"
                                Margin="0 0 0 8"
                                Style="{StaticResource SettingItem}">
            <ui:SingleLine Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=100}" />
        </HeaderedContentControl>

        <HeaderedContentControl Header="背景色"
                                Margin="0 0 0 8"
                                Style="{StaticResource SettingItem}">
            <ux:PortableColorPicker SelectedColor="{Binding Background, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={x:Static Converters.ToColor}}"
                                    HorizontalAlignment="Left"
                                    Height="40"
                                    Width="40" />
        </HeaderedContentControl>

        <HeaderedContentControl Header="边框"
                                Margin="0 0 0 8"
                                Style="{StaticResource SettingItem}">
            <ux:PortableColorPicker SelectedColor="{Binding BorderBrush, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={x:Static Converters.ToColor}}"
                                    HorizontalAlignment="Left"
                                    Height="40"
                                    Width="40" />
        </HeaderedContentControl>

        <local:CornerRadiusEditorItem />
        <local:ThicknessEditorItem/>
        <local:BorderThicknessEditorItem/>
        <local:FontFamilyEditorItem />
        <local:FontWeightEditorItem />
        <local:FontStyleEditorItem />

        <HeaderedContentControl Header="前景色"
                                Margin="0 0 0 8"
                                Style="{StaticResource SettingItem}">
            <ux:PortableColorPicker SelectedColor="{Binding Foreground, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={x:Static Converters.ToColor}}"
                                    HorizontalAlignment="Left"
                                    Height="40"
                                    Width="40" />
        </HeaderedContentControl>

        <HeaderedContentControl Header="字体大小"
                                Margin="0 0 0 8"
                                Style="{StaticResource SettingItem}">
            <ui:SingleLine Text="{Binding FontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=100}" />
        </HeaderedContentControl>


        <local:HorizontalAlignmentEditorItem />
        <local:VerticalAlignmentEditorItem />
    </StackPanel>
</UserControl>