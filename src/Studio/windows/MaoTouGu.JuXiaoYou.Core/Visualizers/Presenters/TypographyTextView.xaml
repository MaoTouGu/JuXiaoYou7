<UserControl x:Class="MaoTouGu.JuXiaoYou.Visualizers.Commons.TypographyTextView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="urn:KinonekoSoftware/ui"
             xmlns:local="clr-namespace:MaoTouGu.JuXiaoYou.Visualizers.Core"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             d:DataContext="{d:DesignInstance Type={x:Type local:TypographyTextVPO}, IsDesignTimeCreatable=True}"
             Width="{Binding Width, Mode=OneWay}"
             Height="{Binding Height, Mode=OneWay}">
    <Border Background="{Binding Background, Mode=OneWay, Converter={x:Static Converters.ToBrush}}"
            BorderBrush="{Binding BorderBrush, Mode=OneWay, Converter={x:Static Converters.ToBrush}}"
            BorderThickness="{Binding BorderThickness, Mode=OneWay}"
            CornerRadius="{Binding CornerRadius, Mode=OneWay, Converter={x:Static local:Visualizer.CornerRadius}}"
            Padding="{Binding Padding, Mode=OneWay, Converter={x:Static local:Visualizer.Thickness}}">
        <TextBlock FontSize="{Binding FontSize, Mode=OneWay}"
                   FontFamily="{Binding FontFamily, Mode=OneWay, Converter={x:Static local:Visualizer.FontFamily}}"
                   FontWeight="{Binding FontWeight, Mode=OneWay, Converter={x:Static local:Visualizer.FontWeight}}"
                   FontStyle="{Binding IsBold, Mode=OneWay, Converter={x:Static local:Visualizer.FontStyle}}"
                   Foreground="{Binding Foreground, Mode=OneWay, Converter={x:Static Converters.ToBrush}}"
                   Text="{Binding Text, Mode=OneWay}"
                   TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis"
                   
                   HorizontalAlignment="{Binding HorizontalAlignment, Mode=OneWay, Converter={x:Static local:Visualizer.HorizontalAlignment}}"
                   VerticalAlignment="{Binding VerticalAlignment, Mode=OneWay, Converter={x:Static local:Visualizer.VerticalAlignment}}" />
    </Border>
</UserControl>