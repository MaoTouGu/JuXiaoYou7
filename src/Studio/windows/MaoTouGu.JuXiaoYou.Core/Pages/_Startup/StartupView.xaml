<ForestPage x:Class="MaoTouGu.JuXiaoYou.Pages.StartupView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:ui="urn:KinonekoSoftware/ui"
            xmlns:this="clr-namespace:MaoTouGu.JuXiaoYou.Pages"
            xmlns:project="clr-namespace:MaoTouGu.JuXiaoYou"
            xmlns:thisVM="clr-namespace:MaoTouGu.JuXiaoYou.Pages"
            mc:Ignorable="d"
            d:DesignWidth="800" d:DesignHeight="450"
            d:DataContext="{d:DesignInstance Type={x:Type thisVM:StartupViewModel}, IsDesignTimeCreatable=True}">
    <UserControl.Resources>
        <thisVM:DefaultProjectConverter x:Key="IsDefault" />
        <thisVM:UrlConverter x:Key="URL" />
        <BindingProxy x:Key="ViewModel" ViewModel="{Binding}" />

        <Style TargetType="{x:Type ui:ListBoxItem}" BasedOn="{StaticResource ListBoxItem.Outline}">
            <Setter Property="BorderThickness" Value="4 0 0 0" />
            <Setter Property="ui:ControlAssist.CornerRadius" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <Grid ShowGridLines="False">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="48" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="35.9" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>


        <!---->
        <!---->
        <!---->
        <HeaderedContentControl ui:ControlAssist.CornerRadius="0"
                                Grid.Column="1"
                                Grid.Row="0"
                                Grid.RowSpan="3"
                                Margin="16 0"
                                Style="{StaticResource SettingItem}">
            <HeaderedContentControl.Header>
                <!---->
                <!---->
                <!---->
                <TextBlock Grid.Column="1"
                           Grid.Row="1"
                           FontFamily="{StaticResource HeiTi}"
                           FontSize="42"
                           Text="企划" />
            </HeaderedContentControl.Header>

            <ui:ControlAssist.ToolBar>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom">


                    <ui:TextButton Flyout.Index="5"
                                   Flyout.Placement="Top"
                                   Flyout.Hint="Tutorial"
                                   Content="打开"
                                   Command="{Binding AddProject}"
                                   HorizontalContentAlignment="Left" />

                    <ui:TextButton Flyout.Index="5"
                                   Flyout.Placement="Top"
                                   Flyout.Hint="Tutorial"
                                   Content="新建"
                                   Command="{Binding CreateProject}"
                                   HorizontalContentAlignment="Left" />

                    <ui:TextButton Flyout.Index="5"
                                   Flyout.Placement="Top"
                                   Flyout.Hint="Tutorial"
                                   Content="编辑"
                                   Command="{Binding EditProject}"
                                   CommandParameter="{Binding Project, Mode=OneWay}"
                                   HorizontalContentAlignment="Left" />

                    <ui:TextButton Flyout.Index="5"
                                   Flyout.Placement="Top"
                                   Flyout.Hint="Tutorial"
                                   Content="分享"
                                   Command="{Binding ShareProject}"
                                   CommandParameter="{Binding Project, Mode=OneWay}"
                                   HorizontalContentAlignment="Left" />


                    <ui:TextButton Flyout.Index="5"
                                   Flyout.Placement="Top"
                                   Flyout.Hint="Tutorial"
                                   Content="删除"
                                   Command="{Binding RemoveProject}"
                                   CommandParameter="{Binding Project, Mode=OneWay}"
                                   HorizontalContentAlignment="Left" />
                </StackPanel>
            </ui:ControlAssist.ToolBar>
            <DockPanel>

                <!---->
                <!---->
                <!---->
                <StackPanel DockPanel.Dock="Bottom"
                            Orientation="Horizontal">


                    <ui:TextButton Flyout.Index="5"
                                   Flyout.Placement="Top"
                                   Flyout.Hint="Tutorial"
                                   Content="设为默认项目"
                                   Command="{Binding AsDefaultProject, Mode=OneWay}"
                                   CommandParameter="{Binding Project, Mode=OneWay}"
                                   HorizontalContentAlignment="Left" />

                </StackPanel>

                <!---->
                <!---->
                <!---->
                <ui:ListBox Margin="0 8 0 0"
                            ItemsSource="{Binding Projects, Mode=OneWay}"
                            SelectedItem="{Binding Project, Mode=TwoWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ShowGridLines="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*" />
                                    <RowDefinition Height="1*" />
                                </Grid.RowDefinitions>
                                <ui:Iconify Grid.Column="0"
                                            Grid.Row="0"
                                            Grid.RowSpan="2"
                                            Icon="{StaticResource World}"
                                            IconSize="37"
                                            Margin="8 0 16 0" />

                                <ui:EmptyStateView Grid.Column="1"
                                                   Grid.Row="0"
                                                   Margin="0 0 0 2"
                                                   IsEmpty="{Binding Converter={StaticResource IsDefault}}">
                                    <ui:EmptyStateView.EmptyState>
                                        <StackPanel Orientation="Horizontal">

                                            <TextBlock Grid.Column="1"
                                                       Grid.Row="0"
                                                       FontSize="18"
                                                       FontFamily="{StaticResource SongTi}"
                                                       Text="{Binding Name}" />

                                            <Border BorderBrush="{DynamicResource Brush.HighlightB3}"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Margin="16 0 0 0"
                                                    Padding="8 4"
                                                    VerticalAlignment="Center">

                                                <TextBlock FontSize="12"
                                                           Foreground="{DynamicResource Brush.HighlightB3}"
                                                           Text="默认项目"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                        </StackPanel>
                                    </ui:EmptyStateView.EmptyState>

                                    <TextBlock FontSize="18"
                                               FontFamily="{StaticResource HeiTi}"
                                               Text="{Binding Name}" />

                                </ui:EmptyStateView>

                                <TextBlock Grid.Column="1"
                                           Grid.Row="1"
                                           FontFamily="{StaticResource SongTi}"
                                           FontSize="12"
                                           Foreground="{DynamicResource Brush.Foreground.Level2}"
                                           Text="{Binding Url, Converter={StaticResource URL}}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" />

                                <ui:GhostButton Grid.Column="2"
                                                Grid.Row="0"
                                                Grid.RowSpan="2"
                                                ui:ControlAssist.Icon="{StaticResource FeatherIcon.Folder}"
                                                Content="进入企划"
                                                Command="{Binding Source={StaticResource ViewModel},Path=ViewModel.OpenProject}"
                                                CommandParameter="{Binding}"
                                                IconMode="Text"
                                                Height="36" />

                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ui:ListBox>
            </DockPanel>


        </HeaderedContentControl>


        <!---->
        <!---->
        <!---->
        <HeaderedContentControl ui:ControlAssist.CornerRadius="0"
                                Grid.Column="2"
                                Grid.Row="1"
                                Grid.RowSpan="3"
                                Header="账户管理"
                                Margin="16 -3 16 0"
                                Style="{StaticResource SettingItem}">
            <ui:ControlAssist.ToolBar>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal">


                    <ui:TextButton Flyout.Index="5"
                                   Flyout.Placement="Top"
                                   Flyout.Hint="Tutorial"
                                   Content="添加"
                                   Command="{Binding AddCredential}"
                                   CommandParameter="{Binding Project, Mode=OneWay}"
                                   HorizontalContentAlignment="Left" />

                    <ui:TextButton Flyout.Index="5"
                                   Flyout.Placement="Top"
                                   Flyout.Hint="Tutorial"
                                   Content="注册"
                                   Command="{Binding SignUpCredential}"
                                   CommandParameter="{Binding Project, Mode=OneWay}"
                                   HorizontalContentAlignment="Left" />

                    <ui:TextButton Flyout.Index="5"
                                   Flyout.Placement="Top"
                                   Flyout.Hint="Tutorial"
                                   Content="编辑"
                                   Command="{Binding EditCredential}"
                                   CommandParameter="{Binding Credential, Mode=OneWay}"
                                   HorizontalContentAlignment="Left" />


                    <ui:TextButton Flyout.Index="5"
                                   Flyout.Placement="Top"
                                   Flyout.Hint="Tutorial"
                                   Content="删除"
                                   Command="{Binding RemoveCredential}"
                                   CommandParameter="{Binding Credential, Mode=OneWay}"
                                   HorizontalContentAlignment="Left" />
                </StackPanel>
            </ui:ControlAssist.ToolBar>

            <!---->
            <!---->
            <!---->
            <ui:ListBox Margin="0 8 0 0"
                        ItemsSource="{Binding Credentials, Mode=OneWay}"
                        SelectedItem="{Binding Credential, Mode=TwoWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <ui:Iconify DockPanel.Dock="Left"
                                        Icon="{StaticResource FeatherIcon.People}"
                                        IconSize="21"
                                        Margin="8 0 16 0" />
                            <Border DockPanel.Dock="Right"
                                    BorderBrush="{DynamicResource Brush.HighlightB3}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Margin="16 0 0 0"
                                    Padding="8 4"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsDefault, Mode=OneWay, Converter={x:Static Converters.TrueToVisibility}}">

                                <TextBlock FontSize="12"
                                           Foreground="{DynamicResource Brush.HighlightB3}"
                                           Text="默认账户"
                                           VerticalAlignment="Center" />
                            </Border>

                            <TextBlock DockPanel.Dock="Top"
                                       FontSize="18"
                                       FontFamily="{StaticResource HeiTi}"
                                       Text="{Binding Account}" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ui:ListBox>
        </HeaderedContentControl>


        <!---->
        <!---->
        <!---->
        <StackPanel Grid.Column="2"
                    Grid.Row="3"
                    Margin="0 0 0 8"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">

            <ui:GhostButton Flyout.Index="5"
                            Flyout.Placement="Top"
                            Flyout.Hint="Tutorial"
                            ui:ControlAssist.CornerRadius="0"
                            ui:ControlAssist.Icon="{StaticResource FeatherIcon.Book}"
                            Content="教程"
                            Command="{Binding Tutorials}"
                            IconMode="Both"
                            HorizontalContentAlignment="Left" />

            <ui:GhostButton Flyout.Index="6"
                            Flyout.Placement="Top"
                            Flyout.Hint="Donate"
                            ui:ControlAssist.CornerRadius="0"
                            ui:ControlAssist.Icon="{StaticResource FeatherIcon.Gift}"
                            Content="赞助"
                            Command="{Binding Dontate}"
                            Margin="4 0"
                            IconMode="Both"
                            HorizontalContentAlignment="Left" />

            <ui:GhostButton ui:ControlAssist.CornerRadius="0"
                            ui:ControlAssist.Icon="{StaticResource FeatherIcon.Search}"
                            Content="搜索"
                            Command="{Binding Search}"
                            Margin="4 0"
                            IconMode="Both"
                            HorizontalContentAlignment="Left" />

            <ui:GhostButton ui:ControlAssist.CornerRadius="0"
                            ui:ControlAssist.Icon="{StaticResource FeatherIcon.Settings}"
                            Content="设置"
                            Command="{Binding Settings}"
                            Margin="4 0 0 0"
                            IconMode="Both"
                            HorizontalContentAlignment="Left" />

        </StackPanel>
    </Grid>
</ForestPage>