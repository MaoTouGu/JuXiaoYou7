<ForestDialog x:Class="MaoTouGu.JuXiaoYou.Pages.NewProjectView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:ui="urn:KinonekoSoftware/ui"
              xmlns:this="clr-namespace:MaoTouGu.JuXiaoYou.Pages"
              xmlns:thisVM="clr-namespace:MaoTouGu.JuXiaoYou.Pages"
              mc:Ignorable="d"
              d:DesignWidth="800" d:DesignHeight="450"
              d:DataContext="{d:DesignInstance Type={x:Type thisVM:NewProjectViewModel}, IsDesignTimeCreatable=True}">

    <Border Background="{DynamicResource Brush.Background.Level3}"
            Padding="32 16"
            Width="540">
        <DockPanel>

            <UniformGrid DockPanel.Dock="Bottom"
                         Columns="2"
                         Margin="0 8">

                <!---->
                <!---->
                <!---->
                <ui:MainButton Content="添加"
                               Command="{Binding CompleteCommand}"
                               HorizontalAlignment="Center"
                               IconMode="Text"
                               Margin="0 0 8 0"
                               Height="32"
                               Width="240" />
                <!---->
                <!---->
                <!---->
                <ui:GhostButton DockPanel.Dock="Bottom"
                                Content="关闭"
                                Command="{Binding CancelCommand}"
                                HorizontalAlignment="Center"
                                IconMode="Text"
                                Margin="8 0 0 0"
                                Height="32"
                                Width="240" />
            </UniformGrid>

            <HeaderedContentControl ui:ControlAssist.FontSize="20"
                                    Padding="0"
                                    Style="{StaticResource SettingItem}">
                <HeaderedContentControl.Header>
                    <DockPanel Margin="0 8">

                        <ui:ToggleButton DockPanel.Dock="Right"
                                         ui:ControlAssist.CornerRadius="0"
                                         Content="在线模式"
                                         IsChecked="{Binding IsOnline, Mode=TwoWay}"
                                         IconMode="Text" />

                        <TextBlock FontSize="24"
                                   Text="创建企划" />
                    </DockPanel>
                </HeaderedContentControl.Header>

                <!---->
                <!---->
                <!---->
                <ui:EmptyStateView NotEmpty="{Binding IsOnline, Mode=OneWay}">
                    <ui:EmptyStateView.EmptyState>
                        <StackPanel>

                            <!---->
                            <!---->
                            <!---->
                            <ui:HeaderedSingleLine CornerRadius="0"
                                                   Header="名字"
                                                   Margin="0 0 0 16"
                                                   Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=50}" />

                            <!---->
                            <!---->
                            <!---->
                            <DockPanel Margin="0 0 0 16">
                                <TextBlock DockPanel.Dock="Top"
                                           Margin="0 0 0 12"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Text="保存位置" />

                                <ui:GhostButton DockPanel.Dock="Right"
                                                ui:ControlAssist.Icon="{StaticResource FeatherIcon.Folder}"
                                                Command="{Binding Pick}"
                                                IconMode="Icon"
                                                Height="36"
                                                Width="36" />

                                <ui:SingleLine CornerRadius="0"
                                               Text="{Binding Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=50}" />

                            </DockPanel>
                        </StackPanel>
                    </ui:EmptyStateView.EmptyState>


                    <StackPanel Grid.IsSharedSizeScope="True"
                                Margin="0">

                        <!---->
                        <!---->
                        <!---->
                        <ui:HeaderedSingleLine CornerRadius="0"
                                               Header="名字"
                                               Margin="0 0 0 16"
                                               Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=50}" />

                        <!---->
                        <!---->
                        <!---->
                        <ui:HeaderedSingleLine CornerRadius="0"
                                               Header="服务器地址"
                                               Margin="0 0 0 16"
                                               Text="{Binding Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=50}" />

                    </StackPanel>
                </ui:EmptyStateView>
            </HeaderedContentControl>
        </DockPanel>
    </Border>
</ForestDialog>