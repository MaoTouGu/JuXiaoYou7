<ForestDialog x:Class="MaoTouGu.JuXiaoYou.Pages.NewCredentialView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:ui="urn:KinonekoSoftware/ui"
              xmlns:this="clr-namespace:MaoTouGu.JuXiaoYou.Pages"
              xmlns:thisVM="clr-namespace:MaoTouGu.JuXiaoYou.Pages"
              mc:Ignorable="d"
              d:DesignWidth="800" d:DesignHeight="450"
              d:DataContext="{d:DesignInstance Type={x:Type thisVM:NewCredentialViewModel}, IsDesignTimeCreatable=True}">
    <Border Background="{DynamicResource Brush.Background.Level3}"
            Width="360"
            Height="450"
            Padding="32">
        <StackPanel VerticalAlignment="Center">

            <!---->
            <!---->
            <!---->
            <TextBlock FontSize="24"
                       Margin="0 0 0 16"
                       Text="添加账号" />

            <!---->
            <!---->
            <!---->
            <TextBlock Text="账号"
                       Margin="0 0 0 8"
                       VerticalAlignment="Center"/>

            <!---->
            <!---->
            <!---->
            <ui:SingleLine Margin="0 0 0 16"
                           CornerRadius="0"
                           Text="{Binding Account, Mode=TwoWay}" />


            <!---->
            <!---->
            <!---->
            <TextBlock Text="密码"
                       Margin="0 0 0 8"
                       VerticalAlignment="Center"/>
                       


            <!---->
            <!---->
            <!---->
            <PasswordBox PasswordAssist.Text="{Binding Password, Mode=TwoWay}"
                         Background="{DynamicResource Brush.Background.Level1}"
                         BorderThickness="0"
                         CaretBrush="{DynamicResource Brush.HighlightB3}"
                         Foreground="{DynamicResource Brush.Foreground.Level1}"
                         Height="36"
                         Padding="8 0"
                         Margin="0 0 0 16"
                         VerticalContentAlignment="Center" />

            <!---->
            <!---->
            <!---->
            <ui:CheckBox Content="设置为默认账户"
                         HorizontalContentAlignment="Left"
                         IsChecked="{Binding IsDefault, Mode=TwoWay}"/>
            
            <!---->
            <!---->
            <!---->
            <ui:MainButton Content="确认"
                           Command="{Binding CompleteCommand}"
                           Height="32"
                           Margin="0 4" />
            <!---->
            <!---->
            <!---->
            <ui:TextButton Content="取消"
                           Command="{Binding CancelCommand}"
                           Height="32"
                           Margin="0 4"  />
        </StackPanel>
    </Border>
</ForestDialog>