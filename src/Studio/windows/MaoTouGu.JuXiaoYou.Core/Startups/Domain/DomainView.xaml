<ForestPage x:Class="MaoTouGu.JuXiaoYou.Startups.DomainView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:ui="urn:KinonekoSoftware/ui"
            xmlns:this="clr-namespace:MaoTouGu.JuXiaoYou.Startups"
            xmlns:thisVM="clr-namespace:MaoTouGu.JuXiaoYou.Startups"
            xmlns:core="clr-namespace:MaoTouGu.Studio.Database.AppModels;assembly=MaoTouGu.Studio.Database"
            xmlns:controls="clr-namespace:MaoTouGu.JuXiaoYou.Controls"
            mc:Ignorable="d"
            d:DesignWidth="800" d:DesignHeight="450"
            d:DataContext="{d:DesignInstance Type={x:Type thisVM:DomainViewModel}, IsDesignTimeCreatable=True}"
            Padding="16 8">

    <UserControl.Resources>
        <ResourceDictionary>
            <Style TargetType="{x:Type ui:ListBoxItem}" BasedOn="{StaticResource ListBoxItem.Outline}">
                <Setter Property="ui:ControlAssist.CornerRadius" Value="0" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Margin" Value="0 0 0 6" />
            </Style>

            <BindingProxy x:Key="ViewModel" ViewModel="{Binding}"/>

            <DataTemplate DataType="{x:Type core:Domain}">
                <Grid Height="135">
                    <Grid.ContextMenu>
                        <ui:ContextMenu Placement="Bottom">
                            <ui:MenuItem Header="编辑"
                                         Command="{Binding Source={StaticResource ViewModel},Path=ViewModel.Edit}"
                                         CommandParameter="{Binding}"/>
                            <ui:MenuItem Header="删除"
                                         Command="{Binding Source={StaticResource ViewModel},Path=ViewModel.Remove}"
                                         CommandParameter="{Binding}"/>
                        </ui:ContextMenu>
                    </Grid.ContextMenu>
                    <controls:ImageEX DockPanel.Dock="Left"
                                      ImageSystem.Source="{Binding Image, Mode=OneWay}"
                                      ImageSystem.Thumbnail="Of360p"
                                      ImageSystem.Type="Image"
                                      ImageSystem.Fallback="Image"
                                      EnableCropped="True"
                                      Height="270"
                                      Width="480"
                                      X="{Binding X, Mode=TwoWay}"
                                      Y="{Binding Y, Mode=TwoWay}" />
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0 0"
                                                 EndPoint="1 1">
                                <GradientStop Color="Transparent" Offset="0" />
                                <GradientStop Color="#20000000" Offset="0.1" />
                                <GradientStop Color="#90000000" Offset="0.5" />
                                <GradientStop Color="#D0000000" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <TextBlock LineHeight="28"
                               FontSize="36"
                               FontFamily="{StaticResource SongTi}"
                               Foreground="White"
                               Padding="0 0 20 20"
                               Text="{Binding Name, Mode=OneWay}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="320" />
            <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>

        <!---->
        <!---->
        <!---->
        <DockPanel VerticalAlignment="Top">
            <ui:GhostButton DockPanel.Dock="Bottom"
                            ui:ControlAssist.Icon="{StaticResource FeatherIcon.PlusCircle}"
                            ui:ControlAssist.IconSize="31"
                            Content="新建"
                            Command="{Binding Add}"
                            FontSize="24"
                            FontFamily="{StaticResource SongTi}"
                            Padding="24"
                            IconMode="Both"
                            HorizontalContentAlignment="Right"
                            VerticalContentAlignment="Bottom">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0 0"
                                         EndPoint="1 1">
                        <GradientStop Color="Transparent" Offset="0" />
                        <GradientStop Color="#20000000" Offset="0.1" />
                        <GradientStop Color="#90000000" Offset="0.5" />
                        <GradientStop Color="#D0000000" Offset="1" />
                    </LinearGradientBrush>
                </Button.Background>
            </ui:GhostButton>

            <ui:ListBox DockPanel.Dock="Top"
                        ItemsSource="{Binding Collection, Mode=OneWay}"
                        SelectedItem="{Binding Selected, Mode=TwoWay}">
            </ui:ListBox>
        </DockPanel>

        <!---->
        <!---->
        <!---->
        <HeaderedContentControl Grid.Column="1"
                                Header="数据"
                                Margin="16 0"
                                Style="{StaticResource SettingItem}">
            <ui:ControlAssist.ToolBar>
                <StackPanel DockPanel.Dock="Top"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <ui:GhostButton ui:ControlAssist.Icon="{StaticResource FeatherIcon.Edit}"
                                    Content="编辑"
                                    Command="{Binding Edit}"
                                    CommandParameter="{Binding Selected, Mode=OneWay}"
                                    IconMode="Both" />


                    <ui:GhostButton ui:ControlAssist.Icon="{StaticResource FeatherIcon.Trash}"
                                    Content="删除"
                                    Command="{Binding Remove}"
                                    CommandParameter="{Binding Selected, Mode=OneWay}"
                                    IconMode="Both" />
                </StackPanel>
            </ui:ControlAssist.ToolBar>

            <ui:ListBox Grid.Column="2"
                        SelectedIndex="0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name, Mode=OneWay}"
                                   TextAlignment="Center"
                                   Margin="8 4"
                                   MinWidth="100" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ui:ListBox>
        </HeaderedContentControl>
    </Grid>
</ForestPage>