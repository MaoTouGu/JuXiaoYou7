<ForestPage x:Class="MaoTouGu.JuXiaoYou.Workspaces.WorldView.WorldViewEditorView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:ui="urn:KinonekoSoftware/ui"
            xmlns:this="clr-namespace:MaoTouGu.JuXiaoYou.Workspaces.WorldView"
            xmlns:thisVM="clr-namespace:MaoTouGu.JuXiaoYou.Workspaces.WorldView"
            mc:Ignorable="d"
            d:DesignWidth="800" d:DesignHeight="450"
            d:DataContext="{d:DesignInstance Type={x:Type thisVM:WorldViewEditorViewModel}, IsDesignTimeCreatable=True}"
            Padding="0 24">

    <Grid ShowGridLines="False">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="7*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="1">
            <Grid DockPanel.Dock="Top">
                <DockPanel>
                    <ui:Iconify Icon="{StaticResource World}"
                                IconSize="41" />

                    <TextBlock FontSize="32"
                               FontFamily="{StaticResource HeiTi}"
                               Margin="16 0 0 0"
                               Text="{Binding WorkspaceItem.Instance.Name}"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Grid>

            <ScrollViewer Margin="0 8 0 0">
                <StackPanel>
                    <HeaderedContentControl Header="基础数据"
                                            Margin="0 8"
                                            Style="{StaticResource HeaderedContentControl.DecoratedStyle1}">
                        <ui:ListBox ItemsSource="{Binding WorkspaceItem.Children, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ui:UnifiedColumnPanel DesiredWidth="240"
                                                           VerticalAlignment="Top" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="8">
                                        <ui:Iconify DockPanel.Dock="Top"
                                                    Icon="{StaticResource World}"
                                                    IconSize="41" />

                                        <TextBlock FontSize="18"
                                                   FontFamily="{StaticResource SongTi}"
                                                   Margin="0 8"
                                                   Text="{Binding Instance.Name}"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ui:ListBox>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="子集"
                                            Margin="0 8"
                                            Style="{StaticResource HeaderedContentControl.DecoratedStyle1}">
                        <ui:ListBox ItemsSource="{Binding WorkspaceItem.Children, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ui:UnifiedColumnPanel DesiredWidth="240"
                                                           VerticalAlignment="Top" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="8">
                                        <ui:Iconify DockPanel.Dock="Top"
                                                    Icon="{StaticResource World}"
                                                    IconSize="41" />

                                        <TextBlock FontSize="18"
                                                   FontFamily="{StaticResource SongTi}"
                                                   Margin="0 8"
                                                   Text="{Binding Instance.Name}"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ui:ListBox>
                    </HeaderedContentControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</ForestPage>