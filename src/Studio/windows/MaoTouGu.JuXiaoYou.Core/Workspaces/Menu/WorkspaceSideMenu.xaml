            <workspace:WorldViewWorkspacePanel/>
        </ui:IconifyTabItem>

        <!-- ============ 设定 ============-->
        <ui:IconifyTabItem ui:ControlAssist.Icon="{StaticResource Moniker}"
                           ui:ControlAssist.IsFilled="True">
            <workspace:MonikerWorkspacePanel/>
        </ui:IconifyTabItem>

        <!-- ============ 关系 ============-->
        <ui:IconifyTabItem ui:ControlAssist.Icon="{StaticResource Timeline}"
                           ui:ControlAssist.IconSize="23"
                           ui:ControlAssist.IsFilled="True">
            <workspace:TimelineWorkspacePanel/>
        </ui:IconifyTabItem>

        <!-- ============ 团队 ============-->
        <ui:IconifyTabItem ui:ControlAssist.Icon="{StaticResource FeatherIcon.People}"
                           ui:ControlAssist.IconSize="23">
            <workspace:TeamspacePanel/>
        </ui:IconifyTabItem>


        <!-- ============ 系统 ============-->
        <ui:IconifyTabItem ui:ControlAssist.Icon="{StaticResource FeatherIcon.Book}"
                           ui:ControlAssist.IconSize="19.01">
