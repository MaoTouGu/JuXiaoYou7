        <!-- ============ 碎片化叙事 ============-->
        <ui:IconifyTabItem ui:ControlAssist.Icon="{StaticResource Components}"
                           ui:ControlAssist.IconSize="23">
            <workspace:NarrativeWorkspacePanel/>
        </ui:IconifyTabItem>


        <!-- ============ 系统 ============-->
        <ui:IconifyTabItem ui:ControlAssist.Icon="{StaticResource Properties}"
                           ui:ControlAssist.IconSize="29"
                           ui:ControlAssist.IsFilled="False">
            <workspace:FeatureWorkspace/>
