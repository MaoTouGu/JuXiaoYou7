<UserControl x:Class="MaoTouGu.JuXiaoYou.Workspaces.FeatureWorkspacePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="urn:KinonekoSoftware/ui"
             xmlns:this="clr-namespace:MaoTouGu.JuXiaoYou.Workspaces"
             xmlns:thisVM="clr-namespace:MaoTouGu.JuXiaoYou.Workspaces"
             xmlns:workspace="clr-namespace:MaoTouGu.JuXiaoYou.Workspaces"
             xmlns:feature="clr-namespace:MaoTouGu.JuXiaoYou.Services.Plugins;assembly=MaoTouGu.JuXiaoYou.Services.Plugins"
             mc:Ignorable="d"
             d:DesignWidth="800" d:DesignHeight="450"
             d:DataContext="{d:DesignInstance Type={x:Type thisVM:WorkspaceViewModel}, IsDesignTimeCreatable=True}">
    <UserControl.Resources>
        
        <GeometryGroup x:Key="Plugin">
            <GeometryGroup.Children>
                <Geometry>F1 M16,16z M0,0z M3,9L1,9 1,7 3,7 3,9z</Geometry>
                <Geometry>F1 M16,16z M0,0z M11,12L7,12C5.34315,12,4,10.6569,4,9L4,7C4,5.34315,5.34315,4,7,4L11,4 11,12z</Geometry>
                <Geometry>F0 M16,16z M0,0z M11,4L7,4C5.34315,4,4,5.34315,4,7L4,9C4,10.6569,5.34315,12,7,12L11,12 11,11 11,10 11,6 11,5 11,4z M12,5L12,4C12,3.44772,11.5523,3,11,3L7,3C5.13616,3,3.57006,4.27477,3.12602,6L1,6C0.447715,6,0,6.44772,0,7L0,9C0,9.55228,0.447715,10,1,10L3.12602,10C3.57006,11.7252,5.13616,13,7,13L11,13C11.5523,13,12,12.5523,12,12L12,11 15.5,11C15.7761,11 16,10.7761 16,10.5 16,10.2239 15.7761,10 15.5,10L12,10 12,6 15.5,6C15.7761,6 16,5.77614 16,5.5 16,5.22386 15.7761,5 15.5,5L12,5z M3,7L3,9 1,9 1,7 3,7z</Geometry>
            </GeometryGroup.Children>
        </GeometryGroup>

        <GeometryGroup x:Key="Properties">
            <GeometryGroup.Children>
                <Geometry>F1 M16,16z M0,0z M2.5,3.5L9.5,3.5 M2.5,7.5L4.5,7.5 M2.5,11.5L8.5,11.5 M11.5,3.5L13.5,3.5 M6.5,7.5L13.5,7.5 M10.5,11.5L13.5,11.5</Geometry>
                <EllipseGeometry RadiusX="1" RadiusY="1" Center="10.5,3.5" />
                <EllipseGeometry RadiusX="1" RadiusY="1" Center="5.5,7.5" />
                <EllipseGeometry RadiusX="1" RadiusY="1" Center="9.5,11.5" />
            </GeometryGroup.Children>
        </GeometryGroup>

        
        <DataTemplate DataType="{x:Type feature:IVisualizerGenerator}">
            <DockPanel>
                <ui:Iconify Foreground="SlateGray"
                            IsFilled="True"
                            Icon="{StaticResource Plugin}"
                            IconSize="19" />

                <TextBlock Margin="8 0 0 0"
                           Text="{Binding Name, Mode=OneWay}"
                           VerticalAlignment="Center" />
            </DockPanel>
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type feature:PluginManifest}">
            <DockPanel>
                <ui:Iconify Icon="{StaticResource FeatherIcon.Folder}"
                            IconSize="19"
                            Foreground="{DynamicResource Brush.HighlightB4}"
                            IsFilled="True" />

                <TextBlock Margin="8 0 0 0"
                           Text="{Binding Path, Mode=OneWay}"
                           VerticalAlignment="Center" />
            </DockPanel>
        </DataTemplate>
        
        <HierarchicalDataTemplate DataType="{x:Type workspace:PluginWorkspaceItem}"
                                  ItemsSource="{Binding Items, Mode=OneWay}">
            <DockPanel>
                <ui:Iconify Foreground="DarkGray"
                            IsFilled="True"
                            Icon="{StaticResource Plugin}"
                            IconSize="19" />
        
                <TextBlock Margin="8 0 0 0"
                           Text="插件"
                           VerticalAlignment="Center" />
            </DockPanel>
        </HierarchicalDataTemplate>
        
        <HierarchicalDataTemplate DataType="{x:Type workspace:FeatureWorkspaceItem}"
                                  ItemsSource="{Binding Items, Mode=OneWay}">
            <DockPanel>
                <ui:Iconify Icon="{StaticResource Properties}"
                            IconSize="21"
                            IsFilled="False" />
        
                <TextBlock Margin="8 0 0 0"
                           Text="可继承功能"
                           VerticalAlignment="Center" />
            </DockPanel>
        </HierarchicalDataTemplate>
        
        <HierarchicalDataTemplate DataType="{x:Type workspace:VisualManagerWorkspaceItem}"
                                  ItemsSource="{Binding Items, Mode=OneWay}">
            <DockPanel>
                <ui:Iconify Icon="{StaticResource Properties}"
                            IconSize="21" />
        
                <TextBlock Margin="8 0 0 0"
                           Text="视觉编辑器"
                           VerticalAlignment="Center" />
            </DockPanel>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <ui:TreeView ItemsSource="{Binding Feature.Items}">
    </ui:TreeView>
</UserControl>
