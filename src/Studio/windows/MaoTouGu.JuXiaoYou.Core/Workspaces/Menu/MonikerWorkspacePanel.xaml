        <Geometry x:Key="More">F1 M24,24z M0,0z M6,20L7,16 3,16 3.5,14 7.5,14 8.5,10 4.5,10 5,8 9,8 10,4 12,4 11,8 15,8 16,4 18,4 17,8 21,8 20.5,10 16.5,10 15.5,14 19.5,14 19,16 15,16 14,20 12,20 13,16 9,16 8,20z M9.5,14L13.5,14 14.5,10 10.5,10z</Geometry>
        <!-- -->
        <!-- -->
        <!-- -->

        <!-- ============ TopClassWorkspaceItem ============-->
        <HierarchicalDataTemplate DataType="{x:Type workspace:TopClassWorkspaceItem}"
                                  ItemsSource="{Binding Children, Mode=OneWay}">
            <DockPanel Background="Transparent">
                <DockPanel.ContextMenu>
                    <ui:ContextMenu>

                        <ui:MenuItem Header="添加"
                                     Click="MenuItem_AddSubClass"
                                     CommandParameter="{Binding}" />
                        <ui:MenuItem Header="编辑"
                                     Click="MenuItem_EditTopClass"
                                     CommandParameter="{Binding}" />
                        <Separator />
                        <ui:MenuItem Header="删除"
                                     Click="MenuItem_RemoveTopClass"
                                     CommandParameter="{Binding}" />
                    </ui:ContextMenu>
                </DockPanel.ContextMenu>
                <ui:Iconify Icon="{StaticResource World}"
                            IconSize="21" />
                <TextBlock Margin="8 0 0 0"
                           Text="{Binding Instance.Name, Mode=OneWay}"
                           VerticalAlignment="Center" />
            </DockPanel>
        </HierarchicalDataTemplate>


        <!-- ============ SubClassWorkspaceItem ============-->
        <HierarchicalDataTemplate DataType="{x:Type workspace:SubClassWorkspaceItem}"
                                  ItemsSource="{Binding Children, Mode=OneWay}">
            <DockPanel Background="Transparent">
                <DockPanel.ContextMenu>
                    <ui:ContextMenu>

                        <ui:MenuItem Header="添加设定"
                                     Click="MenuItem_Add"
                                     CommandParameter="{Binding}" />
                        <ui:MenuItem Header="编辑设定"
                                     Click="MenuItem_Edit"
                                     CommandParameter="{Binding}" />

                        <ui:MenuItem Header="世界">
                            <ui:MenuItem Header="添加小世界"
                                         Click="MenuItem_AddSubClass"
                                         CommandParameter="{Binding}" />
                            <ui:MenuItem Header="编辑小世界"
                                         Click="MenuItem_EditSubClass"
                                         CommandParameter="{Binding}" />
                            <Separator />
                            <ui:MenuItem Header="删除小世界"
                                         Click="MenuItem_RemoveSubClass"
                                         CommandParameter="{Binding}" />
                        </ui:MenuItem>
                        <Separator />
                        <Separator />
                        <ui:MenuItem Header="删除设定"
                                     Click="MenuItem_Remove"
                                     CommandParameter="{Binding}" />
                    </ui:ContextMenu>
                </DockPanel.ContextMenu>
                <ui:Iconify Icon="{StaticResource More}"
                            IconSize="21"
                            IsFilled="True" />
                <TextBlock Margin="8 0 0 0"
                           Text="{Binding Instance.Name, Mode=OneWay}"
                           VerticalAlignment="Center" />
            </DockPanel>
        </HierarchicalDataTemplate>

        <!-- ============ WorldViewFolder ============-->
        <HierarchicalDataTemplate DataType="{x:Type workspace:WorldViewFolder}"
                                  ItemsSource="{Binding Items, Mode=OneWay}">
            <DockPanel Background="Transparent">
                <DockPanel.ContextMenu>
                    <ui:ContextMenu>
                        <ui:MenuItem Header="添加"
                                     Click="MenuItem_AddTopClass" />
                        <Separator />
                        <ui:MenuItem Header="开发者操作">
                            <ui:MenuItem Header="导出快照" />
                        </ui:MenuItem>
                    </ui:ContextMenu>
                </DockPanel.ContextMenu>
                <ui:Iconify Foreground="#FFAB12"
                            Icon="{StaticResource FeatherIcon.Folder}"
                            IconSize="19" />

                <TextBlock Margin="8 0 0 0"
                           Text="{Binding Name, Mode=OneWay}"
                           VerticalAlignment="Center" />
            </DockPanel>
        </HierarchicalDataTemplate>

        <!-- -->
        <!-- -->
        <!-- -->
        <!-- ============ Favorite __ 星标设定 ============-->
        <HierarchicalDataTemplate DataType="{x:Type monikers:FavoriteMonikerWorkspaceItem}"
                                  ItemsSource="{Binding Items, Mode=OneWay}">

            <DockPanel>
                <ui:Iconify Foreground="#FFAB12"
                            Icon="{StaticResource FeatherIcon.Star}"
                            IconSize="19"
                            IsFilled="True" />

                <TextBlock Margin="8 0 0 0"
                           Text="{Binding Text, Mode=OneWay}"
                           VerticalAlignment="Center" />
            </DockPanel>
        </HierarchicalDataTemplate>

        <!-- -->
        <!-- -->
        <!-- -->
        <!-- ============ Recently __ 最近设定 ============-->
        <HierarchicalDataTemplate DataType="{x:Type monikers:RecentlyMonikerWorkspaceItem}"
                                  ItemsSource="{Binding Items, Mode=OneWay}">

            <DockPanel>
                <ui:Iconify Icon="{StaticResource FeatherIcon.Clock}"
                            IconSize="19" />

                <TextBlock Margin="8 0 0 0"
                           Text="最近设定"
                           VerticalAlignment="Center" />
            </DockPanel>
        </HierarchicalDataTemplate>

        <!-- -->
        <!-- -->
        <!-- -->
        <!-- ============ All __ 全部设定 ============-->
        <HierarchicalDataTemplate DataType="{x:Type monikers:GlobalMonikerWorkspaceItem}"
                                  ItemsSource="{Binding Items, Mode=OneWay}">
            <DockPanel Background="Transparent">
                <ui:Iconify Foreground="#608800"
                            Icon="{StaticResource Database}"
                            IconSize="19"
                            IsFilled="True" />

                <TextBlock Margin="8 0 0 0"
                           Text="全部设定"
                           VerticalAlignment="Center" />
            </DockPanel>
        </HierarchicalDataTemplate>

        <!-- -->
        <!-- -->
        <!-- -->
        <!-- ============ Deleted __ 已删除 ============-->
        <HierarchicalDataTemplate DataType="{x:Type monikers:DeletedMonikerWorkspaceItem}"
                                  ItemsSource="{Binding Items, Mode=OneWay}">

            <DockPanel Background="Transparent">
                <DockPanel.ContextMenu>
                    <ui:ContextMenu>
                        <ui:MenuItem Header="恢复设定"
                                     Click="MenuItem_Recovery" />
                        <Separator />
                        <ui:MenuItem Header="开发者操作">
                            <ui:MenuItem Header="导出快照" />
                        </ui:MenuItem>
                    </ui:ContextMenu>
                </DockPanel.ContextMenu>
                <ui:Iconify Foreground="#bb2124"
                            Icon="{StaticResource Deleted}"
                            IconSize="19"
                            IsFilled="True" />

                <TextBlock Margin="8 0 0 0"
                           Text="已删除"
                           VerticalAlignment="Center" />
            </DockPanel>
        </HierarchicalDataTemplate>

        <!-- -->
        <!-- -->
        <!-- -->
        <!-- ============ ByLabel __ 按标签分类 ============-->
        <HierarchicalDataTemplate DataType="{x:Type monikers:ByLabelMonikerWorkspaceItem}"
                                  ItemsSource="{Binding Items, Mode=OneWay}">

            <DockPanel Background="Transparent">
                <DockPanel.ContextMenu>
                    <ui:ContextMenu>
                        <ui:MenuItem Header="添加"
                                     Click="MenuItem_AddLabel" />
                        <ui:MenuItem Header="编辑"
                                     Click="MenuItem_EditLabel"
                                     CommandParameter="{Binding}" />
                        <Separator />
                        <ui:MenuItem Header="删除"
                                     Click="MenuItem_RemoveLabel"
                                     CommandParameter="{Binding}" />
                        <Separator />
                        <ui:MenuItem Header="开发者操作">
                            <ui:MenuItem Header="导出快照" />
                        </ui:MenuItem>
                    </ui:ContextMenu>
                </DockPanel.ContextMenu>
                <ui:Iconify Foreground="#90A800"
                            Icon="{StaticResource BookmarkList}"
                            IconSize="21"
                            IsFilled="True" />

                <TextBlock Margin="8 0 0 0"
                           Text="按标签分类"
                           VerticalAlignment="Center" />
            </DockPanel>
        </HierarchicalDataTemplate>

        <!-- -->
        <!-- -->
        <!-- -->
        <!-- ============ ByDomain __ 按世界分类 ============-->
        <HierarchicalDataTemplate DataType="{x:Type monikers:ByIndexerMonikerWorkspaceItem}"
                                  ItemsSource="{Binding Items, Mode=OneWay}">

            <DockPanel Background="Transparent">
                <DockPanel.ContextMenu>
                    <ui:ContextMenu>
                        <ui:MenuItem Header="添加"
                                     Click="MenuItem_AddTopClass" />
                    </ui:ContextMenu>
                </DockPanel.ContextMenu>
                <ui:Iconify Icon="{StaticResource World}"
                            IconSize="19" />

                <TextBlock Margin="8 0 0 0"
                           Text="按世界分类"
                           VerticalAlignment="Center" />
            </DockPanel>
        </HierarchicalDataTemplate>


        <!-- -->
        <!-- -->
        <!-- -->
        <!-- ============ ByFolder __ 按目录分类 ============-->
        <HierarchicalDataTemplate DataType="{x:Type monikers:ByFolderMonikerWorkspaceItem}"
                                  ItemsSource="{Binding Items, Mode=OneWay}">

            <DockPanel Background="Transparent">
                <DockPanel.ContextMenu>
                    <ui:ContextMenu>
                        <ui:MenuItem Header="添加设定"
                                     Click="MenuItem_Add"
                                     CommandParameter="{Binding}" />
                        <ui:MenuItem Header="编辑设定"
                                     Click="MenuItem_Edit"
                                     CommandParameter="{Binding}" />
                        <ui:MenuItem Header="删除设定"
                                     Click="MenuItem_Remove"
                                     CommandParameter="{Binding}" />
                        <Separator />

                        <ui:MenuItem Header="添加文件夹"
                                     Click="MenuItem_AddFolder" />
                        <ui:MenuItem Header="编辑文件夹"
                                     Click="MenuItem_EditFolder"
                                     CommandParameter="{Binding}" />
                        <ui:MenuItem Header="删除文件夹"
                                     Click="MenuItem_RemoveFolder"
                                     CommandParameter="{Binding}" />
                    </ui:ContextMenu>
                </DockPanel.ContextMenu>
                <ui:Iconify Foreground="#d48900"
                            Icon="{StaticResource FeatherIcon.Folder}"
                            IconSize="19" />

                <TextBlock Margin="8 0 0 0"
                           Text="按目录分类"
                           VerticalAlignment="Center" />
            </DockPanel>
        </HierarchicalDataTemplate>
        <!-- -->
        <!-- -->
        <!-- -->
        <!-- ============ BySetting __ 自定义分类 ============-->
        <HierarchicalDataTemplate DataType="{x:Type monikers:BySettingMonikerWorkspaceItem}"
                                  ItemsSource="{Binding Items, Mode=OneWay}">

            <DockPanel Background="Transparent">
                <DockPanel.ContextMenu>
                    <ui:ContextMenu>
                        <ui:MenuItem Header="添加"
                                     Click="MenuItem_AddFilter" />
                        <ui:MenuItem Header="导入"
                                     Click="MenuItem_ImportFilter"
                                     CommandParameter="{Binding}" />
                        <Separator />
                        <ui:MenuItem Header="编辑"
                                     Click="MenuItem_EditFilter"
                                     CommandParameter="{Binding}" />
                        <ui:MenuItem Header="删除"
                                     Click="MenuItem_RemoveFilter"
                                     CommandParameter="{Binding}" />
                    </ui:ContextMenu>
                </DockPanel.ContextMenu>
                <ui:Iconify Foreground="#548AF7"
                            Icon="{StaticResource Components}"
                            IconSize="19" />

                <TextBlock Margin="8 0 0 0"
                           Text="自定义分类"
                           VerticalAlignment="Center" />
            </DockPanel>
        </HierarchicalDataTemplate>

        <!-- -->
        <!-- -->
        <!-- -->
        <!-- ============ BySettingFilterMethodItem __ 设定 ============-->
        <DataTemplate DataType="{x:Type monikers:BySettingFilterMethodItem}">
            <DockPanel>
                <DockPanel.ContextMenu>
                    <ui:ContextMenu>
                        <ui:MenuItem Header="编辑"
                                     Click="MenuItem_EditFilter"
                                     CommandParameter="{Binding}" />
                        <Separator />
                        <ui:MenuItem Header="导入"
                                     Click="MenuItem_ImportFilter"
                                     CommandParameter="{Binding}" />
                        <ui:MenuItem Header="导出"
                                     Click="MenuItem_ExportFilter"
                                     CommandParameter="{Binding}" />
                        <Separator />
                        <ui:MenuItem Header="删除"
                                     Click="MenuItem_RemoveFilter"
                                     CommandParameter="{Binding}" />
                    </ui:ContextMenu>
                </DockPanel.ContextMenu>
                <ui:Iconify Icon="{StaticResource FeatherIcon.Filter}"
                            IconSize="21" />

                <ContentPresenter Content="{Binding Filter.Name, Mode=OneWay}"
                                  Margin="8 0 0 0" />
            </DockPanel>
        </DataTemplate>

        <!-- -->
        <!-- -->
        <!-- -->
        <!-- ============ BySettingFilterMethodItem __ 设定 ============-->
        <DataTemplate DataType="{x:Type monikers:LabelWrapperItem}">
            <DockPanel>
                <DockPanel.ContextMenu>
                    <ui:ContextMenu>

                        <ui:MenuItem Header="添加设定"
                                     Click="MenuItem_Add"
                                     CommandParameter="{Binding}" />
                        <ui:MenuItem Header="编辑设定"
                                     Click="MenuItem_Edit"
                                     CommandParameter="{Binding}" />
                        <ui:MenuItem Header="删除设定"
                                     Click="MenuItem_Remove"
                                     CommandParameter="{Binding}" />
                        <Separator />

                        <ui:MenuItem Header="添加标签"
                                     Click="MenuItem_AddLabel"
                                     CommandParameter="{Binding}" />
                        <ui:MenuItem Header="编辑标签"
                                     Click="MenuItem_EditLabel"
                                     CommandParameter="{Binding}" />
                        <Separator />
                        <ui:MenuItem Header="删除标签"
                                     Click="MenuItem_RemoveLabel"
                                     CommandParameter="{Binding}" />
                    </ui:ContextMenu>
                </DockPanel.ContextMenu>
                <ui:Iconify Icon="{StaticResource Bookmark}"
                            IconSize="19" />

                <ContentPresenter Content="{Binding Label.Name, Mode=OneWay}"
                                  Margin="8 0 0 0" />
            </DockPanel>
        </DataTemplate>

        <!-- -->
        <!-- -->
        <!-- -->
        <!-- ============ BySettingFilterMethodItem __ 设定 ============-->
        <HierarchicalDataTemplate DataType="{x:Type monikers:FolderWrapperItem}"
                                  ItemsSource="{Binding Items}">
            <DockPanel>
                <DockPanel.ContextMenu>
                    <ui:ContextMenu>
                        <ui:MenuItem Header="添加设定"
                                     Click="MenuItem_Add"
                                     CommandParameter="{Binding}" />
                        <ui:MenuItem Header="编辑设定"
                                     Click="MenuItem_Edit"
                                     CommandParameter="{Binding}" />
                        <ui:MenuItem Header="删除设定"
                                     Click="MenuItem_Remove"
                                     CommandParameter="{Binding}" />
                        <Separator />

                        <ui:MenuItem Header="添加文件夹"
                                     Click="MenuItem_AddFolder" />
                        <ui:MenuItem Header="编辑文件夹"
                                     Click="MenuItem_EditFolder"
                                     CommandParameter="{Binding}" />
                        <ui:MenuItem Header="删除文件夹"
                                     Click="MenuItem_RemoveFolder"
                                     CommandParameter="{Binding}" />
                    </ui:ContextMenu>
                </DockPanel.ContextMenu>
                <ui:Iconify Icon="{StaticResource FeatherIcon.Folder}"
                            IconSize="21" />

                <ContentPresenter Content="{Binding Folder.Name, Mode=OneWay}"
                                  Margin="8 0 0 0" />
            </DockPanel>
        </HierarchicalDataTemplate>
        <!-- -->
        <!-- -->
        <!-- -->
        <!-- ============ MonikerWrapperItem __ 设定 ============-->
        <DataTemplate DataType="{x:Type monikers:MonikerWrapperItem}">
            <DockPanel>
                <ui:Iconify Icon="{StaticResource Moniker}"
                            IconSize="21"
                            IsFilled="True" />

                <ContentPresenter Content="{Binding Moniker, Mode=OneWay}"
                                  Margin="8 0 0 0" />
            </DockPanel>
        </DataTemplate>


        <!-- -->
        <!-- -->
        <!-- -->
        <!-- ============ MonikerFolder __ 设定目录 ============-->
        <HierarchicalDataTemplate DataType="{x:Type monikers:MonikerFolder}"
                                  ItemsSource="{Binding Items, Mode=OneWay}">
            <DockPanel Background="Transparent">
                <!-- <DockPanel.ContextMenu> -->
                <!--     <ui:ContextMenu> -->
                <!--         <MenuItem Header="添加" -->
                <!--                   Click="MenuItem_Add"/> -->
                <!--         <MenuItem Header="编辑" -->
                <!--                   Click="MenuItem_Edit"/> -->
                <!--         <Separator/> -->
                <!--         <MenuItem Header="删除" -->
                <!--                   Click="MenuItem_Remove" -->
                <!--                   CommandParameter="{Binding}"/> -->
                <!--     </ui:ContextMenu> -->
                <!-- </DockPanel.ContextMenu> -->
                <ui:Iconify Foreground="#FFAB12"
                            Icon="{StaticResource FeatherIcon.Folder}"
                            IconSize="21" />

                <TextBlock Margin="8 0 0 0"
                           Text="{Binding Name, Mode=OneWay}"
                           VerticalAlignment="Center" />
            </DockPanel>
        </HierarchicalDataTemplate>

        <!-- -->
        <!-- -->
        <!-- -->
        <!-- ============ Trimmed __ 设定目录 ============-->
        <DataTemplate DataType="{x:Type monikers:TrimmedMonikerWorkspaceItem}">
            <TextBlock Foreground="{DynamicResource Brush.Foreground.Level2}"
                       Margin="8 0 0 0"
                       Text="{Binding Count, Mode=OneWay, StringFormat={}显示剩余{0}个设定}"
                       VerticalAlignment="Center" />
        </DataTemplate>
    </UserControl.Resources>

    <!-- -->
    <!-- -->
    <!-- -->


    <!-- ============ 设定 ============-->
    <ui:TreeView Grid.Row="1"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.CacheLengthUnit="Pixel"
                 ItemsSource="{Binding Moniker.Items, Mode=OneWay}"
                 MouseDoubleClick="TreeView_DoubleClick"
                 SelectedItemChanged="TreeView_SelectedItemChanged"
                 Margin="0 8">
    </ui:TreeView>
</UserControl>