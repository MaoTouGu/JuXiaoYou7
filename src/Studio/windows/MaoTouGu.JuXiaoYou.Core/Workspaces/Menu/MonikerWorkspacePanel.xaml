<UserControl x:Class="MaoTouGu.JuXiaoYou.Workspaces.MonikerWorkspacePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="urn:KinonekoSoftware/ui"
             xmlns:dock="https://github.com/Dirkster99/AvalonDock"
             xmlns:this="clr-namespace:MaoTouGu.JuXiaoYou.Workspaces"
             xmlns:thisVM="clr-namespace:MaoTouGu.JuXiaoYou.Workspaces"
             xmlns:workspace="clr-namespace:MaoTouGu.JuXiaoYou.Workspaces.WorldView;assembly=MaoTouGu.JuXiaoYou.Workspaces"
             xmlns:monikers="clr-namespace:MaoTouGu.JuXiaoYou.Visualizers.Pages;assembly=MaoTouGu.JuXiaoYou.Workspaces"
             mc:Ignorable="d"
             d:DesignWidth="800" d:DesignHeight="450"
             d:DataContext="{d:DesignInstance Type={x:Type thisVM:WorkspaceViewModel}, IsDesignTimeCreatable=True}">
    <UserControl.Resources>
        <!-- -->
        <!-- -->
        <!-- -->
