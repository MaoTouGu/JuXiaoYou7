<ForestDialog x:Class="MaoTouGu.JuXiaoYou.Indexing.IndexingOptionView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:ui="urn:KinonekoSoftware/ui"
              xmlns:this="clr-namespace:MaoTouGu.JuXiaoYou.Indexing"
              xmlns:thisVM="clr-namespace:MaoTouGu.JuXiaoYou.Indexing"
              mc:Ignorable="d"
              d:DesignWidth="800" d:DesignHeight="450"
              d:DataContext="{d:DesignInstance Type={x:Type thisVM:IndexingOptionViewModel}, IsDesignTimeCreatable=True}">
    <Border Background="{DynamicResource Brush.Background.Level3}"
            Padding="24"
            Height="420"
            Width="768">
        <DockPanel>
            <!-- ======== Ok/Cancel Button ======== -->
            <UniformGrid DockPanel.Dock="Bottom"
                         Columns="2"
                         Margin="0 0 0 16"
                         Height="36"
                         Width="400">
                <ui:MainButton ui:ControlAssist.CornerRadius="18"
                               Content="确定"
                               Command="{Binding CompleteCommand}"
                               FontSize="13"
                               Margin="0 0 4 0"
                               Style="{StaticResource MainButton.Base}" />

                <ui:GhostButton ui:ControlAssist.CornerRadius="18"
                                Content="取消"
                                Command="{Binding CancelCommand}"
                                FontSize="13"
                                Margin="4 0 0 0" />
            </UniformGrid>

            <!-- ======== Ok/Cancel Button ======== -->
            <ui:SinkTabControl TabStripPlacement="Left">
                <ui:SinkTabItem Header="常规参数">
                    <StackPanel>


                        <!-- ======== Ok/Cancel Button ======== -->
                        <ui:HeaderedSingleLine Header="名字"
                                               Margin="0 5" />

                        <!-- ======== AllowCatalogOperation ======== -->
                        <HeaderedContentControl Header="是否允许目录操作?"
                                                Margin="0 5"
                                                Style="{StaticResource PropertyItem}">
                            <ui:ToggleSwitch />
                        </HeaderedContentControl>

                    </StackPanel>
                </ui:SinkTabItem>

                <ui:SinkTabItem Header="进阶参数">
                    <StackPanel>


                        <!-- ======== Ok/Cancel Button ======== -->
                        <ui:HeaderedSingleLine Header="名字" />

                        <!-- ======== Ok/Cancel Button ======== -->
                        <UniformGrid Columns="2"
                                     Margin="0 10">
                            <HeaderedContentControl Header="世界"
                                                    Margin="4 0"
                                                    Style="{StaticResource SettingItem}">
                                <ui:ComboBox>

                                </ui:ComboBox>
                            </HeaderedContentControl>

                            <HeaderedContentControl Header="小世界"
                                                    Margin="4 0"
                                                    Style="{StaticResource SettingItem}">
                                <ui:ComboBox>

                                </ui:ComboBox>
                            </HeaderedContentControl>
                        </UniformGrid>
                    </StackPanel>
                </ui:SinkTabItem>

                <ui:SinkTabItem Header="数据来源">
                    <StackPanel>
                        <HeaderedContentControl Header="世界（Domain）"
                                                Margin="0 8"
                                                Style="{StaticResource SettingItem}">
                            <ui:ControlAssist.ToolBar>
                                <DockPanel>
                                    <TextBlock FontSize="13"
                                               Text="高级设置"
                                               VerticalAlignment="Center"/>
                                    <ui:ToggleSwitch IsChecked="{Binding EditDomainText, Mode=TwoWay}"
                                                     Margin="16 0 0 0"/>
                                </DockPanel>
                            </ui:ControlAssist.ToolBar>

                            <ui:EmptyStateView IsEmpty="{Binding EditDomainText, Mode=OneWay}">
                                <ui:EmptyStateView.EmptyState>
                                    <ui:SingleLine Text="{Binding Domain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=100}"/>
                                </ui:EmptyStateView.EmptyState>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top"
                                               Foreground="{DynamicResource Brush.Foreground.Level3}"
                                               Margin="0 0 0 8"
                                               Text="指定数据来源于哪个世界。"/>

                                    <ui:GhostButton DockPanel.Dock="Right"
                                                    ui:ControlAssist.Icon="{StaticResource FeatherIcon.Folder}"
                                                    Command="{Binding PickDomain}"
                                                    Margin="8 0 0 0"
                                                    IconMode="Icon"
                                                    Height="40"
                                                    Width="40"/>

                                    <ui:ComboBox ItemsSource="{Binding DomainCollection, Mode=OneWay}"
                                                 SelectedItem="{Binding DomainInstance, Mode=TwoWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name, Mode=OneWay}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ui:ComboBox>
                                </DockPanel>
                            </ui:EmptyStateView>
                        </HeaderedContentControl>

                        <TextBlock Text="{Binding InstanceID, Mode=OneWay}"/>
                    </StackPanel>
                </ui:SinkTabItem>
                <ui:SinkTabItem Header="命令参数">
                    <StackPanel>


                        <!-- ======== Ok/Cancel Button ======== -->
                        <ui:HeaderedSingleLine Header="名字" />

                        <!-- ======== Ok/Cancel Button ======== -->
                        <UniformGrid Columns="2"
                                     Margin="0 10">
                            <HeaderedContentControl Header="世界"
                                                    Margin="4 0"
                                                    Style="{StaticResource SettingItem}">
                                <ui:ComboBox>

                                </ui:ComboBox>
                            </HeaderedContentControl>

                            <HeaderedContentControl Header="小世界"
                                                    Margin="4 0"
                                                    Style="{StaticResource SettingItem}">
                                <ui:ComboBox>

                                </ui:ComboBox>
                            </HeaderedContentControl>
                        </UniformGrid>
                    </StackPanel>
                </ui:SinkTabItem>
            </ui:SinkTabControl>
        </DockPanel>
    </Border>
</ForestDialog>