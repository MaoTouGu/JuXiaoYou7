<UserControl x:Class="MaoTouGu.JuXiaoYou.Indexing.WithGravatarPresenter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="urn:KinonekoSoftware/ui"
             xmlns:this="clr-namespace:MaoTouGu.JuXiaoYou.Indexing"
             xmlns:thisVM="clr-namespace:MaoTouGu.JuXiaoYou.Indexing"
             xmlns:objects="clr-namespace:MaoTouGu.Studio.Database.Objects;assembly=MaoTouGu.Studio.Database"
             mc:Ignorable="d"
             d:DesignWidth="800" d:DesignHeight="450"
             d:DataContext="{d:DesignInstance Type={x:Type objects:Moniker}, IsDesignTimeCreatable=True}">
    <DockPanel Margin="8">
        <Border DockPanel.Dock="Top"
                ImageSystem.Source="{Binding Gravatar, Mode=OneWay}"
                ImageSystem.Fallback="Gravatar"
                Height="64"
                Width="64">
        </Border>

        <TextBlock Margin="0 8"
                   Text="{Binding FriendlyName, Mode=OneWay}"
                   TextAlignment="Center" />
    </DockPanel>
</UserControl>