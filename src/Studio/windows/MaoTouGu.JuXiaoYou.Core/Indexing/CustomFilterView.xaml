<ForestDialog x:Class="MaoTouGu.JuXiaoYou.Indexing.CustomFilterView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:ui="urn:KinonekoSoftware/ui"
              xmlns:this="clr-namespace:MaoTouGu.JuXiaoYou.Indexing"
              xmlns:filter="clr-namespace:MaoTouGu.Studio.Database.References;assembly=MaoTouGu.Studio.Database"
              xmlns:thisVM="clr-namespace:MaoTouGu.JuXiaoYou.Indexing"
              mc:Ignorable="d"
              d:DesignWidth="800" d:DesignHeight="450"
              d:DataContext="{d:DesignInstance Type={x:Type thisVM:CustomFilterViewModel}, IsDesignTimeCreatable=True}">
    <UserControl.Resources>

        <DataTemplate DataType="{x:Type filter:KeywordIntersectionFilter}">
            <StackPanel>
                <ui:HeaderedSingleLine Header="名字"
                                       Margin="0 0 0 16"
                                       Text="{Binding Name, Mode=TwoWay, Delay=100, UpdateSourceTrigger=PropertyChanged}" />


                <HeaderedContentControl Header="标签（交集）"
                                        Style="{StaticResource HeaderedContentControl.DecoratedStyle1}">
                    <ui:ControlAssist.ToolBar>
                        <ui:GhostButton ui:ControlAssist.Icon="{StaticResource FeatherIcon.PlusCircle}"
                                        Click="Button_Add"
                                        IconMode="Icon"
                                        Height="36"
                                        Width="36" />
                    </ui:ControlAssist.ToolBar>

                    <ItemsControl ItemsSource="{Binding Keywords}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#20808000"
                                        BorderBrush="Olive"
                                        BorderThickness="1"
                                        CornerRadius="0"
                                        Margin="0 0 8 8"
                                        Padding="8 4"
                                        MinWidth="100">
                                    <DockPanel>
                                        <CloseButton DockPanel.Dock="Right" 
                                                     Click="Button_Remove"/>
                                        <TextBlock Text="{Binding}"
                                                   TextAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </HeaderedContentControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type filter:SettingEQFilter}">
            <HeaderedContentControl Header="文本筛选（全等)"
                                    Style="{StaticResource HeaderedContentControl.DecoratedStyle1}">
                <StackPanel>
                    <ui:HeaderedSingleLine Header="名字"
                                           Margin="0 0 0 16"
                                           Text="{Binding Name, Mode=TwoWay, Delay=100, UpdateSourceTrigger=PropertyChanged}" />

                    <ui:HeaderedSingleLine Header="喵喵咒语"
                                           Margin="0 0 0 16"
                                           Text="{Binding Key, Mode=TwoWay, Delay=100, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </HeaderedContentControl>
        </DataTemplate>


        <DataTemplate DataType="{x:Type filter:SettingContainsFilter}">
            <HeaderedContentControl Header="文本筛选（包含)"
                                    Style="{StaticResource HeaderedContentControl.DecoratedStyle1}">
                <StackPanel>
                    <ui:HeaderedSingleLine Header="名字"
                                           Margin="0 0 0 16"
                                           Text="{Binding Name, Mode=TwoWay, Delay=100, UpdateSourceTrigger=PropertyChanged}" />

                    <ui:HeaderedSingleLine Header="喵喵咒语"
                                           Margin="0 0 0 16"
                                           Text="{Binding Key, Mode=TwoWay, Delay=100, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </HeaderedContentControl>
        </DataTemplate>


        <DataTemplate DataType="{x:Type filter:SettingRangeFilter}">
            <HeaderedContentControl Header="数值筛选（范围）"
                                    Style="{StaticResource HeaderedContentControl.DecoratedStyle1}">
                <StackPanel>
                    <ui:HeaderedSingleLine Header="名字"
                                           Margin="0 0 0 16"
                                           Text="{Binding Name, Mode=TwoWay, Delay=100, UpdateSourceTrigger=PropertyChanged}" />

                    <ui:HeaderedSingleLine Header="喵喵咒语"
                                           Margin="0 0 0 16"
                                           Text="{Binding Key, Mode=TwoWay, Delay=100, UpdateSourceTrigger=PropertyChanged}" />

                    <ui:HeaderedSingleLine Header="起始范围"
                                           Margin="0 0 0 16"
                                           Text="{Binding Start, Mode=TwoWay, Delay=100, UpdateSourceTrigger=PropertyChanged}" />

                    <ui:HeaderedSingleLine Header="结束范围"
                                           Margin="0 0 0 16"
                                           Text="{Binding End, Mode=TwoWay, Delay=100, UpdateSourceTrigger=PropertyChanged}" />

                    <ui:CheckBox Content="判断不在此范围"
                                 IsChecked="{Binding IsReverse, Mode=TwoWay}"
                                 Margin="0 0 0 16" />
                </StackPanel>
            </HeaderedContentControl>
        </DataTemplate>


        <DataTemplate DataType="{x:Type filter:SettingGTFilter}">
            <HeaderedContentControl Header="数值筛选（＞）"
                                    Style="{StaticResource HeaderedContentControl.DecoratedStyle1}">
                <StackPanel>
                    <ui:HeaderedSingleLine Header="名字"
                                           Margin="0 0 0 16"
                                           Text="{Binding Name, Mode=TwoWay, Delay=100, UpdateSourceTrigger=PropertyChanged}" />

                    <ui:HeaderedSingleLine Header="喵喵咒语"
                                           Margin="0 0 0 16"
                                           Text="{Binding Key, Mode=TwoWay, Delay=100, UpdateSourceTrigger=PropertyChanged}" />

                    <ui:HeaderedSingleLine Header="值"
                                           Margin="0 0 0 16"
                                           Text="{Binding Value, Mode=TwoWay, Delay=100, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </HeaderedContentControl>
        </DataTemplate>


        <DataTemplate DataType="{x:Type filter:SettingGTEFilter}">
            <HeaderedContentControl Header="数值筛选（≥）"
                                    Style="{StaticResource HeaderedContentControl.DecoratedStyle1}">
                <StackPanel>
                    <ui:HeaderedSingleLine Header="名字"
                                           Margin="0 0 0 16"
                                           Text="{Binding Name, Mode=TwoWay, Delay=100, UpdateSourceTrigger=PropertyChanged}" />

                    <ui:HeaderedSingleLine Header="喵喵咒语"
                                           Margin="0 0 0 16"
                                           Text="{Binding Key, Mode=TwoWay, Delay=100, UpdateSourceTrigger=PropertyChanged}" />

                    <ui:HeaderedSingleLine Header="值"
                                           Margin="0 0 0 16"
                                           Text="{Binding Value, Mode=TwoWay, Delay=100, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </HeaderedContentControl>
        </DataTemplate>

        <DataTemplate DataType="{x:Type filter:SettingLTFilter}">
            <HeaderedContentControl Header="数值筛选（＜）"
                                    Style="{StaticResource HeaderedContentControl.DecoratedStyle1}">
                <StackPanel>
                    <ui:HeaderedSingleLine Header="名字"
                                           Margin="0 0 0 16"
                                           Text="{Binding Name, Mode=TwoWay, Delay=100, UpdateSourceTrigger=PropertyChanged}" />

                    <ui:HeaderedSingleLine Header="喵喵咒语"
                                           Margin="0 0 0 16"
                                           Text="{Binding Key, Mode=TwoWay, Delay=100, UpdateSourceTrigger=PropertyChanged}" />

                    <ui:HeaderedSingleLine Header="值"
                                           Margin="0 0 0 16"
                                           Text="{Binding Value, Mode=TwoWay, Delay=100, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </HeaderedContentControl>
        </DataTemplate>

        <DataTemplate DataType="{x:Type filter:SettingLTEFilter}">
            <HeaderedContentControl Header="数值筛选（≤）"
                                    Style="{StaticResource HeaderedContentControl.DecoratedStyle1}">
                <StackPanel>
                    <ui:HeaderedSingleLine Header="名字"
                                           Margin="0 0 0 16"
                                           Text="{Binding Name, Mode=TwoWay, Delay=100, UpdateSourceTrigger=PropertyChanged}" />

                    <ui:HeaderedSingleLine Header="喵喵咒语"
                                           Margin="0 0 0 16"
                                           Text="{Binding Key, Mode=TwoWay, Delay=100, UpdateSourceTrigger=PropertyChanged}" />

                    <ui:HeaderedSingleLine Header="值"
                                           Margin="0 0 0 16"
                                           Text="{Binding Value, Mode=TwoWay, Delay=100, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </HeaderedContentControl>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{DynamicResource Brush.Background.Level3}"
            CornerRadius="8"
            Padding="32 16"
            Height="480"
            Width="480">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0 16 0 0"
                       Text="选择"
                       TextAlignment="Center" />

            <!-- ModuleType List -->
            <ContentControl x:Name="Items"
                            Grid.Row="1"
                            Background="Transparent"
                            Margin="0 12"
                            Content="{Binding Filter}">
            </ContentControl>

            <!-- Ok/Cancel Button -->
            <UniformGrid Grid.Row="2"
                         Columns="2"
                         Height="36">
                <ui:MainButton ui:ControlAssist.CornerRadius="18"
                               Content="确定"
                               Command="{Binding CompleteCommand}"
                               FontSize="13"
                               Margin="0 0 4 0"
                               Style="{StaticResource MainButton.Base}" />

                <ui:GhostButton ui:ControlAssist.CornerRadius="18"
                                Content="取消"
                                Command="{Binding CancelCommand}"
                                FontSize="13"
                                Margin="4 0 0 0" />
            </UniformGrid>
        </Grid>
    </Border>
</ForestDialog>