<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="urn:KinonekoSoftware/ui"
                    xmlns:ux="urn:KinonekoSoftware/ux"
                    xmlns:this="clr-namespace:MaoTouGu.JuXiaoYou.Services.CFE">
    
    <!-- CFSingleLineElement -->
    <DataTemplate DataType="{x:Type this:CFSingleLineElement}">
        <Grid Margin="0 0 0 8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition SharedSizeGroup="Title" MinWidth="100"/>
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding Name, Mode=OneWay, StringFormat={}{0}:}"
                       TextAlignment="Right"
                       VerticalAlignment="Center" />

            <ui:SingleLine Grid.Column="2"
                           CornerRadius="0"
                           Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=50}" />
        </Grid>
    </DataTemplate>
    
    <!-- CFMultiLineElement -->
    <DataTemplate DataType="{x:Type this:CFMultiLineElement}">
        <Grid Margin="0 0 0 8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition SharedSizeGroup="Title" MinWidth="100"/>
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <TextBlock Margin="0 8 0 0"
                       Text="{Binding Name, Mode=OneWay, StringFormat={}{0}:}"
                       TextAlignment="Right"
                       VerticalAlignment="Center" />

            <ui:MultiLine Grid.Column="2"
                          CornerRadius="0"
                          Height="100"
                          Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=50}" />
        </Grid>
    </DataTemplate>
    
    <!-- CFComboBoxElement -->
    <DataTemplate DataType="{x:Type this:CFComboBoxElement}">
        <Grid ShowGridLines="False"
              Margin="0 0 0 8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition SharedSizeGroup="Title" MinWidth="100"/>
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding Name, Mode=OneWay, StringFormat={}{0}:}"
                       TextAlignment="Right"
                       VerticalAlignment="Center" />

            <ui:ComboBox x:Name="List"
                         Grid.Column="2"
                         Background="{DynamicResource Brush.Background.Level2}"
                         BorderThickness="0"
                         Height="36" 
                         ItemsSource="{Binding ItemsSource, Mode=OneWay}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"/>
        </Grid>
    </DataTemplate> 
    
    <!-- CFColorElement -->
    <DataTemplate DataType="{x:Type this:CFColorElement}">
        <Grid Margin="0 0 0 8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition SharedSizeGroup="Title" MinWidth="100"/>
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding Name, Mode=OneWay, StringFormat={}{0}:}"
                       TextAlignment="Right"
                       VerticalAlignment="Center" />

            <ux:PortableColorPicker Grid.Column="2"
                                    HorizontalAlignment="Left"
                                    Height="32"
                                    Width="32"
                                    SelectedColor="{Binding Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=50}" />
        </Grid>
    </DataTemplate>
    
    <!-- CFPasswordElement -->
    <DataTemplate DataType="{x:Type this:CFPasswordElement}">
        <Grid Margin="0 0 0 8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition SharedSizeGroup="Title" MinWidth="100"/>
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding Name, Mode=OneWay, StringFormat={}{0}:}"
                       TextAlignment="Right"
                       VerticalAlignment="Center" />

            <PasswordBox Grid.Column="2"
                         Background="{DynamicResource Brush.Background.Level2}"
                         BorderThickness="0"
                         Height="32"
                         Padding="8 0 0 0"
                         VerticalContentAlignment="Center" />
        </Grid>
    </DataTemplate>
    
    <!-- CFToggleSwitchElement -->
    <DataTemplate DataType="{x:Type this:CFToggleSwitchElement}">
        <Grid ShowGridLines="False"
              Margin="0 0 0 8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition SharedSizeGroup="Title" MinWidth="100"/>
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>


            <TextBlock Text="{Binding Name, Mode=OneWay, StringFormat={}{0}:}"
                       TextAlignment="Right"
                       VerticalAlignment="Center" />
            <ui:ToggleSwitch Grid.Column="2"
                             HorizontalAlignment="Left"
                             HorizontalContentAlignment="Left"
                             BorderThickness="0" />
        </Grid>
    </DataTemplate>
        
    <!-- CFCheckBoxElement -->
    <DataTemplate DataType="{x:Type this:CFCheckBoxElement}">
        <Grid ShowGridLines="False"
              Margin="0 0 0 8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition SharedSizeGroup="Title" MinWidth="100"/>
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>


            <ui:CheckBox Grid.Column="2"
                         Content="{Binding Name, Mode=OneWay, StringFormat={}{0}:}"
                         HorizontalContentAlignment="Left"
                         BorderThickness="0"
                         Height="36" />
        </Grid>
    </DataTemplate>
    
    <!-- CFCheckBoxElement -->
    <DataTemplate DataType="{x:Type this:CFUploadElement}">
        <Grid ShowGridLines="False"
              Margin="0 0 0 8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition SharedSizeGroup="Title" MinWidth="100"/>
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding Name, Mode=OneWay, StringFormat={}{0}:}"
                       TextAlignment="Right"
                       VerticalAlignment="Center" />

            <ui:SingleLine Grid.Column="2"
                           CornerRadius="0"
                           Text="{Binding Value, Mode=TwoWay}"/>

            <ui:GhostButton Grid.Column="3"
                            ui:ControlAssist.Icon="{StaticResource FeatherIcon.Folder}"
                            Command="{Binding Pick}"
                            IconMode="Icon"/>
        </Grid>
    </DataTemplate>
    
    <!-- CFStringObjectElement -->
    <DataTemplate DataType="{x:Type this:CFStringObjectElement}">
        <Grid ShowGridLines="False"
              Margin="0 0 0 8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition SharedSizeGroup="Title" MinWidth="100"/>
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding Name, Mode=OneWay, StringFormat={}{0}:}"
                       TextAlignment="Right"
                       VerticalAlignment="Center" />

            <ui:SingleLine Grid.Column="2"
                           CornerRadius="0"
                           Text="{Binding Value, Mode=TwoWay}"/>

            <ui:GhostButton Grid.Column="3"
                            ui:ControlAssist.Icon="{StaticResource FeatherIcon.Folder}"
                            Command="{Binding Open}"
                            IconMode="Icon"/>
        </Grid>
    </DataTemplate>
    
    
</ResourceDictionary>