<ForestDialog x:Class="MaoTouGu.JuXiaoYou.Services.CFE.CompositableFormDrawer"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:ui="urn:KinonekoSoftware/ui"
              xmlns:this="clr-namespace:MaoTouGu.JuXiaoYou.Services.CFE"
              xmlns:thisVM="clr-namespace:MaoTouGu.JuXiaoYou.Services.CFE"
              mc:Ignorable="d"
              d:DesignWidth="800" d:DesignHeight="450"
              d:DataContext="{d:DesignInstance Type={x:Type thisVM:CompositableFormDrawerRoot}, IsDesignTimeCreatable=True}"
              Background="{DynamicResource Brush.Background.Level4}"
              Padding="16"
              Width="480">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>

        <ui:MainButton DockPanel.Dock="Bottom"
                       Content="完成"
                       Command="{Binding Finish}" />

        <ui:GhostButton DockPanel.Dock="Bottom"
                        Content="取消"
                        Command="{Binding Cancel}" />

        <HeaderedContentControl Header="编辑"
                                Style="{StaticResource SettingItem}">
            <ItemsControl Grid.IsSharedSizeScope="True"
                          ItemsSource="{Binding Collection}">

            </ItemsControl>
        </HeaderedContentControl>
    </DockPanel>
</ForestDialog>