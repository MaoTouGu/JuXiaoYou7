            <Style x:Key="HeaderedContentControl.DecoratedStyle1" TargetType="HeaderedContentControl">
                <Setter Property="ui:ControlAssist.CornerRadius" Value="0 0 0 0" />
                <Setter Property="ui:ControlAssist.FontSize" Value="15" />
                <Setter Property="ui:ControlAssist.IconMargin" Value="8 4" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.HighlightA4}" />
                <Setter Property="BorderThickness" Value="0 0 0 2" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="HeaderedContentControl">
                            <DockPanel Background="Transparent">

                                <Border DockPanel.Dock="Top"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">

                                    <DockPanel>
                                        <ContentPresenter DockPanel.Dock="Right"
                                                          TextElement.FontSize="{TemplateBinding ui:ControlAssist.FontSize}"
                                                          Content="{TemplateBinding ui:ControlAssist.ToolBar}"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                          MinWidth="32" />

                                        <Border DockPanel.Dock="Left"
                                                Background="{TemplateBinding BorderBrush}"
                                                CornerRadius="{TemplateBinding ui:ControlAssist.CornerRadius}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Bottom"
                                                Padding="{TemplateBinding ui:ControlAssist.IconMargin}">
                                            <ContentPresenter TextElement.FontSize="{TemplateBinding ui:ControlAssist.FontSize}"
