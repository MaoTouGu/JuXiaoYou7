            <Style x:Key="TabControl.Strike.Icon" TargetType="{x:Type ui:StrikeTabControl}">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="8 0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ui:StrikeTabControl}">
                            <DockPanel KeyboardNavigation.TabNavigation="Local">
                                <Border x:Name="TabPanel"
                                    BorderBrush="{DynamicResource Brush.Foreground.Level1}"
                                    Padding="0 8"
                                    HorizontalAlignment="Center" >
                                    <TabPanel x:Name="HeaderPanel"
                                          Panel.ZIndex="1"
                                          IsItemsHost="True"
                                          KeyboardNavigation.TabIndex="1"
                                          Background="Transparent"/>
                                </Border>

                                <Border x:Name="Border"
                                    Grid.Row="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    KeyboardNavigation.TabNavigation="Local"
                                    KeyboardNavigation.DirectionalNavigation="Contained"
                                    KeyboardNavigation.TabIndex="2"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Padding="{TemplateBinding Padding}">
                                    <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  TextElement.FontSize="{TemplateBinding FontSize}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  ContentSource="SelectedContent"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch" />
                                </Border>
                            </DockPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="TabStripPlacement" Value="Left">
                                    <Setter Property="DockPanel.Dock" Value="Left" TargetName="TabPanel" />
                                </Trigger>

                                <Trigger Property="TabStripPlacement" Value="Right">
                                    <Setter Property="DockPanel.Dock" Value="Right" TargetName="TabPanel" />
                                </Trigger>

                                <Trigger Property="TabStripPlacement" Value="Top">
                                    <Setter Property="DockPanel.Dock" Value="Top" TargetName="TabPanel" />
                                </Trigger>


                                <Trigger Property="TabStripPlacement" Value="Bottom">
                                    <Setter Property="DockPanel.Dock" Value="Bottom" TargetName="TabPanel" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

