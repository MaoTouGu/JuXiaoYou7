                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Level1}" />
                <Setter Property="BorderThickness" Value="4 0 0 0" />
                <Setter Property="ui:ControlAssist.Icon" Value="{StaticResource FeatherIcon.PlusCircle}" />
                <Setter Property="ui:ControlAssist.IconSize" Value="24" />
                <Setter Property="ui:ControlAssist.FontSize" Value="13" />
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="MinWidth" Value="48" />
                <Setter Property="Padding" Value="4 4" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ui:StrikeTabItem}">
                            <Border x:Name="PART_Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                Padding="6 0"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                                <ui:Iconify x:Name="PART_Icon"
                                            TextElement.FontSize="{TemplateBinding ui:ControlAssist.FontSize}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Icon="{TemplateBinding ui:ControlAssist.Icon}"
                                            IconSize="{TemplateBinding ui:ControlAssist.IconSize}"
                                        StrokeThickness="1"
                                            IsFilled="{TemplateBinding ui:ControlAssist.IsFilled}"
                                            Focusable="False"
                                            Margin="0 0 0 0"
                                            Height="{TemplateBinding ui:ControlAssist.IconSize}"
                                            Width="{TemplateBinding ui:ControlAssist.IconSize}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="IsSelected" Value="False" />
                                    </MultiTrigger.Conditions>
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.HighlightB1}" TargetName="PART_Icon" />
                                </MultiTrigger>

                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#10FFFFFF" TargetName="PART_Border" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.HighlightB3}" TargetName="PART_Border" />
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.HighlightB3}" TargetName="PART_Icon" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Foreground.Disabled}" TargetName="PART_Icon" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SettingItem" TargetType="HeaderedContentControl">
                <Setter Property="ui:ControlAssist.FontSize" Value="15" />
                <Setter Property="ui:ControlAssist.IconMargin" Value="8 4" />
                <Setter Property="ui:ControlAssist.ToolBar" Value="{x:Null}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                <Setter Property="BorderThickness" Value="0 0 0 1" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="HeaderedContentControl">
                            <DockPanel>

                                <Border DockPanel.Dock="Top"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding ui:ControlAssist.IconMargin}">

                                    <DockPanel MinHeight="32">
                                        <ContentPresenter DockPanel.Dock="Right"
                                                          TextElement.FontSize="{TemplateBinding ui:ControlAssist.FontSize}"
                                                          Content="{TemplateBinding ui:ControlAssist.ToolBar}"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                          MinWidth="32" />

                                        <ContentPresenter TextElement.FontSize="{TemplateBinding ui:ControlAssist.FontSize}"
                                                          Content="{TemplateBinding Header}"
                                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                          ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                                                          ContentStringFormat="{TemplateBinding HeaderStringFormat}"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Center"
                                                          MinWidth="64" />

                                    </DockPanel>
                                </Border>

                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                  Margin="0 10 0 0"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

                            </DockPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ListBoxItem.Outline" TargetType="{x:Type ui:ListBoxItem}">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Level1}" />
                <Setter Property="Background" Value="{DynamicResource Brush.Background.Level3}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="ui:ControlAssist.CornerRadius" Value="3" />
                <Setter Property="Margin" Value="0 4" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ui:ListBoxItem}">
                            <Border x:Name="PART_Border"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    BorderBrush="Transparent"
                                    CornerRadius="{TemplateBinding ui:ControlAssist.CornerRadius}">
                                <ContentPresenter x:Name="PART_Content"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="IsSelected" Value="False" />
                                    </MultiTrigger.Conditions>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Overlay100}" TargetName="PART_Border" />
                                </MultiTrigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.HighlightB4}" TargetName="PART_Border" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Foreground.Disabled}" TargetName="PART_Content" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.HighlightC1}" TargetName="PART_Border" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</MTGApplication>