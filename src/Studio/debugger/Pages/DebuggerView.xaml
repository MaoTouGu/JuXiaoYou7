<ForestPage x:Class="MaoTouGu.JuXiaoYou.Pages.DebuggerView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:ui="urn:KinonekoSoftware/ui"
            xmlns:this="clr-namespace:MaoTouGu.JuXiaoYou.Pages"
            xmlns:thisVM="clr-namespace:MaoTouGu.JuXiaoYou.Pages"
            mc:Ignorable="d"
            d:DesignWidth="800" d:DesignHeight="450"
            d:DataContext="{d:DesignInstance Type={x:Type thisVM:DebuggerViewModel}, IsDesignTimeCreatable=True}"
            Padding="16">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type this:DebuggerDocument}">
            <StackPanel Margin="8 4">


                <TextBlock DockPanel.Dock="Left"
                           FontSize="24"
                           Margin="0 0 0 4"
                           Text="{Binding Name, Mode=OneWay}" />

                <TextBlock DockPanel.Dock="Bottom"
                           FontSize="12"
                           FontFamily="{StaticResource SongTi}"
                           Foreground="{DynamicResource Brush.Foreground.Level2}"
                           Text="{Binding Id, Mode=OneWay}"
                           TextAlignment="Right" />

                <TextBlock DockPanel.Dock="Left"
                           FontSize="12"
                           Foreground="{DynamicResource Brush.HighlightB3}"
                           Text="{Binding TypeName, Mode=OneWay}"
                           TextAlignment="Right"
                           TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type this:StringDebuggerProperty}">
            <DockPanel Margin="8 4">
                <TextBlock DockPanel.Dock="Left"
                           FontSize="13"
                           FontFamily="{StaticResource SongTi}"
                           Text="{Binding Key, Mode=OneWay}" />

                <TextBlock DockPanel.Dock="Left"
                           FontSize="13"
                           Foreground="{DynamicResource Brush.Foreground.Level2}"
                           Margin="8 0 0 0"
                           Text="{Binding Value, Mode=OneWay}"
                           VerticalAlignment="Center" />

            </DockPanel>
        </DataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type this:NestedDebuggerProperty}"
                                  ItemsSource="{Binding Properties}">

            <TextBlock DockPanel.Dock="Left"
                           FontSize="13"
                           FontFamily="{StaticResource SongTi}"
                       Margin="8 4"
                           Text="{Binding Key, Mode=OneWay}" />
        </HierarchicalDataTemplate>
        <Style TargetType="{x:Type ui:ListBoxItem}" BasedOn="{StaticResource ListBoxItem.Outline}">

        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="9*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="320"/>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       FontFamily="{StaticResource HeiTi}"
                       FontSize="32"
                       Margin="0 0 0 8"
                       Text="{Binding CollectionName}" />

            <TextBlock Grid.Row="1"
                       FontFamily="{StaticResource SongTi}"
                       FontSize="13"
                       Foreground="{DynamicResource Brush.Foreground.Level2}"
                       Margin="0 0 0 16"
                       Text="{Binding Documents.Count, StringFormat={}共{0}个文档}" />

            <HeaderedContentControl Grid.Column="0"
                                    Grid.Row="2"
                                    Header="文档"
                                    Margin="0 0 8 0"
                                    Style="{StaticResource HeaderedContentControl.DecoratedStyle1}">
                <ui:ControlAssist.ToolBar>
                    <StackPanel Orientation="Horizontal">
                        <ui:GhostButton ui:ControlAssist.Icon="{StaticResource FeatherIcon.Trash}"
                                        Content="删除文档"
                                        HorizontalContentAlignment="Left"
                                        IconMode="Both"
                                        Padding="8 6" />
                    </StackPanel>
                </ui:ControlAssist.ToolBar>
                <ui:ListBox ItemsSource="{Binding Documents}"
                            SelectedItem="{Binding Document, Mode=TwoWay}"
                            Width="320">

                </ui:ListBox>
            </HeaderedContentControl>

            <HeaderedContentControl Grid.Column="1"
                                    Grid.Row="2"
                                    Header="属性"
                                    Margin="8 0"
                                    Style="{StaticResource HeaderedContentControl.DecoratedStyle1}">

                <ui:TreeView Margin="16 0 0 0"
                            ItemsSource="{Binding Properties, Mode=OneWay}">

                </ui:TreeView>
            </HeaderedContentControl>

            <ui:SinkTabControl Grid.Column="2"
                               Grid.Row="2"
                               Margin="8 0">
                <ui:SinkTabItem Header="文档操作">
                    <StackPanel>

                        <Separator Margin="0 16" />
                        <ui:GhostButton ui:ControlAssist.Icon="{StaticResource FeatherIcon.Trash}"
                                        Content="删除单个文档"
                                        HorizontalContentAlignment="Left"
                                        IconMode="Both"
                                        Padding="8 6" />
                        <ui:GhostButton ui:ControlAssist.Icon="{StaticResource FeatherIcon.Trash}"
                                        Content="删除多个文档"
                                        HorizontalContentAlignment="Left"
                                        IconMode="Both"
                                        Padding="8 6" />
                        <ui:GhostButton ui:ControlAssist.Icon="{StaticResource FeatherIcon.Trash}"
                                        Content="删除ID为空的文档"
                                        HorizontalContentAlignment="Left"
                                        IconMode="Both"
                                        Padding="8 6" />

                        <ui:GhostButton ui:ControlAssist.Icon="{StaticResource FeatherIcon.Trash}"
                                        Content="条件删除"
                                        HorizontalContentAlignment="Left"
                                        IconMode="Both"
                                        Padding="8 6" />
                    </StackPanel>
                </ui:SinkTabItem>
                <ui:SinkTabItem Header="属性操作">
                    <StackPanel>
                        <ui:GhostButton ui:ControlAssist.Icon="{StaticResource FeatherIcon.Tools}"
                                        Content="补全ID"
                                        HorizontalContentAlignment="Left"
                                        IconMode="Both"
                                        Padding="8 6" />
                        <ui:GhostButton ui:ControlAssist.Icon="{StaticResource FeatherIcon.Tools}"
                                        Content="_type修改"
                                        HorizontalContentAlignment="Left"
                                        IconMode="Both"
                                        Padding="8 6" />

                        <Separator Margin="0 16" />
                        <ui:GhostButton ui:ControlAssist.Icon="{StaticResource FeatherIcon.Trash}"
                                        Content="删除某个属性"
                                        HorizontalContentAlignment="Left"
                                        IconMode="Both"
                                        Padding="8 6" />
                    </StackPanel>
                </ui:SinkTabItem>
            </ui:SinkTabControl>
        </Grid>
    </Grid>
</ForestPage>