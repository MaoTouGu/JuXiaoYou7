<ForestPage x:Class="MaoTouGu.JuXiaoYou.Pages.LauncherView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:ui="urn:KinonekoSoftware/ui"
            xmlns:this="clr-namespace:MaoTouGu.JuXiaoYou.Pages"
            xmlns:thisVM="clr-namespace:MaoTouGu.JuXiaoYou.Pages"
            mc:Ignorable="d"
            d:DesignWidth="800" d:DesignHeight="450"
            d:DataContext="{d:DesignInstance Type={x:Type thisVM:LauncherViewModel}, IsDesignTimeCreatable=True}"
            Padding="16">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="7*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <HeaderedContentControl Grid.Column="1"
                                ui:ControlAssist.FontSize="31"
                                Header="最近修改"
                                Style="{StaticResource SettingItem}">
            <DockPanel>
                <ItemsControl>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="84"
                                  Margin="0 0 0 8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>

                                <ui:GhostButton Grid.Column="0"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top"
                                                   FontFamily="{StaticResource HeiTi}"
                                                   FontSize="24"
                                                   Text="标题"
                                                   Margin="0 8"/>
                                        <TextBlock FontFamily="{StaticResource SongTi}"
                                                   Foreground="{DynamicResource Brush.Foreground.Level2}"
                                                   FontSize="12"
                                                   Text="E:\Github\WPF-Samples\Drag and Drop\DragDropThumbOps"/>
                                    </DockPanel>
                                </ui:GhostButton>


                                <ui:GhostButton Grid.Column="1"
                                                ui:ControlAssist.CornerRadius="0"
                                                ui:ControlAssist.Icon="{StaticResource FeatherIcon.Trash}"
                                                ui:ControlAssist.IconSize="31"
                                                ui:ControlAssist.IconDock="Top"
                                                ui:ControlAssist.IconMargin="0 8"
                                                Content="删除页面"
                                                Foreground="{DynamicResource Brush.Error400}"
                                                IconMode="Both"
                                                Height="84"
                                                Width="84"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                    <Thickness />
                    <Thickness />
                    <Thickness />
                </ItemsControl>
            </DockPanel>
        </HeaderedContentControl>
    </Grid>
</ForestPage>