<ForestPage x:Class="MaoTouGu.JuXiaoYou.Pages.LauncherView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:ui="urn:KinonekoSoftware/ui"
            xmlns:this="clr-namespace:MaoTouGu.JuXiaoYou.Pages"
            xmlns:thisVM="clr-namespace:MaoTouGu.JuXiaoYou.Pages"
            mc:Ignorable="d"
            d:DesignWidth="800" d:DesignHeight="450"
            d:DataContext="{d:DesignInstance Type={x:Type thisVM:LauncherViewModel}, IsDesignTimeCreatable=True}"
            Padding="16">
    <UserControl.Resources>
        <BindingProxy x:Key="ViewModel" ViewModel="{Binding}"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="7*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <HeaderedContentControl Grid.Column="1"
                                ui:ControlAssist.FontSize="31"
                                Header="最近修改"
                                Style="{StaticResource SettingItem}">
            <ui:ControlAssist.ToolBar>
                <StackPanel Orientation="Horizontal">
                    
                    <ui:GhostButton ui:ControlAssist.CornerRadius="0"
                                    ui:ControlAssist.Icon="{StaticResource FeatherIcon.PlusCircle}"
                                    Command="{Binding Create}"
                                    IconMode="Icon"
                                    Padding="0"
                                    Height="32"
                                    Width="32" />
                    
                    <ui:GhostButton ui:ControlAssist.CornerRadius="0"
                                    ui:ControlAssist.Icon="{StaticResource FeatherIcon.Folder}"
                                    Command="{Binding Load}"
                                    IconMode="Icon"
                                    Padding="0"
                                    Height="32"
                                    Width="32" />
                </StackPanel>
            </ui:ControlAssist.ToolBar>
            <ItemsControl ItemsSource="{Binding Projects, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type thisVM:TemplateProject}">
                        <Grid Height="84"
                              Margin="0 0 0 8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>

                            <ui:GhostButton Grid.Column="0"
                                            Command="{Binding Source={StaticResource ViewModel}, Path=ViewModel.Open}"
                                            CommandParameter="{Binding}"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top"
                                               FontFamily="{StaticResource HeiTi}"
                                               FontSize="24"
                                               Text="{Binding Name, Mode=OneWay}" 
                                               Margin="0 8" />
                                    
                                    <TextBlock FontFamily="{StaticResource SongTi}"
                                               Foreground="{DynamicResource Brush.Foreground.Level2}"
                                               FontSize="12"
                                               Text="{Binding FileName, Mode=OneWay}" />
                                </DockPanel>
                            </ui:GhostButton>


                            <ui:GhostButton Grid.Column="1"
                                            ui:ControlAssist.CornerRadius="0"
                                            ui:ControlAssist.Icon="{StaticResource FeatherIcon.Trash}"
                                            ui:ControlAssist.IconSize="31"
                                            ui:ControlAssist.IconDock="Top"
                                            ui:ControlAssist.IconMargin="0 8"
                                            Content="删除页面"
                                            Command="{Binding Source={StaticResource ViewModel}, Path=ViewModel.Remove}"
                                            CommandParameter="{Binding}"
                                            Foreground="{DynamicResource Brush.Error400}"
                                            IconMode="Both"
                                            Height="84"
                                            Width="84" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </HeaderedContentControl>
    </Grid>
</ForestPage>