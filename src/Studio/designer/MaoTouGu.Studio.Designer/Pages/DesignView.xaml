<ForestPage x:Class="MaoTouGu.JuXiaoYou.Pages.DesignView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:ui="urn:KinonekoSoftware/ui"
            xmlns:this="clr-namespace:MaoTouGu.JuXiaoYou.Pages"
            xmlns:thisControls="clr-namespace:MaoTouGu.JuXiaoYou.Controls"
            xmlns:thisConverters="clr-namespace:MaoTouGu.JuXiaoYou.Converters"
            xmlns:thisVM="clr-namespace:MaoTouGu.JuXiaoYou.Pages"
            xmlns:topology="clr-namespace:MaoTouGu.Studio.Database.Topology;assembly=MaoTouGu.Studio.Database"
            xmlns:visualizers="clr-namespace:MaoTouGu.JuXiaoYou.Visualizers.Core;assembly=MaoTouGu.JuXiaoYou.Domain.Visualizers"
            mc:Ignorable="d"
            d:DesignWidth="800" d:DesignHeight="450"
            d:DataContext="{d:DesignInstance Type={x:Type thisVM:DesignViewModel}, IsDesignTimeCreatable=True}"
            Padding="0 8">

    <UserControl.InputBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding Save}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAs}" />
    </UserControl.InputBindings>
    <UserControl.Resources>


        <Geometry x:Key="Text">F1 M20,20z M0,0z M3,3.5A0.5,0.5,0,0,1,3.5,3L13.5,3A0.5,0.5,0,0,1,14,3.5L14,5.5A0.5,0.5,0,0,1,13,5.5L13,4 9,4 9,16 9.207,16Q9.356,16.524,9.6,17L6.5,17A0.5,0.5,0,0,1,6.5,16L8,16 8,4 4,4 4,5.5A0.5,0.5,0,0,1,3,5.5z M19,14.5A4.5,4.5,0,1,1,10,14.5A4.5,4.5,0,0,1,19,14.5 M15,12.5A0.5,0.5,0,0,0,14,12.5L14,14 12.5,14A0.5,0.5,0,0,0,12.5,15L14,15 14,16.5A0.5,0.5,0,0,0,15,16.5L15,15 16.5,15A0.5,0.5,0,0,0,16.5,14L15,14z</Geometry>

        <Style TargetType="{x:Type ui:ListBoxItem}" BasedOn="{StaticResource ListBoxItem.Outline}">
            <Setter Property="Padding" Value="8 4" />
        </Style>


        <Style x:Key="Menu" TargetType="{x:Type ui:SinkTabControl}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="0 8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ui:SinkTabControl}">
                        <DockPanel KeyboardNavigation.TabNavigation="Local">

                            <Border x:Name="TabPanel"
                                    BorderBrush="{DynamicResource Brush.HighlightA4}"
                                    BorderThickness="0 0 0 2"
                                    Padding="0">
                                <TabPanel x:Name="HeaderPanel"
                                          Panel.ZIndex="1"
                                          IsItemsHost="True"
                                          HorizontalAlignment="Left"
                                          KeyboardNavigation.TabIndex="1"
                                          Background="Transparent" />
                            </Border>

                            <Border x:Name="Border"
                                    Grid.Row="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    KeyboardNavigation.TabNavigation="Local"
                                    KeyboardNavigation.DirectionalNavigation="Contained"
                                    KeyboardNavigation.TabIndex="2"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  TextElement.FontSize="{TemplateBinding FontSize}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  ContentSource="SelectedContent"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch" />
                            </Border>
                        </DockPanel>

                        <ControlTemplate.Triggers>
                            <Trigger Property="TabStripPlacement" Value="Left">
                                <Setter Property="DockPanel.Dock" Value="Left" TargetName="TabPanel" />
                                <Setter Property="BorderThickness" Value="0 0 2 0" TargetName="TabPanel" />
                                <Setter Property="Padding" Value="16 0" />
                            </Trigger>

                            <Trigger Property="TabStripPlacement" Value="Right">
                                <Setter Property="DockPanel.Dock" Value="Right" TargetName="TabPanel" />
                                <Setter Property="BorderThickness" Value="2 0 0 0" TargetName="TabPanel" />
                                <Setter Property="Padding" Value="0 0 16 0" />
                            </Trigger>

                            <Trigger Property="TabStripPlacement" Value="Top">
                                <Setter Property="DockPanel.Dock" Value="Top" TargetName="TabPanel" />
                                <Setter Property="BorderThickness" Value="0 0 0 2" TargetName="TabPanel" />
                            </Trigger>


                            <Trigger Property="TabStripPlacement" Value="Bottom">
                                <Setter Property="DockPanel.Dock" Value="Bottom" TargetName="TabPanel" />
                                <Setter Property="BorderThickness" Value="0 2 0 0" TargetName="TabPanel" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type topology:TypographyPlaceholder}">
            <Border Background="Gray"
                    Height="{Binding Height, Mode=TwoWay}"
                    Width="{Binding Width, Mode=TwoWay}" />
        </DataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type this:TypographyLayerVPO}"
                                  ItemsSource="{Binding Blocks,Mode=OneWay}">
            <TextBlock Text="{Binding Layer.Name, Mode=OneWay}" />
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- ============ 顶部菜单 ============-->
        <ui:SinkTabControl DockPanel.Dock="Top"
                           WindowChrome.IsHitTestVisibleInChrome="True"
                           Background="{DynamicResource Brush.Background.Level2}"
                           BorderBrush="{DynamicResource Brush.HighlightA4}"
                           Effect="{StaticResource MenuItem.ShadowEffect}"
                           Height="160"
                           Margin="16 8 16 16"
                           SelectedIndex="0"
                           Padding="0"
                           Style="{StaticResource Menu}">

            <!-- ============ 开始面板 ============-->
            <ui:SinkTabItem Header="开始"
                            SizeChanged="TabControl_OnSizeChanged">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>


                    <ui:GhostButton ui:ControlAssist.CornerRadius="0"
                                    ui:ControlAssist.Icon="{StaticResource FeatherIcon.Save}"
                                    ui:ControlAssist.IconSize="31"
                                    ui:ControlAssist.IconDock="Top"
                                    ui:ControlAssist.IconMargin="0 8"
                                    Grid.Column="0"
                                    Foreground="{DynamicResource Brush.Success200}"
                                    Content="保存模板"
                                    IconMode="Both" />

                    <Rectangle Grid.Column="1"
                               Fill="{DynamicResource Brush.Border}"
                               Width="1"
                               VerticalAlignment="Stretch" />

                    <ui:GhostButton Grid.Column="2"
                                    ui:ControlAssist.CornerRadius="0"
                                    ui:ControlAssist.Icon="{StaticResource Components}"
                                    ui:ControlAssist.IconSize="31"
                                    ui:ControlAssist.IconDock="Top"
                                    ui:ControlAssist.IconMargin="0 8"
                                    Content="添加视觉"
                                    Command="{Binding AddVisualizer}"
                                    Foreground="{DynamicResource Brush.Success200}"
                                    IconMode="Both" />

                    <Rectangle Grid.Column="3"
                               Fill="{DynamicResource Brush.Border}"
                               Width="1"
                               VerticalAlignment="Stretch" />

                    <WrapPanel Grid.Column="4"
                               Margin="4">
                        <ui:GhostButton ui:ControlAssist.CornerRadius="0"
                                        ui:ControlAssist.Icon="{StaticResource FeatherIcon.Save}"
                                        Content="另存为"
                                        Height="32"
                                        HorizontalContentAlignment="Left"
                                        IconMode="Both"
                                        Width="300" />

                        <ui:GhostButton ui:ControlAssist.CornerRadius="0"
                                        ui:ControlAssist.Icon="{StaticResource FeatherIcon.Upload}"
                                        Content="导入页面"
                                        Height="32"
                                        HorizontalContentAlignment="Left"
                                        IconMode="Both"
                                        Width="144" />

                        <ui:GhostButton ui:ControlAssist.CornerRadius="0"
                                        ui:ControlAssist.Icon="{StaticResource FeatherIcon.Download}"
                                        Content="导出页面"
                                        Height="32"
                                        HorizontalContentAlignment="Left"
                                        IconMode="Both"
                                        Width="144" />

                        <ui:GhostButton ui:ControlAssist.CornerRadius="0"
                                        ui:ControlAssist.Icon="{StaticResource FeatherIcon.Upload}"
                                        Content="导入模板"
                                        Height="32"
                                        HorizontalContentAlignment="Left"
                                        IconMode="Both"
                                        Width="144" />
                        <ui:GhostButton ui:ControlAssist.CornerRadius="0"
                                        ui:ControlAssist.Icon="{StaticResource FeatherIcon.Download}"
                                        Content="导出模板"
                                        Height="32"
                                        HorizontalContentAlignment="Left"
                                        IconMode="Both"
                                        Width="144" />
                    </WrapPanel>

                    <Rectangle Grid.Column="5"
                               Fill="{DynamicResource Brush.Border}"
                               Width="1"
                               VerticalAlignment="Stretch" />


                    <WrapPanel Grid.Column="6"
                               Margin="8 4"
                               ItemWidth="160"
                               Orientation="Vertical">
                        <ui:GhostButton ui:ControlAssist.CornerRadius="0"
                                        ui:ControlAssist.Icon="{StaticResource Text}"
                                        ui:ControlAssist.IsFilled="True"
                                        Content="添加装饰文本"
                                        Height="48"
                                        HorizontalContentAlignment="Left"
                                        IconMode="Both" />

                        <ui:GhostButton ui:ControlAssist.CornerRadius="0"
                                        ui:ControlAssist.Icon="{StaticResource FeatherIcon.Image}"
                                        Content="添加装饰图片"
                                        Height="48"
                                        HorizontalContentAlignment="Left"
                                        IconMode="Both" />

                        <ui:GhostButton ui:ControlAssist.CornerRadius="0"
                                        ui:ControlAssist.Icon="{StaticResource FeatherIcon.Image}"
                                        Content="添加水平装饰"
                                        Height="48"
                                        HorizontalContentAlignment="Left"
                                        IconMode="Both" />


                        <ui:GhostButton ui:ControlAssist.CornerRadius="0"
                                        ui:ControlAssist.Icon="{StaticResource FeatherIcon.Image}"
                                        Content="添加垂直装饰"
                                        Height="48"
                                        HorizontalContentAlignment="Left"
                                        IconMode="Both" />

                        <ui:GhostButton ui:ControlAssist.CornerRadius="0"
                                        ui:ControlAssist.Icon="{StaticResource FeatherIcon.Image}"
                                        Content="添加对角装饰（\）"
                                        Height="48"
                                        HorizontalContentAlignment="Left"
                                        IconMode="Both" />

                        <ui:GhostButton ui:ControlAssist.CornerRadius="0"
                                        ui:ControlAssist.Icon="{StaticResource FeatherIcon.Image}"
                                        Content="添加对角装饰（/）"
                                        Height="48"
                                        HorizontalContentAlignment="Left"
                                        IconMode="Both" />

                        <ui:GhostButton ui:ControlAssist.CornerRadius="0"
                                        ui:ControlAssist.Icon="{StaticResource FeatherIcon.Image}"
                                        Content="添加四角装饰"
                                        Height="48"
                                        HorizontalContentAlignment="Left"
                                        IconMode="Both" />
                    </WrapPanel>

                    <Rectangle Grid.Column="7"
                               Fill="{DynamicResource Brush.Border}"
                               Width="1"
                               VerticalAlignment="Stretch" />


                    <ui:GhostButton Grid.Column="8"
                                    ui:ControlAssist.CornerRadius="0"
                                    ui:ControlAssist.Icon="{StaticResource FeatherIcon.Trash}"
                                    ui:ControlAssist.IconSize="31"
                                    ui:ControlAssist.IconDock="Top"
                                    ui:ControlAssist.IconMargin="0 8"
                                    Content="删除页面"
                                    Foreground="{DynamicResource Brush.Error400}"
                                    IconMode="Both" />
                </Grid>
            </ui:SinkTabItem>


            <!-- ============ 页面面板 ============-->
            <ui:SinkTabItem Header="页面">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="384" />
                    </Grid.ColumnDefinitions>

                    <HeaderedContentControl Grid.Column="0"
                                            Header="页面属性"
                                            Margin="8 2"
                                            Style="{StaticResource SettingItem}">
                        <StackPanel>

                            <HeaderedContentControl Header="宽度"
                                                    BorderThickness="0"
                                                    Style="{StaticResource PropertyItem}">
                                <TextBlock Text="{Binding PageWidth, Mode=OneWay,StringFormat={}{0:F1}}" />
                            </HeaderedContentControl>

                            <HeaderedContentControl Header="高度"
                                                    BorderThickness="0"
                                                    Style="{StaticResource PropertyItem}">
                                <TextBlock Text="{Binding PageHeight, Mode=OneWay,StringFormat={}{0:F1}}" />
                            </HeaderedContentControl>
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Grid.Column="1"
                                            Header="页面宽度"
                                            Margin="8 2"
                                            Style="{StaticResource SettingItem}"
                                            VerticalAlignment="Top">
                        <DockPanel>
                            <ui:SingleLine DockPanel.Dock="Bottom"
                                           IsEnabled="{Binding IsCustomSize, Mode=OneWay}"
                                           CornerRadius="0"
                                           Margin="0 4"
                                           Text="{Binding PageWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=100}"
                                           Watermark="自定义（1000px~2000px）" />
                        </DockPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Grid.Column="2"
                                            Header="模板宽度"
                                            Margin="8 2"
                                            Style="{StaticResource SettingItem}">

                        <ui:ListBox ItemsSource="{Binding PageSizes}"
                                    SelectedItem="{Binding PageSize, Mode=TwoWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemWidth="100"
                                               Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="8 4"
                                               Text="{Binding Converter={x:Static Converters.EnumToString}}"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ui:ListBox>
                    </HeaderedContentControl>

                    <HeaderedContentControl Grid.Column="3"
                                            Header="样例设定"
                                            Margin="8 2"
                                            Style="{StaticResource SettingItem}">

                        <WrapPanel Grid.Column="6"
                                   Margin="8 4"
                                   ItemHeight="32"
                                   ItemWidth="160"
                                   Orientation="Vertical">
                            <ui:GhostButton ui:ControlAssist.CornerRadius="0"
                                            ui:ControlAssist.Icon="{StaticResource FeatherIcon.Edit}"
                                            Content="编辑"
                                            IconMode="Both" />

                            <ui:GhostButton ui:ControlAssist.CornerRadius="0"
                                            ui:ControlAssist.Icon="{StaticResource FeatherIcon.Image}"
                                            Content="导入"
                                            IconMode="Both" />
                            <ui:GhostButton ui:ControlAssist.CornerRadius="0"
                                            ui:ControlAssist.Icon="{StaticResource FeatherIcon.Image}"
                                            Content="导出"
                                            IconMode="Both" />
                        </WrapPanel>

                    </HeaderedContentControl>
                </Grid>
            </ui:SinkTabItem>
            
            <!-- ============ 帮助面板 ============-->
            <ui:SinkTabItem Header="设定" />

            <!-- ============ 帮助面板 ============-->
            <ui:SinkTabItem Header="帮助" />
        </ui:SinkTabControl>

        <!-- ============ 中间内容 ============-->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="1*" MinWidth="320" />
                <ColumnDefinition Width="16" />
            </Grid.ColumnDefinitions>

            <!-- ============ Page ____ 页面 ============-->
            <HeaderedContentControl Grid.Column="1"
                                    BorderBrush="Gray"
                                    Header="页面"
                                    Margin="16 0"
                                    Style="{StaticResource HeaderedContentControl.DecoratedStyle1}">
                <ui:ControlAssist.ToolBar>
                    <StackPanel Orientation="Horizontal">
                        <ui:GhostButton ui:ControlAssist.CornerRadius="0"
                                        ui:ControlAssist.Icon="{StaticResource FeatherIcon.PlusCircle}"
                                        Command="{Binding AddPage}"
                                        IconMode="Icon"
                                        Padding="0"
                                        Height="32"
                                        Width="32" />
                        <ui:ToggleButton ui:ControlAssist.CornerRadius="0"
                                         ui:ControlAssist.Icon="{StaticResource FeatherIcon.Lock}"
                                         IconMode="Icon"
                                         Padding="0"
                                         Height="32"
                                         Width="32" />
                    </StackPanel>
                </ui:ControlAssist.ToolBar>
                <ui:ListBox ItemsSource="{Binding Pages, Mode=OneWay}"
                            SelectedItem="{Binding Page, Mode=TwoWay}"
                            SelectionChanged="Selection_RenderCanvas">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="Gray"
                                    Height="90"
                                    Width="160">
                                <Border Height="90"
                                        Width="160">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Bitmap, Mode=OneWay}"/>
                                    </Border.Background>
                                </Border>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ui:ListBox>
            </HeaderedContentControl>

            <!-- ============ Typography ____ 排版 ============-->
            <HeaderedContentControl Grid.Column="2"
                                    BorderBrush="Gray"
                                    Header="排版"
                                    Margin="16 0"
                                    Style="{StaticResource HeaderedContentControl.DecoratedStyle1}">
                <ui:ControlAssist.ToolBar>
                    <StackPanel Orientation="Horizontal">
                        <ui:GhostButton ui:ControlAssist.CornerRadius="0"
                                        ui:ControlAssist.Icon="{StaticResource FeatherIcon.MinusCircle}"
                                        IconMode="Icon"
                                        Padding="0"
                                        Height="32"
                                        Width="32" />

                        <TextBlock Text="100%"
                                   TextAlignment="Center"
                                   FontFamily="{StaticResource SongTi}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Width="64" />

                        <ui:GhostButton ui:ControlAssist.CornerRadius="0"
                                        ui:ControlAssist.Icon="{StaticResource FeatherIcon.PlusCircle}"
                                        IconMode="Icon"
                                        Padding="0"
                                        Height="32"
                                        Width="32" />
                    </StackPanel>
                </ui:ControlAssist.ToolBar>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <AdornerDecorator>
                            <ItemsControl x:Name="Items"
                                          ItemsSource="{Binding ObservableBlocks, Mode=OneWay}">
                                <ItemsControl.Resources>
                                    <DataTemplate DataType="{x:Type visualizers:TypographyVisualizerVPO}">
                                        <ContentPresenter Content="{Binding Converter={x:Static visualizers:Visualizer.View}}" />
                                    </DataTemplate>
                                </ItemsControl.Resources>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X, Mode=TwoWay}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y, Mode=TwoWay}" />
                                        <EventSetter Event="MouseLeftButtonDown" Handler="Control_MouseLeftButtonDown" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas IsItemsHost="True"
                                                Margin="8"
                                                Height="{Binding PageHeight, Mode=OneWay}"
                                                Width="{Binding PageWidth, Mode=OneWay}">
                                            <Canvas.Background>
                                                <DrawingBrush Drawing="{thisControls:GridlineGenerator Brush={StaticResource Brush.Background.Level1}}"
                                                              Viewport="0,0,200,200"
                                                              ViewportUnits="Absolute"
                                                              TileMode="Tile" />
                                            </Canvas.Background>
                                        </Canvas>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </AdornerDecorator>
                    </ScrollViewer>
                </Grid>
            </HeaderedContentControl>

            <!-- ============ Design ____ 设计与属性 ============-->
            <ui:SinkTabControl Grid.Column="3"
                               BorderBrush="Gray"
                               Margin="16 0">


                <ui:SinkTabItem Header="图层">

                    <HeaderedContentControl Grid.Row="0"
                                            Header="图层"
                                            Style="{StaticResource SettingItem}">
                        <ui:ControlAssist.ToolBar>
                            <ui:CheckBox ui:ControlAssist.CornerRadius="0"
                                         Content="仅显示当前图层"
                                         HorizontalAlignment="Right"
                                         IsChecked="{Binding LayerBlockOnly, Mode=TwoWay}"
                                         Height="32" />
                        </ui:ControlAssist.ToolBar>

                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top"
                                        Margin="0 0 0 8"
                                        Orientation="Horizontal">
                                <ui:GhostButton ui:ControlAssist.CornerRadius="0"
                                                ui:ControlAssist.Icon="{StaticResource FeatherIcon.PlusCircle}"
                                                Command="{Binding AddLayer}"
                                                IconMode="Icon"
                                                Padding="0"
                                                Height="32"
                                                Width="32" />
                                <ui:GhostButton ui:ControlAssist.CornerRadius="0"
                                                ui:ControlAssist.Icon="{StaticResource FeatherIcon.Edit}"
                                                IconMode="Icon"
                                                Padding="0"
                                                Height="32"
                                                Width="32" />
                                <ui:GhostButton ui:ControlAssist.CornerRadius="0"
                                                ui:ControlAssist.Icon="{StaticResource FeatherIcon.Trash}"
                                                IconMode="Icon"
                                                Padding="0"
                                                Height="32"
                                                Width="32" />
                            </StackPanel>
                            <ui:TreeView ItemsSource="{Binding Layers}"
                                         BindableSelectedItem="{Binding Layer, Mode=TwoWay}">

                            </ui:TreeView>
                        </DockPanel>
                    </HeaderedContentControl>
                </ui:SinkTabItem>
                <ui:SinkTabItem Header="元素">

                    <StackPanel>


                        <HeaderedContentControl Header="属性"
                                                Margin="0 0 0 16"
                                                Style="{StaticResource SettingItem}">
                            <ui:ControlAssist.ToolBar>
                                <ui:ToggleButton ui:ControlAssist.CornerRadius="0"
                                                 ui:ControlAssist.Icon="{StaticResource FeatherIcon.Lock}"
                                                 Click="Button_ReleaseCapture"
                                                 IconMode="Icon"
                                                 IsChecked="{Binding Block.IsLock, Mode=TwoWay}"
                                                 Padding="0"
                                                 Height="32"
                                                 Width="32" />
                            </ui:ControlAssist.ToolBar>
                            <StackPanel>
                                <HeaderedContentControl Header="Id"
                                                        BorderThickness="0"
                                                        Style="{StaticResource PropertyItem}">
                                    <TextBlock Text="{Binding Block.Id, Mode=OneWay,StringFormat={}{0:F1}}" />
                                </HeaderedContentControl>

                                <HeaderedContentControl Header="X"
                                                        BorderThickness="0"
                                                        Style="{StaticResource PropertyItem}">
                                    <TextBlock Text="{Binding Block.X, Mode=OneWay,StringFormat={}{0:F1}}" />
                                </HeaderedContentControl>

                                <HeaderedContentControl Header="Y"
                                                        BorderThickness="0"
                                                        Style="{StaticResource PropertyItem}">
                                    <TextBlock Text="{Binding Block.Y, Mode=OneWay,StringFormat={}{0:F1}}" />
                                </HeaderedContentControl>

                                <HeaderedContentControl Header="宽度"
                                                        BorderThickness="0"
                                                        Style="{StaticResource PropertyItem}">
                                    <TextBlock Text="{Binding Block.Width, Mode=OneWay,StringFormat={}{0:F1}}" />
                                </HeaderedContentControl>

                                <HeaderedContentControl Header="高度"
                                                        BorderThickness="0"
                                                        Style="{StaticResource PropertyItem}">
                                    <TextBlock Text="{Binding Block.Height, Mode=OneWay,StringFormat={}{0:F1}}" />
                                </HeaderedContentControl>


                            </StackPanel>
                        </HeaderedContentControl>

                        <HeaderedContentControl Grid.Row="0"
                                                Header="元素"
                                                Style="{StaticResource SettingItem}">
                            <ui:ControlAssist.ToolBar>
                                <StackPanel Orientation="Horizontal">
                                    <ui:GhostButton ui:ControlAssist.CornerRadius="0"
                                                    ui:ControlAssist.Icon="{StaticResource FeatherIcon.PlusCircle}"
                                                    Command="{Binding AddVisualizer}"
                                                    IconMode="Icon"
                                                    Padding="0"
                                                    Height="32"
                                                    Width="32" />
                                    <ui:GhostButton ui:ControlAssist.CornerRadius="0"
                                                    ui:ControlAssist.Icon="{StaticResource Text}"
                                                    ui:ControlAssist.IsFilled="True"
                                                    Command="{Binding AddTextBlock}"
                                                    IconMode="Icon"
                                                    Padding="0"
                                                    Height="32"
                                                    Width="32" />
                                    <ui:GhostButton ui:ControlAssist.CornerRadius="0"
                                                    ui:ControlAssist.Icon="{StaticResource FeatherIcon.Image}"
                                                    Command="{Binding AddImageBlock}"
                                                    IconMode="Icon"
                                                    Padding="0"
                                                    Height="32"
                                                    Width="32" />
                                    <ui:GhostButton ui:ControlAssist.CornerRadius="0"
                                                    ui:ControlAssist.Icon="{StaticResource FeatherIcon.Edit}"
                                                    IconMode="Icon"
                                                    Padding="0"
                                                    Height="32"
                                                    Width="32" />
                                    <ui:GhostButton ui:ControlAssist.CornerRadius="0"
                                                    ui:ControlAssist.Icon="{StaticResource FeatherIcon.Trash}"
                                                    Command="{Binding RemoveBlock}"
                                                    IconMode="Icon"
                                                    Padding="0"
                                                    Height="32"
                                                    Width="32" />
                                </StackPanel>
                            </ui:ControlAssist.ToolBar>
                            <ui:ListBox DisplayMemberPath="Base.Name"
                                        ItemsSource="{Binding Blocks}"
                                        SelectedItem="{Binding Block, Mode=TwoWay}">
                            </ui:ListBox>
                        </HeaderedContentControl>

                    </StackPanel>
                </ui:SinkTabItem>
                <ui:SinkTabItem Header="属性">
                    <ScrollViewer>
                        <ContentControl Content="{Binding Block, Mode=OneWay}">

                            <ContentControl.Resources>
                                <DataTemplate DataType="{x:Type visualizers:TypographyVisualizerVPO}">
                                    <ContentPresenter Content="{Binding Converter={x:Static visualizers:Visualizer.Setting}}" />
                                </DataTemplate>
                            </ContentControl.Resources>
                        </ContentControl>
                    </ScrollViewer>
                </ui:SinkTabItem>
                <ui:SinkTabItem Header="设定">
                    <HeaderedContentControl Grid.Column="2"
                                            Header="设定"
                                            Margin="8 2"
                                            Style="{StaticResource SettingItem}">
                        <ui:ControlAssist.ToolBar>
                            <StackPanel Orientation="Horizontal">
                                <ui:GhostButton ui:ControlAssist.CornerRadius="0"
                                                ui:ControlAssist.Icon="{StaticResource FeatherIcon.PlusCircle}"
                                                Command="{Binding AddSetting}"
                                                IconMode="Icon"
                                                Padding="0"
                                                Height="32"
                                                Width="32" />
                                <ui:GhostButton ui:ControlAssist.CornerRadius="0"
                                                ui:ControlAssist.Icon="{StaticResource Rename}"
                                                ui:ControlAssist.IsFilled="True"
                                                Command="{Binding UpdateSetting}"
                                                IconMode="Icon"
                                                Padding="0"
                                                Height="32"
                                                Width="32" />
                            </StackPanel>
                        </ui:ControlAssist.ToolBar>

                        <ui:ListBox DisplayMemberPath="Key"
                                    ItemsSource="{Binding Moniker.Settings, Mode=OneWay}"
                                    SelectedValue="{Binding Setting, Mode=TwoWay}"
                                    SelectedValuePath="Key">
                        </ui:ListBox>
                    </HeaderedContentControl>
                </ui:SinkTabItem>
            </ui:SinkTabControl>
        </Grid>
    </DockPanel>
</ForestPage>