<ForestPage x:Class="MaoTouGu.JuXiaoYou.Pages.DebuggerView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:ui="urn:KinonekoSoftware/ui"
            xmlns:this="clr-namespace:MaoTouGu.JuXiaoYou.Pages"
            xmlns:thisVM="clr-namespace:MaoTouGu.JuXiaoYou.Pages"
            xmlns:visualizers="clr-namespace:MaoTouGu.JuXiaoYou.Visualizers.GravatarWide;assembly=MaoTouGu.JuXiaoYou.Domain.Visualizers"
            mc:Ignorable="d"
            d:DesignWidth="800" d:DesignHeight="450"
            d:DataContext="{d:DesignInstance Type={x:Type thisVM:DebuggerViewModel}, IsDesignTimeCreatable=True}"
            Padding="32">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="9*"/>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        
        <HeaderedContentControl Grid.Column="1"
                                Header="预览"
                                Margin="8 2"
                                Style="{StaticResource SettingItem}">
            <visualizers:WithRarityGravatarPresenter Options="{Binding Options, Mode=OneWay}"
                                                     Moniker="{Binding Moniker, Mode=OneWay}"
                                                     Height="144"
                                                     Width="96"/>
        </HeaderedContentControl>
        
        <HeaderedContentControl Grid.Column="2"
                                Header="设定"
                                Margin="8 2"
                                Style="{StaticResource SettingItem}">
            <ui:ControlAssist.ToolBar>
                <StackPanel Orientation="Horizontal">
                    <ui:GhostButton ui:ControlAssist.CornerRadius="0"
                                     ui:ControlAssist.Icon="{StaticResource FeatherIcon.PlusCircle}"
                                     Command="{Binding Add}"
                                     IconMode="Icon"
                                     Padding="0"
                                     Height="32"
                                     Width="32" />
                    <ui:GhostButton ui:ControlAssist.CornerRadius="0"
                                    ui:ControlAssist.Icon="{StaticResource Rename}"
                                    ui:ControlAssist.IsFilled="True"
                                    Command="{Binding Update}"
                                    IconMode="Icon"
                                    Padding="0"
                                    Height="32"
                                    Width="32" />
                </StackPanel>
            </ui:ControlAssist.ToolBar>

            <ui:ListBox DisplayMemberPath="Key"
                        ItemsSource="{Binding Moniker.Settings, Mode=OneWay}"
                        SelectedValue="{Binding Setting, Mode=TwoWay}"
                        SelectedValuePath="Key">
            </ui:ListBox>
        </HeaderedContentControl>
    </Grid>
</ForestPage>