<MTGWindow x:Class="MaoTouGu.JuXiaoYou.StandaloneWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:local="clr-namespace:MaoTouGu.JuXiaoYou"
           xmlns:ui="urn:KinonekoSoftware/ui"
           xmlns:thisVM="clr-namespace:MaoTouGu.Shells.AppModels;assembly=MaoTouGu.Shells.WPF"
           xmlns:appModels="clr-namespace:MaoTouGu.JuXiaoYou.AppModels;assembly=MaoTouGu.JuXiaoYou.Core"
           mc:Ignorable="d"
           Icon="pack://application:,,,/MaoTouGu.JuXiaoYou;component/JuXiaoYou4.ico"
           UseLayoutRounding="True"
           SnapsToDevicePixels="True"
           MinHeight="640"
           MinWidth="1280"
           Height="640"
           Width="1280"
           d:DataContext="{d:DesignInstance Type={x:Type thisVM:MultipleWindowContext}, IsDesignTimeCreatable=True}">
    <Window.Resources>
        <BindingProxy x:Key="ViewModel" ViewModel="{Binding}" />
    </Window.Resources>
    <DialogHost x:Name="DialogHost">
        <Grid>
            <ui:Drawer>
                <ContentHost x:Name="ContentHost"
                             ViewModel="{Binding Page, Mode=OneWay}" />
            </ui:Drawer>
            <Grid x:Name="TitleBar"
                  Background="Transparent"
                  Margin="240 0 0 0"
                  VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>

                <WindowMinimumButton Grid.Column="2"
                                     WindowChrome.IsHitTestVisibleInChrome="True"
                                     Width="48"
                                     Height="32"
                                     VerticalAlignment="Top" />

                <WindowMaximumButton Grid.Column="3"
                                     WindowChrome.IsHitTestVisibleInChrome="True"
                                     Width="48"
                                     Height="32"
                                     VerticalAlignment="Top" />

                <WindowCloseButton Grid.Column="4"
                                   WindowChrome.IsHitTestVisibleInChrome="True"
                                   Width="48"
                                   Height="32"
                                   VerticalAlignment="Top" />
            </Grid>
        </Grid>
    </DialogHost>
</MTGWindow>