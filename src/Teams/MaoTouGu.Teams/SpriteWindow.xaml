<MTGWindow x:Class="MaoTouGu.Teams.SpriteWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:local="clr-namespace:MaoTouGu.JuXiaoYou"
           xmlns:ui="urn:KinonekoSoftware/ui"
           xmlns:tray="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
           xmlns:thisVM="clr-namespace:MaoTouGu.JuXiaoYou.AppModels"
           mc:Ignorable="d"
           d:DataContext="{d:DesignInstance Type={x:Type thisVM:ChatShell}, IsDesignTimeCreatable=True}"
           Icon="{StaticResource AppIcon}"
           WindowStyle="None"
           ResizeMode="NoResize"
           Background="Transparent"
           Topmost="True"
           Title="橘小柚"
           Height="239.8"
           Width="166.8"
           ShowInTaskbar="False"
           UseLayoutRounding="True"
           SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1"
                      CaptionHeight="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BindingProxy x:Key="ViewModel" ViewModel="{Binding}" />
    </Window.Resources>
    <Window.Effect>
        <DropShadowEffect ShadowDepth="0"
                          Color="#FFAB12" />
    </Window.Effect>
    <Window.ContextMenu>
        <ui:ContextMenu>
            <ui:MenuItem Header="应用" />
            <Separator />
            <ui:MenuItem Click="Menu_HideWindow"
                         Icon="{StaticResource FeatherIcon.Close}"
                         IconSize="11"
                         Header="最小化到托盘"
                         IconMode="Both" />
            <Separator />
            <ui:MenuItem Click="Menu_CloseWindow"
                         Icon="{StaticResource FeatherIcon.Close}"
                         IconSize="11"
                         Header="彻底退出"
                         IconMode="Both" />
        </ui:ContextMenu>
    </Window.ContextMenu>
    <Grid>
        <Image Source="{StaticResource AppImage}" />
        <tray:TaskbarIcon x:Name="TrayIcon"
                          IconSource="{StaticResource AppIcon}"
                          TrayLeftMouseDoubleClick="Menu_ShowWindow">
            <tray:TaskbarIcon.ContextMenu>
                <ui:ContextMenu>
                    <ui:MenuItem Header="主界面"
                                 Click="Menu_ShowWindow" />
                    <Separator />
                    <ui:MenuItem Click="Menu_CloseWindow"
                                 Icon="{StaticResource FeatherIcon.Close}"
                                 IconSize="11"
                                 Header="彻底退出"
                                 IconMode="Both" />
                </ui:ContextMenu>
            </tray:TaskbarIcon.ContextMenu>
        </tray:TaskbarIcon>
    </Grid>
</MTGWindow>