<MTGWindow x:Class="MaoTouGu.Shells.Runer.MainWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           xmlns:local="clr-namespace:MaoTouGu.Shells.Runer"
           xmlns:localV="clr-namespace:MaoTouGu.Shells.Runer.Views"
           mc:Ignorable="d"
           Title="MainWindow" Height="450" Width="800"
           UseLayoutRounding="True"
           SnapsToDevicePixels="True">
    
    <DialogHost x:Name="DialogHost">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                
                <!-- TitleBar -->
                <WindowMinimumButton WindowChrome.IsHitTestVisibleInChrome="True"
                                     Width="48"
                                     Height="32"
                                     VerticalAlignment="Top" />

                <WindowMaximumButton WindowChrome.IsHitTestVisibleInChrome="True"
                                     Width="48"
                                     Height="32"
                                     VerticalAlignment="Top" />

                <WindowCloseButton WindowChrome.IsHitTestVisibleInChrome="True"
                                   Width="48"
                                   Height="32"
                                   VerticalAlignment="Top" />
            </StackPanel>
            <ContentHost x:Name="ContentHost">
                
            </ContentHost>
        </DockPanel>
    </DialogHost>
</MTGWindow>