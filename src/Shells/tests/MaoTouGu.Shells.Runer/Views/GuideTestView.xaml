<ForestPage x:Class="MaoTouGu.Shells.Runer.Views.GuideTestView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:shell="urn:KinonekoSoftware/shells"
            xmlns:ui="urn:KinonekoSoftware/ui"
            xmlns:this="clr-namespace:MaoTouGu.Shells.Runer.Views"
            mc:Ignorable="d"
            d:DesignWidth="800" d:DesignHeight="450">

    <DockPanel x:Name="Panel"
               Margin="0"
               WindowChrome.IsHitTestVisibleInChrome="True">
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource Brush.Background.Level3}"
                Padding="0 8">
            <StackPanel DockPanel.Dock="Top"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">

                <Button Content="导入"
                        Margin="2 0"
                        Tag="1" />

                <Button Content="导出"
                        Margin="2 0"
                        Tag="1" />

                <Button Content="保存"
                        Margin="32 0 2 0"
                        Tag="1" />

                <Button Content="加载"
                        Margin="2 0"
                        Tag="1" />

                <Button Guide.Hint="Capture"
                        Guide.Placement="Bottom"
                        Content="截图"
                        Margin="32 0 2 0"
                        Tag="1" />
            </StackPanel>
        </Border>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="72" />
            </Grid.ColumnDefinitions>

            <Border x:Name="Container"
                    Grid.Column="0">
                <ContentControl Grid.Column="0"
                                Tag="1" />
            </Border>

            <ScrollViewer Grid.Column="1"
                          Margin="16 0">
                <StackPanel>

                    <HeaderedContentControl Header="编辑"
                                            Tag="1">

                        <ContentControl Margin="0 16">
                        </ContentControl>
                    </HeaderedContentControl>

                    <TextBox DockPanel.Dock="Bottom" />
                </StackPanel>
            </ScrollViewer>

            <WrapPanel Grid.Column="3"
                       DockPanel.Dock="Top"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top">
                <Button Guide.Hint="Play"
                        Guide.AllowMultiple="True"
                        Guide.Placement="Left"
                        Guide.Index="1"
                        Foreground="#aa6be9"
                        Content="法石卡"
                        Tag="1"
                        Margin="0 2" />

                <Button Foreground="#c24949"
                        Content="灾厄卡"
                        Tag="1"
                        Margin="0 2" />

                <Button Foreground="#e09932"
                        Content="遗迹卡"
                        Tag="1"
                        Margin="0 2" />

                <Button Foreground="#769ad0"
                        Content="角色卡"
                        Tag="1"
                        Margin="0 2" />

                <Button Foreground="#ac7c6f"
                        Content="装备卡"
                        Tag="1"
                        Margin="0 2" />

                <Button Foreground="#abb249"
                        Content="技能卡"
                        Tag="1"
                        Margin="0 2" />

                <Button Foreground="#a2a9b8"
                        Content="生物卡"
                        Tag="1"
                        Margin="0 2" />

                <Button Foreground="#9fabf2"
                        Content="商店卡"
                        Tag="1"
                        Margin="0 2" />
            </WrapPanel>

            <HeaderedContentControl Grid.Column="2"
                                    Header="卡组">

                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top"
                               ItemHeight="32"
                               ItemWidth="72"
                               Orientation="Horizontal">
                        <Button Content="添加"
                                Margin="2 0"
                                Tag="1" />

                        <Button Content="编辑"
                                Margin="2 0"
                                Tag="1" />

                        <Button Content="删除"
                                Margin="2 0"
                                Tag="1" />
                    </WrapPanel>

                    <ListBox Background="Transparent"
                             Margin="0 12 0 0">
                    </ListBox>
                </DockPanel>
            </HeaderedContentControl>
        </Grid>
    </DockPanel>
</ForestPage>