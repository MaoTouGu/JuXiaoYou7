<shells:ForestDialog x:Class="MaoTouGu.Shells.Controls.QuestionView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:ui="urn:KinonekoSoftware/ui"
                     xmlns:shells="clr-namespace:MaoTouGu.Shells.Controls"
                     xmlns:converters="clr-namespace:MaoTouGu.Shells.Converters"
                     xmlns:juxiaoyou="urn:KinonekoSoftware/c3studio/juxiaoyou"
                     xmlns:thisVM="clr-namespace:MaoTouGu.Shells.Core"
                     mc:Ignorable="d"
                     d:DesignWidth="800" d:DesignHeight="450"
                     d:DataContext="{d:DesignInstance Type={x:Type thisVM:QuestionRoot}, IsDesignTimeCreatable=True}">
    <Border Background="{DynamicResource Brush.Background.Level3}"
            BorderBrush="{Binding Type, Mode=OneWay ,Converter={x:Static converters:Converters.NotifyBrush}}"
            BorderThickness="0 4 0 0"
            Padding="32 16"
            Height="384"
            Width="320">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Foreground="{Binding Type, Mode=OneWay ,Converter={x:Static converters:Converters.NotifyBrush}}"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0 16 0 0"
                       Text="{Binding Title}"
                       TextAlignment="Left" />

            <ScrollViewer Grid.Row="1">
                <TextBlock HorizontalAlignment="Left"
                           LineHeight="28"
                           TextWrapping="Wrap"
                           Text="{Binding Description,Mode=OneWay}"
                           VerticalAlignment="Top" />
            </ScrollViewer>

            <!-- Ok/Cancel Button -->
            <UniformGrid Grid.Row="2"
                         Rows="2"
                         Height="84">
                <Border Background="{Binding Type, Mode=OneWay ,Converter={x:Static converters:Converters.NotifyBrush}}"
                        CornerRadius="18"
                        Margin="4">
                    <ui:GhostButton ui:ControlAssist.CornerRadius="18"
                                    Content="{Binding NoButtonText}"
                                    Command="{Binding CancelCommand}"
                                    IconMode="Text"
                                    FontSize="13" />
                </Border>

                <ui:GhostButton ui:ControlAssist.CornerRadius="18"
                                Content="{Binding OkButtonText}"
                                Command="{Binding CompleteCommand}"
                                IconMode="Text"
                                FontSize="13"
                                Margin="4" />
            </UniformGrid>
        </Grid>
    </Border>
</shells:ForestDialog>