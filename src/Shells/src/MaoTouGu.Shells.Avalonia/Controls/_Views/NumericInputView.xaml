<shells:ForestDialog x:Class="MaoTouGu.Shells.Controls.NumericInputView"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:ui="urn:KinonekoSoftware/ui"
                    xmlns:this="clr-namespace:MaoTouGu.Shells"
                    xmlns:shells="clr-namespace:MaoTouGu.Shells.Controls"
                    xmlns:thisVM="clr-namespace:MaoTouGu.Shells.Core"
                    mc:Ignorable="d"
                    d:DesignWidth="800" d:DesignHeight="450"
                    d:DataContext="{d:DesignInstance Type={x:Type thisVM:RangeInputRoot}, IsDesignTimeCreatable=True}">
    <Border Background="{DynamicResource Brush.Background.Level3}"
            BorderBrush="{DynamicResource Brush.SlateGray100}"
            BorderThickness="0 2 0 0"
            CornerRadius="8"
            Padding="32 16"
            Width="360">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0 0 0 8"
                       Text="{Binding Title}"
                       TextAlignment="Center" />

            <TextBlock Grid.Row="1"
                       FontSize="13"
                       Foreground="{DynamicResource Brush.Foreground.Level2}"
                       Margin="0"
                       Text="{Binding Description}"
                       TextWrapping="Wrap" />

            <DockPanel Grid.Row="2">
                <TextBlock DockPanel.Dock="Right"
                           Margin="8 0 0 0"
                           Text="{Binding Value, Mode=OneWay}"
                           VerticalAlignment="Center"
                           MinWidth="24" />

                <Slider Grid.Row="2"
                        Margin="0 16"
                        Interval="1"
                        Minimum="1"
                        Maximum="{Binding Maximum}"
                        Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>

            <!-- Ok/Cancel Button -->
            <UniformGrid Grid.Row="3"
                         Columns="2"
                         Height="36">
                <ui:MainButton ui:ControlAssist.CornerRadius="18"
                               Content="确定"
                               Command="{Binding CompleteCommand}"
                               IconMode="Text"
                               FontSize="13"
                               Margin="0 0 4 0"
                               Style="{StaticResource MainButton.Base}" />

                <ui:GhostButton ui:ControlAssist.CornerRadius="18"
                                Content="取消"
                                Command="{Binding CancelCommand}"
                                IconMode="Text"
                                FontSize="13"
                                Margin="4 0 0 0" />
            </UniformGrid>
        </Grid>
    </Border>
</shells:ForestDialog>