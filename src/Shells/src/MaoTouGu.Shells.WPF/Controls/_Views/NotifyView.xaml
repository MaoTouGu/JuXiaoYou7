<shells:ForestDialog x:Class="MaoTouGu.Shells.Controls.NotifyView"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:ui="urn:KinonekoSoftware/ui"
                    xmlns:shells="clr-namespace:MaoTouGu.Shells.Controls"
                    xmlns:this="clr-namespace:MaoTouGu.Shells"
                    xmlns:converters="clr-namespace:MaoTouGu.Shells.Converters"
                    xmlns:thisVM="clr-namespace:MaoTouGu.Shells.Core"
                    xmlns:juxiaoyou="urn:KinonekoSoftware/c3studio/juxiaoyou"
                    mc:Ignorable="d"
                    d:DesignWidth="800" d:DesignHeight="450"
                    d:DataContext="{d:DesignInstance Type={x:Type thisVM:NotifyRoot}, IsDesignTimeCreatable=True}">
    <Border Background="{DynamicResource Brush.Background.Level3}"
            BorderBrush="{Binding Type, Mode=OneWay ,Converter={x:Static converters:Converters.NotifyBrush}}"
            BorderThickness="0 4 0 0"
            ui:ControlAssist.CornerRadius="8"
            Padding="32 16"
            Height="384"
            Width="320">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Foreground="{Binding Type, Mode=OneWay ,Converter={x:Static converters:Converters.NotifyBrush}}"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0 16 0 0"
                       Text="{Binding Title}"
                       TextAlignment="Left" />

            <ScrollViewer Grid.Row="1">
                <TextBlock HorizontalAlignment="Left"
                           LineHeight="28"
                           TextWrapping="Wrap"
                           Text="{Binding Description,Mode=OneWay}"
                           VerticalAlignment="Top" />
            </ScrollViewer>

            <Border Grid.Row="2"
                    CornerRadius="18"
                    Background="{Binding Type, Mode=OneWay ,Converter={x:Static converters:Converters.NotifyBrush}}"
                    Margin="32 0 32 16">

                <ui:GhostButton ui:ControlAssist.CornerRadius="18"
                                ui:ControlAssist.Icon="{StaticResource Checked}"
                                ui:ControlAssist.IconSize="23"
                                Content="{Binding OkButtonText,Mode=OneWay}"
                                Command="{Binding CompleteCommand}"
                                IconMode="Text"
                                FontSize="13"
                                Height="36"/>
            </Border>
        </Grid>
    </Border>
</shells:ForestDialog>