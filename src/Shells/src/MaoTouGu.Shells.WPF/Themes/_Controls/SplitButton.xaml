<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="urn:KinonekoSoftware/ui"
                    xmlns:this="clr-namespace:MaoTouGu.Shells.Controls">
    <Geometry x:Key="DropDown">F1 M16,16z M0,0z M16,12L16,16 12,16 16,12z</Geometry>
    <Geometry x:Key="FeatherIcon.Down">F1 M24,24z M0,0z M6,9L6,9 12,15 18,9</Geometry>
    <DropShadowEffect x:Key="MenuItem.ShadowEffect2" BlurRadius="14" Direction="270" Opacity="0.12" ShadowDepth="4.5" Color="#AA000000" />

    <SolidColorBrush x:Key="SplitButton.Border" Color="{DynamicResource Color.HighlightB5}"/>

    <Style x:Key="SplitButton.ToggleButton" TargetType="{x:Type ToggleButton}">
        <Setter Property="ui:ControlAssist.CornerRadius" Value="3" />
        <Setter Property="ui:ControlAssist.IconMargin" Value="8" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Level1}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1 0 0 0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="PART_Bd"
                            Background="{DynamicResource Brush.HighlightA5}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding ui:ControlAssist.CornerRadius}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="PART_Bd" Value="{DynamicResource Brush.HighlightA3}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" TargetName="PART_Bd" Value="{DynamicResource Brush.HighlightA4}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- SplitButton: HighlightB -->
    <Style x:Key="SplitButton.HighlightB" TargetType="{x:Type Button}">
        <Setter Property="ui:ControlAssist.CornerRadius" Value="3" />
        <Setter Property="ui:ControlAssist.Icon" Value="{x:Null}" />
        <Setter Property="ui:ControlAssist.IconSize" Value="19" />
        <Setter Property="ui:ControlAssist.IsFilled" Value="False" />
        <Setter Property="ui:ControlAssist.IconDock" Value="Left" />
        <Setter Property="ui:ControlAssist.IconMargin" Value="0" />
        <Setter Property="ui:ControlAssist.StrokeThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Brush.HighlightA4}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8 4" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="PART_Border"
                            Background="{DynamicResource Brush.HighlightA5}"
                            CornerRadius="{TemplateBinding ui:ControlAssist.CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <ContentPresenter x:Name="PART_Content"
                                          TextElement.Foreground="{DynamicResource Brush.Foreground.Level1}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="PART_Border" Value="{DynamicResource Brush.HighlightA3}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" TargetName="PART_Border" Value="{DynamicResource Brush.HighlightA4}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" TargetName="PART_Border" Value="0.2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SplitButton.Base" TargetType="{x:Type this:SplitButton}">
        <Setter Property="ui:ControlAssist.CornerRadius" Value="0" />
        <Setter Property="ui:ControlAssist.Icon" Value="{x:Null}" />
        <Setter Property="ui:ControlAssist.IconSize" Value="0" />
        <Setter Property="ui:ControlAssist.IconMargin" Value="0 0 8 0" />
        <Setter Property="ui:ControlAssist.FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Level1}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
        <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Popup.Placement" Value="Bottom" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type this:SplitButton}">
                    <Border x:Name="PART_Bd"
                            Background="{TemplateBinding Background}"
                            MinWidth="{TemplateBinding MinWidth}"
                            MinHeight="{TemplateBinding MinHeight}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0"
                            CornerRadius="{TemplateBinding ui:ControlAssist.CornerRadius}">
                        <Grid Margin="{TemplateBinding Padding}"
                              ShowGridLines="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button Grid.Column="0"
                                    Grid.Row="0"
                                    ui:ControlAssist.CornerRadius="0"
                                    Background="Transparent"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding ItemTemplate}"
                                    Command="{TemplateBinding Command}"
                                    CommandParameter="{TemplateBinding CommandParameter}"
                                    CommandTarget="{TemplateBinding CommandTarget}"
                                    Margin="0 0 0 0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Style="{StaticResource SplitButton.HighlightB}"/>
                            
                            <ToggleButton x:Name="ToggleButton"
                                          ui:ControlAssist.CornerRadius="{TemplateBinding ui:ControlAssist.CornerRadius}"
                                          Grid.Column="1"
                                          Grid.ColumnSpan="2"
                                          Grid.Row="0"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          ClickMode="Press"
                                          Focusable="False"
                                          Foreground="{TemplateBinding Foreground}"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Style="{StaticResource SplitButton.ToggleButton}" />


                            <Path x:Name="ChevronIcon"
                                  Grid.Column="1"
                                  Grid.Row="0"
                                  Data="{StaticResource FeatherIcon.Down}"
                                  IsHitTestVisible="False"
                                  Margin="4 0"
                                  RenderTransformOrigin="0.5, 0.5"
                                  Fill="{DynamicResource Brush.Foreground.Level1}"
                                  Stretch="Uniform"
                                  Width="21"
                                  Height="21">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </Path.RenderTransform>
                            </Path>

                            <Popup x:Name="Popup"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Grid.Row="1"
                                   MinWidth="280"
                                   VerticalAlignment="Center"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="{TemplateBinding Popup.Placement}"
                                   VerticalOffset="1">
                                <Border x:Name="DropDownBorder"
                                        Padding="0 16"
                                        Background="{DynamicResource Brush.Background.Level2}"
                                        BorderBrush="{DynamicResource Brush.AdaptiveLevel1}"
                                        BorderThickness="1"
                                        Margin="8"
                                        Effect="{StaticResource MenuItem.ShadowEffect2}"
                                        CornerRadius="0"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer MaxHeight="480"
                                                  HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                                  SnapsToDevicePixels="True"
                                                  TextElement.FontSize="{TemplateBinding FontSize}"
                                                  TextElement.FontWeight="{TemplateBinding FontWeight}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="DropDownBorder" Property="MinHeight" Value="84" />
                        </Trigger>
                        <Trigger SourceName="Popup" Property="Popup.AllowsTransparency" Value="False">
                            <Setter TargetName="DropDownBorder" Property="CornerRadius" Value="0" />
                        </Trigger>
                        <Trigger Property="IsGrouping" Value="True">
                            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="True" />
                                <Condition Property="IsKeyboardFocusWithin" Value="True" />
                                <Condition Property="IsEditable" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Bd" Property="Background" Value="{DynamicResource Brush.Background.Level1}" />
                            <Setter TargetName="PART_Bd" Property="BorderBrush" Value="{DynamicResource Brush.HighlightA4}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style TargetType="{x:Type this:SplitButton}" BasedOn="{StaticResource SplitButton.Base}"/>
</ResourceDictionary>