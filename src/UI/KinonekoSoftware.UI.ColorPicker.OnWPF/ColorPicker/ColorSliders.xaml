<local:PickerControlBase x:Class="ColorPicker.ColorSliders"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:i="clr-namespace:Microsoft.Xaml.Behaviors;assembly=Microsoft.Xaml.Behaviors"
                         xmlns:local="clr-namespace:ColorPicker"
                         xmlns:conv="clr-namespace:ColorPicker.Converters"
                         xmlns:ui="clr-namespace:ColorPicker.UIExtensions"
                         xmlns:behaviors="clr-namespace:ColorPicker.Behaviors"
                         mc:Ignorable="d"
                         MinWidth="200"
                         MinHeight="150"
                         x:Name="uc"
                         d:DesignHeight="150" d:DesignWidth="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/KinonekoSoftware.UI.OnWPF;component/Themes/Brushes.xaml" />
                <ResourceDictionary Source="pack://application:,,,/KinonekoSoftware.UI.OnWPF;component/Themes/Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/KinonekoSoftware.UI.ColorPicker.OnWPF;component/ColorPicker/Styles/ColorSliderStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:RangeConstrainedDoubleToDoubleConverter x:Key="HueChannelConverter" Min="0" Max="359" />
            <conv:RangeConstrainedDoubleToDoubleConverter x:Key="HundredChannelConverter" Min="0" Max="100" />
            <conv:RangeConstrainedDoubleToDoubleConverter x:Key="TwoFiftyFiveChannelConverter" Min="0" Max="255" />


            <Style TargetType="{x:Type TabItem}">
                <Setter Property="Background" Value="{DynamicResource Brush.Background.Level3}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Level1}" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="MinWidth" Value="28" />
                <Setter Property="Padding" Value="16 2" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabItem}">
                            <Border x:Name="PART_Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource Brush.HighlightB4}"
                                    BorderThickness="0 0 0 2"
                                    CornerRadius="3 3 0 0"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True">
                                <ContentPresenter x:Name="PART_Content"
                                                  TextElement.FontSize="12"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Header}"
                                                  ContentStringFormat="{TemplateBinding HeaderStringFormat}"
                                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                  Focusable="False"
                                                  Margin="0 0 0 0"
                                                  RecognizesAccessKey="True"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="IsSelected" Value="False" />
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" Value="{DynamicResource Brush.Background.Level1}" TargetName="PART_Border" />
                                </MultiTrigger>

                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.HighlightB4}" TargetName="PART_Border" />
                                    <Setter Property="CornerRadius" Value="3 3 0 0" TargetName="PART_Border" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="TextElement.Foreground" TargetName="PART_Content" Value="{DynamicResource Brush.Foreground.Disabled}" />

                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>
    <TabControl Background="{DynamicResource Brush.Background.Level3}"
                BorderThickness="0"
                Foreground="{DynamicResource Brush.Foreground.Level1}"
                Padding="0 8 0 0"
                Margin="10 0"
                MaxHeight="130"
                VerticalAlignment="Top">
        <TabItem Background="{DynamicResource Brush.Background.Level3}"
                 BorderThickness="0"
                 Header="HSV">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="45" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="20" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="20" />
                    <RowDefinition>
                        <RowDefinition.Style>
                            <Style TargetType="RowDefinition">
                                <Setter Property="Height" Value="20" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=uc, Path=ShowAlpha}" Value="False">
                                        <Setter Property="Height" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RowDefinition.Style>
                    </RowDefinition>
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0" 
                           Grid.Row="0" 
                           Text="H"
                           HorizontalAlignment="Center" />
                
                <ui:HsvColorSlider Grid.Column="1" 
                                   Grid.Row="0" 
                                   Height="12" TabIndex="1"
                                   SliderHsvType="H" 
                                   Minimum="0"
                                   Maximum="360" 
                                   IsMoveToPointEnabled="True"
                                   SmallChangeBindable="{Binding ElementName=uc, Path=SmallChange}"
                                   Value="{Binding Path=Color.HSV_H, Mode=TwoWay, ElementName=uc}" CurrentColorState="{Binding Path=ColorState, ElementName=uc}" />
                <TextBox Background="{DynamicResource Brush.Background.Level2}"
                         Foreground="{DynamicResource Brush.Foreground.Level1}"
                         BorderThickness="0"
                         TextAlignment="Center" Grid.Row="0" Grid.Column="2" Width="40" Height="18" TabIndex="5"
                         Text="{Binding Path=Color.HSV_H, Converter={StaticResource HueChannelConverter}, StringFormat=N1, ElementName=uc}">
                    <i:Interaction.Behaviors>
                        <behaviors:TextBoxFocusBehavior />
                    </i:Interaction.Behaviors>
                </TextBox>

                <TextBlock Grid.Column="0" 
                            Grid.Row="1" 
                            Text="S"
                            HorizontalAlignment="Center"/>
                
                <ui:HsvColorSlider Grid.Column="1" 
                                   Grid.Row="1" 
                                   Height="12" 
                                   TabIndex="2"
                                   SliderHsvType="S"
                                   Minimum="0"
                                   Maximum="100" 
                                   IsMoveToPointEnabled="True"
                                   SmallChangeBindable="{Binding ElementName=uc, Path=SmallChange}"
                                   Value="{Binding Path=Color.HSV_S, Mode=TwoWay, ElementName=uc}" 
                                   CurrentColorState="{Binding Path=ColorState, ElementName=uc}" />
                
                <TextBox Background="{DynamicResource Brush.Background.Level2}"
                         Foreground="{DynamicResource Brush.Foreground.Level1}"
                         BorderThickness="0"
                         TextAlignment="Center" Grid.Row="1" Grid.Column="2" Width="40" Height="18" TabIndex="6"
                         Text="{Binding Path=Color.HSV_S, Converter={StaticResource HundredChannelConverter}, ElementName=uc, StringFormat=N1}">
                    <i:Interaction.Behaviors>
                        <behaviors:TextBoxFocusBehavior />
                    </i:Interaction.Behaviors>
                </TextBox>

                <TextBlock Grid.Column="0" 
                           Grid.Row="2" 
                           Text="V" 
                           HorizontalAlignment="Center" />
                <ui:HsvColorSlider Grid.Column="1" 
                                   Grid.Row="2" 
                                   Height="12" 
                                   TabIndex="3"
                                   SliderHsvType="V" 
                                   Minimum="0"
                                   Maximum="100"
                                   IsMoveToPointEnabled="True"
                                   SmallChangeBindable="{Binding ElementName=uc, Path=SmallChange}"
                                   Value="{Binding Path=Color.HSV_V, Mode=TwoWay, ElementName=uc}" 
                                   CurrentColorState="{Binding Path=ColorState, ElementName=uc}" />
                <TextBox Background="{DynamicResource Brush.Background.Level2}"
                         Foreground="{DynamicResource Brush.Foreground.Level1}"
                         BorderThickness="0"
                         TextAlignment="Center" Grid.Row="2" Grid.Column="2" Width="40" Height="18" TabIndex="7"
                         Text="{Binding Path=Color.HSV_V, Converter={StaticResource HundredChannelConverter}, ElementName=uc, StringFormat=N1}">
                    <i:Interaction.Behaviors>
                        <behaviors:TextBoxFocusBehavior />
                    </i:Interaction.Behaviors>
                </TextBox>

                <TextBlock Grid.Column="0" 
                           Grid.Row="3" 
                           Text="A" 
                           HorizontalAlignment="Center" />
                
                <Grid Grid.Column="1"
                      Grid.Row="3"
                      Height="12">
                    <ui:RgbColorSlider SliderArgbType="A" Minimum="0" Maximum="255" IsMoveToPointEnabled="True" TabIndex="4"
                                       IsEnabled="{Binding ElementName=uc, Path=ShowAlpha}"
                                       SmallChangeBindable="{Binding ElementName=uc, Path=SmallChange}"
                                       Value="{Binding Path=Color.A, Mode=TwoWay, ElementName=uc}" CurrentColorState="{Binding Path=ColorState, ElementName=uc}" />
                    <Border BorderThickness="0" CornerRadius="5" Panel.ZIndex="-1" RenderOptions.BitmapScalingMode="NearestNeighbor">
                        <Border.Background>
                            <ImageBrush ImageSource="pack://application:,,,/KinonekoSoftware.UI.ColorPicker.OnWPF;component/Images/transparentbg_mini.png" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute" />
                        </Border.Background>
                    </Border>
                </Grid>
                <TextBox Background="{DynamicResource Brush.Background.Level2}"
                         Foreground="{DynamicResource Brush.Foreground.Level1}"
                         BorderThickness="0"
                         TextAlignment="Center" Grid.Row="3" Grid.Column="2" Width="40" Height="18" TabIndex="8"
                         IsEnabled="{Binding ElementName=uc, Path=ShowAlpha}"
                         Text="{Binding Path=Color.A, Converter={StaticResource TwoFiftyFiveChannelConverter}, ElementName=uc, StringFormat=N0}">
                    <i:Interaction.Behaviors>
                        <behaviors:TextBoxFocusBehavior />
                    </i:Interaction.Behaviors>
                </TextBox>
            </Grid>
        </TabItem>
        <TabItem Background="{DynamicResource Brush.Background.Level3}"
                 BorderThickness="0"
                 Header="HSL">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="45" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="20" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="20" />
                    <RowDefinition>
                        <RowDefinition.Style>
                            <Style TargetType="RowDefinition">
                                <Setter Property="Height" Value="20" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=uc, Path=ShowAlpha}" Value="False">
                                        <Setter Property="Height" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RowDefinition.Style>
                    </RowDefinition>
                </Grid.RowDefinitions>

                <TextBlock Text="H" HorizontalAlignment="Center" Grid.Row="0" Grid.Column="0" />
                <ui:HslColorSlider Height="12" Grid.Row="0" Grid.Column="1" TabIndex="1"
                                   SliderHslType="H" Minimum="0" Maximum="360" IsMoveToPointEnabled="True"
                                   SmallChangeBindable="{Binding ElementName=uc, Path=SmallChange}"
                                   Value="{Binding Path=Color.HSL_H, Mode=TwoWay, ElementName=uc}" CurrentColorState="{Binding Path=ColorState, ElementName=uc}" />
                <TextBox Background="{DynamicResource Brush.Background.Level2}"
                         Foreground="{DynamicResource Brush.Foreground.Level1}"
                         BorderThickness="0"
                         TextAlignment="Center" Grid.Row="0" Grid.Column="2" Width="40" Height="18" TabIndex="5"
                         Text="{Binding Path=Color.HSL_H, Converter={StaticResource HueChannelConverter}, StringFormat=N1, ElementName=uc}">
                    <i:Interaction.Behaviors>
                        <behaviors:TextBoxFocusBehavior />
                    </i:Interaction.Behaviors>
                </TextBox>

                <TextBlock Text="S" HorizontalAlignment="Center" Grid.Row="1" Grid.Column="0" />
                <ui:HslColorSlider Height="12" Grid.Row="1" Grid.Column="1" TabIndex="2"
                                   SliderHslType="S" Minimum="0" Maximum="100" IsMoveToPointEnabled="True"
                                   SmallChangeBindable="{Binding ElementName=uc, Path=SmallChange}"
                                   Value="{Binding Path=Color.HSL_S, Mode=TwoWay, ElementName=uc}" CurrentColorState="{Binding Path=ColorState, ElementName=uc}" />
                <TextBox Background="{DynamicResource Brush.Background.Level2}"
                         Foreground="{DynamicResource Brush.Foreground.Level1}"
                         BorderThickness="0"
                         TextAlignment="Center" Grid.Row="1" Grid.Column="2" Width="40" Height="18" TabIndex="6"
                         Text="{Binding Path=Color.HSL_S, Converter={StaticResource HundredChannelConverter}, ElementName=uc, StringFormat=N1}">
                    <i:Interaction.Behaviors>
                        <behaviors:TextBoxFocusBehavior />
                    </i:Interaction.Behaviors>
                </TextBox>

                <TextBlock Text="L" HorizontalAlignment="Center" Grid.Row="2" Grid.Column="0" />
                <ui:HslColorSlider Height="12" Grid.Row="2" Grid.Column="1" TabIndex="3"
                                   SliderHslType="L" Minimum="0" Maximum="100" IsMoveToPointEnabled="True"
                                   SmallChangeBindable="{Binding ElementName=uc, Path=SmallChange}"
                                   Value="{Binding Path=Color.HSL_L, Mode=TwoWay, ElementName=uc}" CurrentColorState="{Binding Path=ColorState, ElementName=uc}" />
                <TextBox Background="{DynamicResource Brush.Background.Level2}"
                         Foreground="{DynamicResource Brush.Foreground.Level1}"
                         BorderThickness="0"
                         TextAlignment="Center" Grid.Row="2" Grid.Column="2" Width="40" Height="18" TabIndex="7"
                         Text="{Binding Path=Color.HSL_L, Converter={StaticResource HundredChannelConverter}, ElementName=uc, StringFormat=N1}">
                    <i:Interaction.Behaviors>
                        <behaviors:TextBoxFocusBehavior />
                    </i:Interaction.Behaviors>
                </TextBox>

                <TextBlock Text="A" HorizontalAlignment="Center" Grid.Row="3" Grid.Column="0" />
                <Grid Height="12" Grid.Row="3" Grid.Column="1">
                    <ui:RgbColorSlider SliderArgbType="A" Minimum="0" Maximum="255" IsMoveToPointEnabled="True" IsEnabled="{Binding ElementName=uc, Path=ShowAlpha}" TabIndex="4"
                                       SmallChangeBindable="{Binding ElementName=uc, Path=SmallChange}"
                                       Value="{Binding Path=Color.A, Mode=TwoWay, ElementName=uc}" CurrentColorState="{Binding Path=ColorState, ElementName=uc}" />
                    <Border BorderThickness="0" CornerRadius="5" Panel.ZIndex="-1" RenderOptions.BitmapScalingMode="NearestNeighbor">
                        <Border.Background>
                            <ImageBrush ImageSource="pack://application:,,,/KinonekoSoftware.UI.ColorPicker.OnWPF;component/Images/transparentbg_mini.png" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute" />
                        </Border.Background>
                    </Border>
                </Grid>
                <TextBox Background="{DynamicResource Brush.Background.Level2}"
                         Foreground="{DynamicResource Brush.Foreground.Level1}"
                         BorderThickness="0"
                         TextAlignment="Center" Grid.Row="3" Grid.Column="2" Width="40" Height="18" TabIndex="8"
                         IsEnabled="{Binding ElementName=uc, Path=ShowAlpha}"
                         Text="{Binding Path=Color.A, Converter={StaticResource TwoFiftyFiveChannelConverter}, ElementName=uc, StringFormat=N0}">
                    <i:Interaction.Behaviors>
                        <behaviors:TextBoxFocusBehavior />
                    </i:Interaction.Behaviors>
                </TextBox>
            </Grid>
        </TabItem>
        <TabItem Background="{DynamicResource Brush.Background.Level3}"
                 BorderThickness="0"
                 Header="RGB">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="45" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="20" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="20" />
                    <RowDefinition>
                        <RowDefinition.Style>
                            <Style TargetType="RowDefinition">
                                <Setter Property="Height" Value="20" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=uc, Path=ShowAlpha}" Value="False">
                                        <Setter Property="Height" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RowDefinition.Style>
                    </RowDefinition>
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0"
                           Grid.Row="0"
                           Text="R"
                           HorizontalAlignment="Center" />
                <ui:RgbColorSlider Grid.Column="1"
                                   Grid.Row="0"
                                   Height="12"
                                   TabIndex="1"
                                   SliderArgbType="R"
                                   Minimum="0"
                                   Maximum="255"
                                   IsMoveToPointEnabled="True"
                                   SmallChangeBindable="{Binding ElementName=uc, Path=SmallChange}"
                                   Value="{Binding Path=Color.RGB_R, Mode=TwoWay, ElementName=uc}"
                                   CurrentColorState="{Binding Path=ColorState, ElementName=uc}" />
                <TextBox Grid.Column="2"
                         Grid.Row="0"
                         Background="{DynamicResource Brush.Background.Level2}"
                         Foreground="{DynamicResource Brush.Foreground.Level1}"
                         BorderThickness="0"
                         TextAlignment="Center"
                         Width="40"
                         Height="18"
                         TabIndex="5"
                         Text="{Binding Path=Color.RGB_R, Converter={StaticResource TwoFiftyFiveChannelConverter}, StringFormat=N0, ElementName=uc}">
                    <i:Interaction.Behaviors>
                        <behaviors:TextBoxFocusBehavior />
                    </i:Interaction.Behaviors>
                </TextBox>

                <TextBlock Grid.Column="0"
                           Grid.Row="1"
                           Text="G"
                           HorizontalAlignment="Center" />
                <ui:RgbColorSlider Grid.Column="1"
                                   Grid.Row="1"
                                   Height="12"
                                   TabIndex="2"
                                   SliderArgbType="G"
                                   Minimum="0"
                                   Maximum="255"
                                   IsMoveToPointEnabled="True"
                                   SmallChangeBindable="{Binding ElementName=uc, Path=SmallChange}"
                                   Value="{Binding Path=Color.RGB_G, Mode=TwoWay, ElementName=uc}"
                                   CurrentColorState="{Binding Path=ColorState, ElementName=uc}" />
                <TextBox Grid.Column="2"
                         Grid.Row="1"
                         Background="{DynamicResource Brush.Background.Level2}"
                         Foreground="{DynamicResource Brush.Foreground.Level1}"
                         BorderThickness="0"
                         TextAlignment="Center" Width="40" Height="18" TabIndex="6"
                         Text="{Binding Path=Color.RGB_G, Converter={StaticResource TwoFiftyFiveChannelConverter}, ElementName=uc, StringFormat=N0}">
                    <i:Interaction.Behaviors>
                        <behaviors:TextBoxFocusBehavior />
                    </i:Interaction.Behaviors>
                </TextBox>

                <TextBlock Grid.Column="0"
                           Grid.Row="2"
                           Text="B"
                           HorizontalAlignment="Center" />
                <ui:RgbColorSlider Grid.Column="1"
                                   Grid.Row="2"
                                   Height="12"
                                   TabIndex="3"
                                   SliderArgbType="B"
                                   Minimum="0"
                                   Maximum="255"
                                   IsMoveToPointEnabled="True"
                                   SmallChangeBindable="{Binding ElementName=uc, Path=SmallChange}"
                                   Value="{Binding Path=Color.RGB_B, Mode=TwoWay, ElementName=uc}"
                                   CurrentColorState="{Binding Path=ColorState, ElementName=uc}" />
                <TextBox Grid.Column="2"
                         Grid.Row="2"
                         Background="{DynamicResource Brush.Background.Level2}"
                         Foreground="{DynamicResource Brush.Foreground.Level1}"
                         BorderThickness="0"
                         TextAlignment="Center"
                         Width="40"
                         Height="18"
                         TabIndex="7"
                         Text="{Binding Path=Color.RGB_B, Converter={StaticResource TwoFiftyFiveChannelConverter}, ElementName=uc, StringFormat=N0}">
                    <i:Interaction.Behaviors>
                        <behaviors:TextBoxFocusBehavior />
                    </i:Interaction.Behaviors>
                </TextBox>

                <TextBlock Grid.Column="0"
                           Grid.Row="3"
                           Text="A"
                           HorizontalAlignment="Center" />
                <Grid Grid.Column="1"
                      Grid.Row="3"
                      Height="12">
                    <ui:RgbColorSlider SliderArgbType="A"
                                       Minimum="0"
                                       Maximum="255"
                                       IsMoveToPointEnabled="True"
                                       TabIndex="4"
                                       IsEnabled="{Binding ElementName=uc, Path=ShowAlpha}"
                                       SmallChangeBindable="{Binding ElementName=uc, Path=SmallChange}"
                                       Value="{Binding Path=Color.A, Mode=TwoWay, ElementName=uc}"
                                       CurrentColorState="{Binding Path=ColorState, ElementName=uc}" />
                    <Border Panel.ZIndex="-1"
                            RenderOptions.BitmapScalingMode="NearestNeighbor"
                            BorderThickness="0"
                            CornerRadius="5">
                        <Border.Background>
                            <ImageBrush ImageSource="pack://application:,,,/KinonekoSoftware.UI.ColorPicker.OnWPF;component/Images/transparentbg_mini.png"
                                        TileMode="Tile"
                                        Viewport="0,0,8,8"
                                        ViewportUnits="Absolute" />
                        </Border.Background>
                    </Border>
                </Grid>
                <TextBox Background="{DynamicResource Brush.Background.Level2}"
                         Foreground="{DynamicResource Brush.Foreground.Level1}"
                         BorderThickness="0"
                         TextAlignment="Center" Grid.Row="3" Grid.Column="2" Width="40" Height="18"
                         IsEnabled="{Binding ElementName=uc, Path=ShowAlpha}" TabIndex="8"
                         Text="{Binding Path=Color.A, Converter={StaticResource TwoFiftyFiveChannelConverter}, ElementName=uc, StringFormat=N0}">
                    <i:Interaction.Behaviors>
                        <behaviors:TextBoxFocusBehavior />
                    </i:Interaction.Behaviors>
                </TextBox>
            </Grid>
        </TabItem>
    </TabControl>
</local:PickerControlBase>