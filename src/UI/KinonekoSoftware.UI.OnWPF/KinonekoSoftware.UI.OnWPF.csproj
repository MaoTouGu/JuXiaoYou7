<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0-windows</TargetFramework>
        <Nullable>disable</Nullable>
        <UseWPF>true</UseWPF>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>KinonekoSoftware.UI</RootNamespace>
        <GeneratePackageOnBuild Condition="$(Configuration)== 'Release'">True</GeneratePackageOnBuild>
        <PackageId>KinonekoSoftware.UI.OnWPF</PackageId>
        <Title>KinonekoSoftware.Foundation.OnWPF</Title>
        <Description>ColorPicker基础设施库（适用于Windows）。</Description>
        <Copyright>All copyright reserved by luoyisi</Copyright>
        <PackageTags>Foundation</PackageTags>
        <Version>7.0.0</Version>
        <AssemblyVersion>7.0.0</AssemblyVersion>
        <FileVersion>7.0.0.0</FileVersion>
        <RootNamespace>KinonekoSoftware.UI</RootNamespace>
        <OutputPath>../../../builds/nuget</OutputPath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\KinonekoSoftware.UI\KinonekoSoftware.UI.csproj" />
    </ItemGroup>

    
</Project>
