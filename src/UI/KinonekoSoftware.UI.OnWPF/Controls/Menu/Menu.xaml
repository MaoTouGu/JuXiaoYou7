<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:KinonekoSoftware.UI.Controls"
                    xmlns:root="clr-namespace:KinonekoSoftware.UI.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/KinonekoSoftware.UI.OnWPF;component/Themes/Dark.xaml" />
    </ResourceDictionary.MergedDictionaries>


    <DropShadowEffect x:Key="MenuItem.ShadowEffect" BlurRadius="14" Direction="270" Opacity="0.12" ShadowDepth="1.5" Color="#AA000000" />
    <DropShadowEffect x:Key="MenuItem.ShadowEffect2" BlurRadius="14" Direction="270" Opacity="0.12" ShadowDepth="4.5" Color="#AA000000" />

    <Style x:Key="ClearStyle.Menu" TargetType="{x:Type root:MainMenu}">
        <Setter Property="ui:ControlAssist.CornerRadius" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Level1}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Level3}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AdaptiveLevel1}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type root:MainMenu}">
                    <Border x:Name="PART_Border"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Margin="0"
                            CornerRadius="{TemplateBinding ui:ControlAssist.CornerRadius}">
                        <StackPanel ClipToBounds="True"
                                    IsItemsHost="True"
                                    Orientation="Horizontal" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MenuItem.ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}" TargetType="{x:Type ScrollViewer}">
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Margin" Value="0 4" />
        <Setter Property="BorderThickness" Value="1,1,0,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border Width="{TemplateBinding Width}"
                            Margin="{TemplateBinding Margin}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="MenuItem.TopLevelHeaderTemplateKey" TargetType="{x:Type root:MenuItem}">
        <Border x:Name="PART_Border"
                Background="Transparent"
                CornerRadius="0"
                Padding="8 0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:Iconify x:Name="PART_Icon"
                            Icon="{TemplateBinding Icon}"
                            IsFilled="{TemplateBinding IsFilled}"
                            StrokeThickness="{TemplateBinding StrokeThickness}"
                            IconSize="{TemplateBinding IconSize}" />

                <ContentPresenter x:Name="PART_Content"
                                  Grid.Column="1"
                                  Grid.Row="0"
                                  Margin="8 0"
                                  VerticalAlignment="Center"
                                  ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  TextElement.Foreground="{DynamicResource Brush.Foreground.Level1}"
                                  TextElement.FontSize="13" />
                <Popup x:Name="Popup"
                       Grid.Row="1"
                       Grid.Column="0"
                       AllowsTransparency="True"
                       Focusable="False"
                       HorizontalOffset="-12"
                       IsOpen="{TemplateBinding IsSubmenuOpen}"
                       Placement="Bottom"
                       PopupAnimation="Slide"
                       VerticalOffset="1"
                       PlacementTarget="{Binding ElementName=Border}">
                    <Grid Effect="{StaticResource MenuItem.ShadowEffect2}"
                          Margin="8 8 8 16">
                        <Border x:Name="SubmenuBorder"
                                Background="{DynamicResource Brush.Background.Level2}"
                                BorderBrush="{DynamicResource Brush.AdaptiveLevel1}"
                                BorderThickness="1"
                                SnapsToDevicePixels="True"
                                Padding="0 16"
                                MinWidth="192">
                            <ScrollViewer CanContentScroll="True"
                                          VerticalScrollBarVisibility="Auto"
                                          Style="{StaticResource MenuItem.ScrollViewer}">
                                <StackPanel IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Overlay100}" TargetName="PART_Border" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Foreground.Level1}" TargetName="PART_Content" />
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Overlay200}" TargetName="PART_Border" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Foreground.Level1}" TargetName="PART_Content" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent" TargetName="PART_Border" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Foreground.Disabled}" TargetName="PART_Content" />
            </Trigger>
            <Trigger Property="IsSuspendingPopupAnimation" Value="True">
                <Setter TargetName="Popup" Property="PopupAnimation" Value="None" />
            </Trigger>
            <Trigger Value="{x:Null}" Property="Header">
                <Setter TargetName="PART_Icon" Property="Margin" Value="0" />
                <Setter TargetName="PART_Content" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Overlay100}" TargetName="PART_Border" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Disabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="MenuItem.TopLevelItemTemplateKey" TargetType="{x:Type root:MenuItem}">
        <Border x:Name="PART_Border"
                Margin="4"
                Background="Transparent"
                CornerRadius="6">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="PART_IconColumn" Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:Iconify x:Name="PART_Icon"
                            Grid.Column="0"
                            Margin="0,0,6,0"
                            Icon="{TemplateBinding Icon}"
                            IsFilled="{TemplateBinding IsFilled}"
                            StrokeThickness="{TemplateBinding StrokeThickness}"
                            IconSize="{TemplateBinding IconSize}"
                            Height="{TemplateBinding IconSize}"
                            VerticalAlignment="Center" />

                <Path x:Name="CheckIcon"
                      Grid.Column="0"
                      Data="F1 M24,24z M0,0z M20,6L20,6 9,17 4,12"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Stretch="Uniform"
                      Height="17"
                      Width="17"
                      Visibility="Collapsed" />

                <ContentPresenter x:Name="PART_Content"
                                  Grid.Column="1"
                                  Margin="8 0"
                                  VerticalAlignment="Center"
                                  ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  TextElement.Foreground="{DynamicResource Brush.Foreground.Level1}"
                                  TextElement.FontSize="13" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Overlay100}" TargetName="PART_Border" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsCheckable" Value="True" />
                    <Condition Property="IsChecked" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_Icon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible" />
                <Setter TargetName="CheckIcon" Property="Margin" Value="0,0,6,0" />
            </MultiTrigger>
            <Trigger Property="IsCheckable" Value="True">
                <Setter TargetName="PART_IconColumn" Property="Width" Value="23" />
            </Trigger>
            <Trigger Property="IsCheckable" Value="False">
                <Setter TargetName="PART_Icon" Property="Visibility" Value="Visible" />
                <Setter TargetName="CheckIcon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Value="Text" Property="IconMode">
                <Setter TargetName="PART_Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Value="{x:Null}" Property="Header">
                <Setter TargetName="PART_Icon" Property="Margin" Value="0" />
                <Setter TargetName="PART_Content" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Disabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="MenuItem.SubmenuItemTemplateKey" TargetType="{x:Type root:MenuItem}">
        <Border x:Name="PART_Border"
                Background="Transparent"
                Padding="16 8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="23" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
                </Grid.ColumnDefinitions>
                <Path x:Name="CheckIcon"
                      Grid.Column="0"
                      Data="F1 M24,24z M0,0z M20,6L20,6 9,17 4,12"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Stroke="{TemplateBinding Foreground}"
                      StrokeThickness="1"
                      Stretch="Uniform"
                      Height="17"
                      Width="17"
                      Visibility="Collapsed" />

                <ui:Iconify x:Name="PART_Icon"
                            Grid.Column="0"
                            Icon="{TemplateBinding Icon}"
                            IsFilled="{TemplateBinding IsFilled}"
                            StrokeThickness="{TemplateBinding StrokeThickness}"
                            IconSize="{TemplateBinding IconSize}" />


                <ContentPresenter Grid.Column="1"
                                  ContentSource="Header"
                                  Margin="8 0"
                                  RecognizesAccessKey="True"
                                  VerticalAlignment="Center"
                                  TextElement.Foreground="{DynamicResource Brush.Foreground.Level1}"
                                  TextElement.FontSize="13" />

                <TextBlock x:Name="InputGestureText"
                           Grid.Column="2"
                           Margin="25,0,0,0"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Right"
                           TextElement.FontSize="13"
                           TextElement.Foreground="{TemplateBinding Foreground}"
                           Text="{TemplateBinding InputGestureText}" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Overlay100}" TargetName="PART_Border" />
            </Trigger>
            <Trigger Property="IconMode" Value="Text">
                <Setter TargetName="PART_Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsCheckable" Value="True" />
                    <Condition Property="IsChecked" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible" />
                <Setter TargetName="CheckIcon" Property="Margin" Value="0,0,6,0" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Disabled}" />
            </Trigger>
            <Trigger Property="MenuItem.InputGestureText" Value="">
                <Setter TargetName="InputGestureText" Property="Visibility" Value="Collapsed" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="MenuItem.SubmenuHeaderTemplateKey" TargetType="{x:Type root:MenuItem}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border x:Name="PART_Border"
                    Grid.Row="1"
                    Padding="16 8">
                <Grid x:Name="MenuItemContent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="23" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="23" />
                    </Grid.ColumnDefinitions>

                    <Path x:Name="PART_Icon"
                          Grid.Column="0"
                          Margin="0,0,6,0"
                          Data="{TemplateBinding Icon}"
                          Stretch="Uniform"
                          Height="{TemplateBinding IconSize}"
                          Width="{TemplateBinding IconSize}"
                          VerticalAlignment="Center" />

                    <ContentPresenter x:Name="HeaderHost"
                                      Grid.Column="1"
                                      ContentSource="Header"
                                      Margin="8 0"
                                      RecognizesAccessKey="True"
                                      VerticalAlignment="Center"
                                      TextElement.FontSize="13" 
                                      TextElement.Foreground="{DynamicResource Brush.Foreground.Level1}"/>

                    <Path x:Name="Chevron"
                          Grid.Column="2"
                          Data="F1 M24,24z M0,0z M9,18L9,18 15,12 9,6"
                          Stroke="{TemplateBinding Foreground}"
                          StrokeThickness="1"
                          Stretch="Uniform"
                          Height="19"
                          Width="19"
                          VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Popup x:Name="Popup"
                   Grid.Row="1"
                   AllowsTransparency="True"
                   Focusable="False"
                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                   Placement="Right"
                   PopupAnimation="Slide"
                   VerticalOffset="-20"
                   PlacementTarget="{Binding ElementName=MenuItemContent}">
                <Grid Effect="{StaticResource MenuItem.ShadowEffect2}"
                      Margin="8 8 8 16">
                        <Border x:Name="SubmenuBorder"
                                Background="{DynamicResource Brush.Background.Level2}"
                                BorderBrush="{DynamicResource Brush.AdaptiveLevel1}"
                                BorderThickness="1"
                                SnapsToDevicePixels="True"
                                Padding="0 16"
                                MinWidth="192">
                        <ScrollViewer CanContentScroll="True"
                                      VerticalScrollBarVisibility="Auto"
                                      Style="{StaticResource MenuItem.ScrollViewer}">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Value="Text" Property="IconMode">
                <Setter TargetName="PART_Icon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PART_Icon" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="true">
                <Setter Property="Background" Value="{DynamicResource Brush.Overlay100}" TargetName="PART_Border" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Disabled}" />
                <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource Brush.Foreground.Disabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="ClearStyle.MenuItem" TargetType="{x:Type root:MenuItem}">
        <Style.Triggers>
            <Trigger Property="MenuItem.Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{StaticResource MenuItem.TopLevelHeaderTemplateKey}" />
                <Setter Property="Grid.IsSharedSizeScope" Value="True" />
            </Trigger>
            <Trigger Property="MenuItem.Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{StaticResource MenuItem.TopLevelItemTemplateKey}" />
            </Trigger>
            <Trigger Property="MenuItem.Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource MenuItem.SubmenuHeaderTemplateKey}" />
            </Trigger>
            <Trigger Property="MenuItem.Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{StaticResource MenuItem.SubmenuItemTemplateKey}" />
            </Trigger>
        </Style.Triggers>
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="KeyboardNavigation.IsTabStop" Value="True" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="IconSize" Value="17" />
    </Style>

    <Style x:Key="ClearStyle.ContextMenu" TargetType="{x:Type root:ContextMenu}">
        <Setter Property="ui:ControlAssist.CornerRadius" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Level1}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Level2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AdaptiveLevel1}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinWidth" Value="140" />
        <Setter Property="Padding" Value="0 7" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type root:ContextMenu}">
                    <Border x:Name="PART_Border"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Margin="16 4 16 16"
                            Effect="{StaticResource MenuItem.ShadowEffect2}"
                            CornerRadius="{TemplateBinding ui:ControlAssist.CornerRadius}">
                        <StackPanel ClipToBounds="True"
                                    IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle"
                                    Orientation="Vertical" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ClearStyle.Menu.WPF" TargetType="{x:Type Menu}">
        <Setter Property="ui:ControlAssist.CornerRadius" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Level1}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Level2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AdaptiveLevel1}" />
        <Setter Property="MinWidth" Value="140" />
        <Setter Property="Padding" Value="0 7" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Menu}">
                    <Border x:Name="PART_Border"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Margin="16 4 16 16"
                            Effect="{StaticResource MenuItem.ShadowEffect2}"
                            CornerRadius="{TemplateBinding ui:ControlAssist.CornerRadius}">
                        <StackPanel ClipToBounds="True"
                                    IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle"
                                    Orientation="Horizontal" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style BasedOn="{StaticResource ClearStyle.MenuItem}" TargetType="{x:Type root:MenuItem}" />
    <Style BasedOn="{StaticResource ClearStyle.ContextMenu}" TargetType="{x:Type root:ContextMenu}" />
    <Style BasedOn="{StaticResource ClearStyle.Menu.WPF}" TargetType="{x:Type Menu}" />
    <Style BasedOn="{StaticResource ClearStyle.Menu}" TargetType="{x:Type root:MainMenu}" />
</ResourceDictionary>