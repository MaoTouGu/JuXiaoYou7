    <!-- OptionButton -->
    <Style x:Key="OptionButton.Base" TargetType="{x:Type b:OptionButton}">
        <Setter Property="this:ControlAssist.CornerRadius" Value="3" />
        <Setter Property="this:ControlAssist.Icon" Value="{x:Null}" />
        <Setter Property="this:ControlAssist.IconSize" Value="12" />
        <Setter Property="this:ControlAssist.IsFilled" Value="False" />
        <Setter Property="this:ControlAssist.IconDock" Value="Left" />
        <Setter Property="this:ControlAssist.IconMargin" Value="0 0 0 0" />
        <Setter Property="this:ControlAssist.StrokeThickness" Value="2" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Level1}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Level2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Background.Level2}" />
        <Setter Property="HighlightState" Value="{DynamicResource Brush.HighlightA4}" />
        <Setter Property="HoverState" Value="{DynamicResource Brush.HighlightA2}" />
        <Setter Property="DisabledState" Value="{DynamicResource Brush.HighlightA1}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8 4" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="MinWidth" Value="84" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type b:OptionButton}">
                    <p:TilePanel Margin="0">
                        <Border x:Name="PART_Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding this:ControlAssist.CornerRadius}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                            <ContentPresenter x:Name="PART_Content"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>

                        <Border x:Name="PART_Mark"
                                DockPanel.Dock="Top"
                                Background="Transparent"
                                CornerRadius="16"
                                Padding="4"
                                Margin="6"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Visibility="Collapsed">
                            <Path x:Name="PART_Icon"
                                  Data="{StaticResource Checked}"
                                  Stroke="White"
                                  StrokeThickness="{TemplateBinding this:ControlAssist.StrokeThickness}"
                                  Stretch="Uniform"
                                  Height="{TemplateBinding this:ControlAssist.IconSize}"
                                  Width="{TemplateBinding this:ControlAssist.IconSize}" />
                        </Border>
                    </p:TilePanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" TargetName="PART_Border" Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=HoverState}" />
                            <Setter Property="Background" TargetName="PART_Mark" Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=HoverState}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter Property="Data" TargetName="PART_Icon" Value="{StaticResource Minus}" />
                            <Setter Property="BorderBrush" TargetName="PART_Border" Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=HighlightState}" />
                            <Setter Property="Background" TargetName="PART_Mark" Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=HighlightState}" />
                            <Setter Property="Visibility" TargetName="PART_Mark" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="BorderBrush" TargetName="PART_Border" Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=HighlightState}" />
                            <Setter Property="Background" TargetName="PART_Mark" Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=HighlightState}" />
                            <Setter Property="Visibility" TargetName="PART_Mark" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" TargetName="PART_Mark" Value="{DynamicResource Brush.Background.Disabled}" />
                            <Setter Property="Visibility" TargetName="PART_Mark" Value="Collapsed" />
                            <Setter Property="TextElement.Foreground" TargetName="PART_Content" Value="{DynamicResource Brush.Foreground.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToggleSwitch -->
    <Style TargetType="{x:Type b:ToggleSwitch}">
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Level3}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Level1}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type b:ToggleSwitch}">
                    <Border Background="Transparent"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="1"
                                  Width="40"
                                  Height="20"
                                  Margin="0 0 0 0"
                                  VerticalAlignment="Top">
                                <Rectangle x:Name="ToggleRectangle"
                                           Width="40"
                                           Height="20"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Fill="Transparent"
                                           RadiusX="10"
                                           RadiusY="10"
                                           StrokeThickness="1"
                                           Stroke="{DynamicResource Brush.AdaptiveLevel2}" />
                                <Rectangle x:Name="ActiveToggleRectangle"
                                           Width="40"
                                           Height="20"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Fill="{DynamicResource Brush.HighlightB4}"
                                           Opacity="0.0"
                                           RadiusX="10"
                                           RadiusY="10"
                                           StrokeThickness="0" />
                                <Ellipse x:Name="ToggleEllipse"
                                         Width="12"
                                         Height="12"
                                         Margin="0"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         RenderTransformOrigin="0.5, 0.5"
                                         Fill="{DynamicResource Brush.AdaptiveLevel2}">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="-9" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="ActiveToggleEllipse"
                                         Width="12" Height="12"
                                         Margin="0"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Opacity="0.0"
                                         RenderTransformOrigin="0.5, 0.5"
                                         Fill="White">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="-9" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ToggleRectangle"
                                                         Storyboard.TargetProperty="(Rectangle.Opacity)"
                                                         From="1"
                                                         To="0"
                                                         Duration="00:00:00.167" />
                                        <DoubleAnimation Storyboard.TargetName="ActiveToggleRectangle"
                                                         Storyboard.TargetProperty="(Rectangle.Opacity)"
                                                         From="0.0"
                                                         To="1.0" Duration="00:00:00.167" />
                                        <DoubleAnimation Storyboard.TargetName="ToggleEllipse"
                                                         Storyboard.TargetProperty="(Ellipse.Opacity)"
                                                         From="1.0"
                                                         To="0.0" Duration="00:00:00.167" />
                                        <DoubleAnimation Storyboard.TargetName="ActiveToggleEllipse"
                                                         Storyboard.TargetProperty="(Ellipse.Opacity)"
                                                         From="0.0"
                                                         To="1.0"
                                                         Duration="00:00:00.167" />
                                        <DoubleAnimation Storyboard.TargetName="ToggleEllipse"
                                                         Storyboard.TargetProperty="(Ellipse.RenderTransform).(TranslateTransform.X)"
                                                         From="-9"
                                                         To="9"
                                                         Duration="00:00:00.167" />
                                        <DoubleAnimation Storyboard.TargetName="ActiveToggleEllipse"
                                                         Storyboard.TargetProperty="(Ellipse.RenderTransform).(TranslateTransform.X)"
                                                         From="-9"
                                                         To="9"
                                                         Duration="00:00:00.167" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ToggleRectangle"
                                                         Storyboard.TargetProperty="(Rectangle.Opacity)"
                                                         From="0.0"
                                                         To="1.0"
                                                         Duration="00:00:00.167" />
                                        <DoubleAnimation Storyboard.TargetName="ActiveToggleRectangle"
                                                         Storyboard.TargetProperty="(Rectangle.Opacity)"
                                                         From="1.0"
                                                         To="0.0"
                                                         Duration="00:00:00.167" />
                                        <DoubleAnimation Storyboard.TargetName="ToggleEllipse"
                                                         Storyboard.TargetProperty="(Ellipse.Opacity)"
                                                         From="0.0"
                                                         To="1.0"
                                                         Duration="00:00:00.167" />
                                        <DoubleAnimation Storyboard.TargetName="ActiveToggleEllipse"
                                                         Storyboard.TargetProperty="(Ellipse.Opacity)"
                                                         From="1.0"
                                                         To="0.0"
                                                         Duration="00:00:00.167" />
                                        <DoubleAnimation Storyboard.TargetName="ToggleEllipse"
                                                         Storyboard.TargetProperty="(Ellipse.RenderTransform).(TranslateTransform.X)"
                                                         From="9"
                                                         To="-9"
                                                         Duration="00:00:00.167" />
                                        <DoubleAnimation Storyboard.TargetName="ActiveToggleEllipse"
                                                         Storyboard.TargetProperty="(Ellipse.RenderTransform).(TranslateTransform.X)"
                                                         From="9"
                                                         To="-9"
                                                         Duration="00:00:00.167" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ToggleRectangle"
                                    Property="Fill"
                                    Value="{DynamicResource Brush.Background.Level4}" />
                            <Setter TargetName="ToggleEllipse"
                                    Property="Fill"
                                    Value="{DynamicResource Brush.AdaptiveLevel1}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IsEnabled" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ToggleRectangle" Value="{DynamicResource Brush.AdaptiveLevel1}" Property="Stroke" />
                            <Setter TargetName="ToggleRectangle" Value="{DynamicResource Brush.AdaptiveLevel1}" Property="Fill" />
                            <Setter TargetName="ToggleEllipse" Value="{DynamicResource Brush.Background.Disabled}" Property="Fill" />
                            <Setter Value="{DynamicResource Brush.Foreground.Disabled}" Property="Foreground" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ToggleButton.IsChecked" Value="True" />
                                <Condition Property="IsEnabled" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ActiveToggleRectangle"
                                    Property="Fill"
                                    Value="{DynamicResource Brush.HighlightA1}" />
                            <Setter TargetName="ActiveToggleEllipse"
                                    Property="Fill"
                                    Value="{DynamicResource Brush.HighlightA2}" />
                            <Setter Value="{DynamicResource Brush.Foreground.Disabled}"
                                    Property="Foreground" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CheckBox -->
    <Style x:Key="CheckBox.Base" TargetType="{x:Type b:CheckBox}">
        <Setter Property="this:ControlAssist.CornerRadius" Value="3" />
        <Setter Property="this:ControlAssist.Icon" Value="{x:Null}" />
        <Setter Property="this:ControlAssist.IconSize" Value="19" />
        <Setter Property="this:ControlAssist.IsFilled" Value="False" />
        <Setter Property="this:ControlAssist.IconDock" Value="Left" />
        <Setter Property="this:ControlAssist.IconMargin" Value="0 0 0 0" />
        <Setter Property="this:ControlAssist.StrokeThickness" Value="2" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Level1}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Highlight" Value="{DynamicResource Brush.HighlightA4}" />
        <Setter Property="Padding" Value="8 4" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type b:CheckBox}">
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding this:ControlAssist.CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <DockPanel>
                            <Border x:Name="PART_Mark"
                                    DockPanel.Dock="Left"
                                    Background="{DynamicResource Brush.Background.Level2}"
                                    CornerRadius="16"
                                    Padding="4"
                                    Height="{TemplateBinding this:ControlAssist.IconSize}"
                                    Width="{TemplateBinding this:ControlAssist.IconSize}" 
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Path x:Name="PART_Icon"
                                      Data="{StaticResource Checked}"
                                      Stroke="{DynamicResource Brush.Foreground.Disabled}"
                                      StrokeThickness="{TemplateBinding this:ControlAssist.StrokeThickness}"
                                      Stretch="Uniform"/>
                            </Border>

                            <ContentPresenter x:Name="PART_Content"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>

                        <!-- MouseOver -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="PART_Mark" Value="{DynamicResource Brush.Overlay100}" />
                            <Setter Property="Stroke" TargetName="PART_Icon" Value="{DynamicResource Brush.Foreground.Level1}" />
                        </Trigger>

                        <!-- IsChecked : null -->
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter Property="Padding" Value="3" TargetName="PART_Mark"/>
                            <Setter Property="Data" TargetName="PART_Icon" Value="{StaticResource Minus}" />
                            <Setter Property="Stroke" TargetName="PART_Icon" Value="{DynamicResource Brush.Foreground.Level1}" />
                            <Setter Property="Background" TargetName="PART_Mark" Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=Highlight}" />
                        </Trigger>

                        <!-- IsChecked : true -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Padding" Value="4" TargetName="PART_Mark"/>
                            <Setter Property="Data" TargetName="PART_Icon" Value="{StaticResource Checked}" />
                            <Setter Property="Stroke" TargetName="PART_Icon" Value="{DynamicResource Brush.Foreground.Level1}" />
                            <Setter Property="Background" TargetName="PART_Mark" Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=Highlight}" />
                        </Trigger>

                        <!-- IsEnabled = false & IsChecked = null -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="False"/>
                                <Condition Property="IsChecked" Value="{x:Null}"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Data" TargetName="PART_Icon" Value="{StaticResource Minus}" />
                            <Setter Property="Stroke" TargetName="PART_Icon" Value="{DynamicResource Brush.Foreground.Disabled}" />
                            <Setter Property="Background" TargetName="PART_Mark" Value="{DynamicResource Brush.Background.Disabled}" />
                            <Setter Property="TextElement.Foreground" TargetName="PART_Content" Value="{DynamicResource Brush.Foreground.Disabled}" />
                        </MultiTrigger>

                        <!-- IsEnabled = false & IsChecked = true -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="False"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Data" TargetName="PART_Icon" Value="{StaticResource Checked}" />
                            <Setter Property="Stroke" TargetName="PART_Icon" Value="{DynamicResource Brush.Foreground.Disabled}" />
                            <Setter Property="Background" TargetName="PART_Mark" Value="{DynamicResource Brush.Background.Disabled}" />
                            <Setter Property="TextElement.Foreground" TargetName="PART_Content" Value="{DynamicResource Brush.Foreground.Disabled}" />
                        </MultiTrigger>

                        <!-- IsEnabled = false & IsChecked = false -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="False"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" TargetName="PART_Mark" Value="{DynamicResource Brush.Background.Disabled}" />
                            <Setter Property="TextElement.Foreground" TargetName="PART_Content" Value="{DynamicResource Brush.Foreground.Disabled}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RadioButton -->
    <Style x:Key="RadioButton.Base" TargetType="{x:Type b:RadioButton}">
        <Setter Property="this:ControlAssist.CornerRadius" Value="3" />
        <Setter Property="this:ControlAssist.Icon" Value="{x:Null}" />
        <Setter Property="this:ControlAssist.IconSize" Value="12" />
        <Setter Property="this:ControlAssist.IsFilled" Value="False" />
        <Setter Property="this:ControlAssist.IconDock" Value="Left" />
        <Setter Property="this:ControlAssist.IconMargin" Value="0 0 8 0" />
        <Setter Property="this:ControlAssist.StrokeThickness" Value="2" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Level1}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Level2}" />
        <Setter Property="HighlightState" Value="{DynamicResource Brush.HighlightA4}" />
        <Setter Property="HoverState" Value="{DynamicResource Brush.HighlightA2}" />
        <Setter Property="DisabledState" Value="{DynamicResource Brush.HighlightA1}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="8 4" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type b:RadioButton}">
                    <Border x:Name="PART_Border"
                            Background="Transparent"
                            CornerRadius="0"
                            Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <Border x:Name="PART_Outer"
                                    Background="{DynamicResource Brush.Background.Level1}"
                                    CornerRadius="18"
                                    Height="20"
                                    Width="20"
                                    Padding="4">
                                <Border x:Name="PART_Inner"
                                        Background="{DynamicResource Brush.Background.Level3}"
                                        CornerRadius="18" />
                            </Border>

                            <ContentPresenter x:Name="PART_Content"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              Margin="8 0 0 0"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="PART_Inner" Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=HoverState}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter Property="Background" TargetName="PART_Inner" Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=HighlightState}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" TargetName="PART_Inner" Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=HighlightState}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" TargetName="PART_Outer" Value="{DynamicResource Brush.Background.Disabled}" />
                            <Setter Property="TextElement.Foreground" TargetName="PART_Content" Value="{DynamicResource Brush.Foreground.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToggleButton -->
    <Style x:Key="ToggleButton.Base" TargetType="{x:Type b:ToggleButton}">
        <Setter Property="this:ControlAssist.CornerRadius" Value="3" />
        <Setter Property="this:ControlAssist.Icon" Value="{x:Null}" />
        <Setter Property="this:ControlAssist.IconSize" Value="19" />
        <Setter Property="this:ControlAssist.IsFilled" Value="False" />
        <Setter Property="this:ControlAssist.IconDock" Value="Left" />
        <Setter Property="this:ControlAssist.IconMargin" Value="0 0 0 0" />
        <Setter Property="this:ControlAssist.StrokeThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Level1}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Level3}" />
        <Setter Property="HighlightState" Value="{DynamicResource Brush.HighlightA4}" />
        <Setter Property="HoverState" Value="{DynamicResource Brush.HighlightA2}" />
        <Setter Property="DisabledState" Value="{DynamicResource Brush.HighlightA1}" />
        <Setter Property="Padding" Value="8 4" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type b:ToggleButton}">
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding this:ControlAssist.CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <ContentPresenter x:Name="PART_Content"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.2"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" TargetName="PART_Border" Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=HoverState}" />
                        </Trigger>


                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="{x:Null}"/>
                                <Condition Property="IsMouseOver" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" TargetName="PART_Border" Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=HighlightState}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True"/>
                                <Condition Property="IsMouseOver" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" TargetName="PART_Border" Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=HighlightState}" />
                        </MultiTrigger>
                        
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="TextElement.Foreground" TargetName="PART_Content" Value="{DynamicResource Brush.Foreground.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IconMode" Value="Icon">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type b:ToggleButton}">
                            <Border x:Name="PART_Border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{TemplateBinding this:ControlAssist.CornerRadius}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                <this:Iconify x:Name="PART_Icon"
                                              Margin="{TemplateBinding this:ControlAssist.IconMargin}"
                                              Icon="{TemplateBinding this:ControlAssist.Icon}"
                                              IconSize="{TemplateBinding this:ControlAssist.IconSize}"
                                              IsFilled="{TemplateBinding this:ControlAssist.IsFilled}"
                                              StrokeThickness="{TemplateBinding this:ControlAssist.StrokeThickness}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.2"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" TargetName="PART_Border" Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=HoverState}" />
                                </Trigger>

                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsChecked" Value="{x:Null}"/>
                                        <Condition Property="IsMouseOver" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" TargetName="PART_Border" Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=HighlightState}" />
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsChecked" Value="True"/>
                                        <Condition Property="IsMouseOver" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" TargetName="PART_Border" Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=HighlightState}" />
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>

            <Trigger Property="IconMode" Value="Both">
                <Setter Property="this:ControlAssist.IconMargin" Value="0 0 8 0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type b:ToggleButton}">
                            <Border x:Name="PART_Border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{TemplateBinding this:ControlAssist.CornerRadius}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                <DockPanel VerticalAlignment="Center">
                                    <this:Iconify x:Name="PART_Icon"
                                                  DockPanel.Dock="{TemplateBinding this:ControlAssist.IconDock}"
                                                  Margin="{TemplateBinding this:ControlAssist.IconMargin}"
                                                  Icon="{TemplateBinding this:ControlAssist.Icon}"
                                                  IsFilled="{TemplateBinding this:ControlAssist.IsFilled}"
                                                  StrokeThickness="{TemplateBinding this:ControlAssist.StrokeThickness}"
                                                  IconSize="{TemplateBinding this:ControlAssist.IconSize}" />

                                    <ContentPresenter x:Name="PART_Content"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                      ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                      Margin="0 0 0 0 "
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.2"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" TargetName="PART_Border" Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=HoverState}" />
                                </Trigger>

                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsChecked" Value="{x:Null}"/>
                                        <Condition Property="IsMouseOver" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" TargetName="PART_Border" Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=HighlightState}" />
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsChecked" Value="True"/>
                                        <Condition Property="IsMouseOver" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" TargetName="PART_Border" Value="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=HighlightState}" />
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>


    <Style TargetType="{x:Type b:GhostButton}" BasedOn="{StaticResource GhostButton.Base}" />
    <Style TargetType="{x:Type b:OptionButton}" BasedOn="{StaticResource OptionButton.Base}" />
    <Style TargetType="{x:Type b:TextButton}" BasedOn="{StaticResource TextButton.Base}" />
    <Style TargetType="{x:Type b:RadioButton}" BasedOn="{StaticResource RadioButton.Base}" />
    <Style TargetType="{x:Type b:ToggleButton}" BasedOn="{StaticResource ToggleButton.Base}" />
    <Style TargetType="{x:Type b:CheckBox}" BasedOn="{StaticResource CheckBox.Base}" />
</ResourceDictionary>