<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:this="clr-namespace:KinonekoSoftware.UI.Controls"
                    xmlns:p="clr-namespace:KinonekoSoftware.UI.Controls.Panels"
                    xmlns:b="clr-namespace:KinonekoSoftware.UI.Controls.Buttons">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/KinonekoSoftware.UI.OnWPF;component/Themes/Dark.xaml" />
    </ResourceDictionary.MergedDictionaries>

    
    <!-- MainButton.Overlay -->
    
    <Style x:Key="MainButton.ContentOverlay" TargetType="{x:Type b:MainButton}">
        <Setter Property="this:ControlAssist.CornerRadius" Value="0" />
        <Setter Property="this:ControlAssist.Icon" Value="{x:Null}" />
        <Setter Property="this:ControlAssist.IconSize" Value="23" />
        <Setter Property="this:ControlAssist.IsFilled" Value="False" />
        <Setter Property="this:ControlAssist.IconDock" Value="Left" />
        <Setter Property="this:ControlAssist.IconMargin" Value="0" />
        <Setter Property="this:ControlAssist.StrokeThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8 4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type b:MainButton}">
                    <p:TilePanel x:Name="PART_Background"
                            Background="{TemplateBinding Background}">
                        <ContentPresenter x:Name="PART_Content"
                                          TextElement.Foreground="{DynamicResource Brush.Foreground.Level1}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <Border x:Name="PART_Border"
                                Background="Transparent"
                                CornerRadius="{TemplateBinding this:ControlAssist.CornerRadius}"/>
                    </p:TilePanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.Overlay100}" TargetName="PART_Border" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.Overlay200}" TargetName="PART_Border" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="Transparent" TargetName="PART_Border" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="MainButton.Overlay" TargetType="{x:Type b:MainButton}">
        <Setter Property="this:ControlAssist.CornerRadius" Value="6" />
        <Setter Property="this:ControlAssist.Icon" Value="{x:Null}" />
        <Setter Property="this:ControlAssist.IconSize" Value="23" />
        <Setter Property="this:ControlAssist.IsFilled" Value="False" />
        <Setter Property="this:ControlAssist.IconDock" Value="Left" />
        <Setter Property="this:ControlAssist.IconMargin" Value="0" />
        <Setter Property="this:ControlAssist.StrokeThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8 4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type b:MainButton}">
                    <Border x:Name="PART_Background"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding this:ControlAssist.CornerRadius}">
                        
                        <Border x:Name="PART_Border"
                                Background="Transparent"
                                CornerRadius="{TemplateBinding this:ControlAssist.CornerRadius}">
                            <this:Iconify x:Name="PART_Icon"
                                          Foreground="White"
                                          Margin="{TemplateBinding this:ControlAssist.IconMargin}"
                                          Icon="{TemplateBinding this:ControlAssist.Icon}"
                                          IconSize="{TemplateBinding this:ControlAssist.IconSize}"
                                          IsFilled="{TemplateBinding this:ControlAssist.IsFilled}"
                                          StrokeThickness="{TemplateBinding this:ControlAssist.StrokeThickness}"
                                          Visibility="Collapsed"
                                          Opacity="0"  />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="PART_Icon" />
                            <Setter Property="Opacity" Value="1" TargetName="PART_Icon" />
                            <Setter Property="Background" Value="{DynamicResource Brush.Overlay100}" TargetName="PART_Border" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.Overlay200}" TargetName="PART_Border" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground.Disabled}" TargetName="PART_Icon" />
                            <Setter Property="Background" Value="Transparent" TargetName="PART_Border" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

