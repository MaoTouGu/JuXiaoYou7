<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:this="clr-namespace:KinonekoSoftware.UI.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/KinonekoSoftware.UI.OnWPF;component/Themes/Styles/Expander.xaml" />
        <ResourceDictionary Source="pack://application:,,,/KinonekoSoftware.UI.OnWPF;component/Themes/Styles/HeaderedContentControl.xaml" />
        <ResourceDictionary Source="pack://application:,,,/KinonekoSoftware.UI.OnWPF;component/Themes/Styles/ScrollViewer.xaml" />
        <ResourceDictionary Source="pack://application:,,,/KinonekoSoftware.UI.OnWPF;component/Themes/Styles/ToolBar.xaml" />
        <ResourceDictionary Source="pack://application:,,,/KinonekoSoftware.UI.OnWPF;component/Themes/Styles/ListView.xaml" />
        <ResourceDictionary Source="pack://application:,,,/KinonekoSoftware.UI.OnWPF;component/Controls/EmptyStateView.xaml" />
        <ResourceDictionary Source="pack://application:,,,/KinonekoSoftware.UI.OnWPF;component/Controls/Drawer.xaml" />
        <ResourceDictionary Source="pack://application:,,,/KinonekoSoftware.UI.OnWPF;component/Controls/TextBox.xaml" />
        <ResourceDictionary Source="pack://application:,,,/KinonekoSoftware.UI.OnWPF;component/Controls/Buttons/Button.xaml" />
        <ResourceDictionary Source="pack://application:,,,/KinonekoSoftware.UI.OnWPF;component/Controls/Buttons/MainButton.xaml" />
        <ResourceDictionary Source="pack://application:,,,/KinonekoSoftware.UI.OnWPF;component/Controls/Collections/ComboBox.xaml" />
        <ResourceDictionary Source="pack://application:,,,/KinonekoSoftware.UI.OnWPF;component/Controls/Collections/ListBox.xaml" />
        <ResourceDictionary Source="pack://application:,,,/KinonekoSoftware.UI.OnWPF;component/Controls/Collections/TabbedListBox.xaml" />
        <ResourceDictionary Source="pack://application:,,,/KinonekoSoftware.UI.OnWPF;component/Controls/Collections/TabControl.xaml" />
        <ResourceDictionary Source="pack://application:,,,/KinonekoSoftware.UI.OnWPF;component/Controls/Collections/TreeView.xaml" />
        <ResourceDictionary Source="pack://application:,,,/KinonekoSoftware.UI.OnWPF;component/Controls/Menu/Menu.xaml" />
    </ResourceDictionary.MergedDictionaries>
    
    <!-- Iconify -->
    <Style TargetType="{x:Type this:Iconify}">
        <Setter Property="IconSize" Value="17" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type this:Iconify}">
                    <Path x:Name="PART_Icon"
                          Margin="{TemplateBinding Padding}"
                          Data="{Binding RelativeSource={RelativeSource TemplatedParent},Path=Icon,Mode=OneWay}"
                          StrokeThickness="{Binding RelativeSource={RelativeSource TemplatedParent},Path=StrokeThickness,Mode=OneWay}"
                          Height="{Binding RelativeSource={RelativeSource TemplatedParent},Path=IconSize,Mode=OneWay}"
                          Width="{Binding RelativeSource={RelativeSource TemplatedParent},Path=IconSize,Mode=OneWay}"
                          Stretch="Uniform" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFilled" Value="True">
                            <Setter Property="Fill"
                                    TargetName="PART_Icon"
                                    Value="{Binding RelativeSource={RelativeSource TemplatedParent},Path=Foreground,Mode=OneWay}" />
                            <Setter Property="Stroke" Value="{x:Null}" TargetName="PART_Icon" />
                            <Setter Property="StrokeThickness" Value="0" TargetName="PART_Icon" />
                        </Trigger>
                        <Trigger Property="IsFilled" Value="False">
                            <Setter Property="Stroke"
                                    TargetName="PART_Icon"
                                    Value="{Binding RelativeSource={RelativeSource TemplatedParent},Path=Foreground,Mode=OneWay}" />
                            <Setter Property="Fill" Value="{x:Null}" TargetName="PART_Icon" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>