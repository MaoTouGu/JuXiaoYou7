    <Color x:Key="Color.Foreground.Level2">#A7A9AF</Color>
    <Color x:Key="Color.Foreground.Level3">#E3E4E5</Color>
    <Color x:Key="Color.Foreground.Adaptive">#FFFFFF</Color>
