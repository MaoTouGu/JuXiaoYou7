    <Color x:Key="Color.Background.Level3">#FFFFFF</Color>
    <Color x:Key="Color.Background.Level4">#ece9ea</Color>
    <Color x:Key="Color.Background.Level5">#c9c9C9</Color>
    <Color x:Key="Color.Background.Level6">#b7b7b7</Color>
    <Color x:Key="Color.Background.Disabled">#F6F6F6</Color>
    
    <SolidColorBrush x:Key="Brush.Background.Level1" Color="{StaticResource Color.Background.Level1}"/>
